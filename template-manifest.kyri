# template-manifest.kyri -- single source of truth for the public seed boundary.
#
# Projects the standing field (`xykj61/202611-grain`) into the depersonalized,
# single-commit public seed (`grain-ww/202611-grain`).
#
# FAIL-SAFE ALLOWLIST:
#   1. Every tracked root path carries `template`, `scrub`, or `personal` once
#      (checked by `tools/fixtures/s/sow_manifest_cover.sh` -> `M1_OK`).
#   2. `sow_project.sh` ships ONLY `allow` paths, applies `sow_scrub.sed` +
#      `IDENT` withholding, and skips every `sub_exclude` path.
#   3. `sow_witness.rish` proves `IDENT_CLEAN` and `NO_PERSONAL` before any
#      git repository is initialized inside `seed/`.

# ============================================================
# 1. ALLOWLIST (SHIP DRIVER -- ONLY THESE ENTER `seed/`)
# ============================================================
allow .brix
allow .gemini
allow .geminiignore
allow .gitattributes
allow .gitignore
allow .gitmodules
allow CHANGELOG.md
allow CODE_OF_CONDUCT.md
allow CONTRIBUTING.md
allow GEMINI.md
allow LEXICON.md
allow LICENSE
allow LICENSE-APACHE
allow LICENSE-CC-BY
allow LICENSE-MIT
allow MAP.md
allow ORGANIZING.md
allow README.md
allow SECURITY.md
allow SOURCE.md
allow active-designing
allow active-development
allow active-reviving
allow assets
allow blazepod
allow context
allow docs-geode
allow external-research
allow fleet
allow foundations
allow frontier
allow gratitude
allow languages
allow libraries
allow llms.txt
allow mitra-shed
allow modules
allow nixos
allow open
allow tasks.rish
allow terrarium
allow tools

# ============================================================
# 2. ROOT PATH CLASSIFICATIONS (EXACTLY ONE ROW PER TRACKED ROOT)
# ============================================================

# -- Dotfiles & root configuration --
template  .brix
