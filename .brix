# .brix -- Grain
# Course descriptor: name, version, multi-provider model and branch defaults,
# and the bricks (source files) Blaze tracks.
# Format: one key-value pair per line, space-separated. Lines starting with
# '#' are comments; blank lines are ignored.
#
# Refreshed 20261115.031500: myofascia 56.505, unified root yonder/,
# clean-sheet docs-geode/, blazepod/, mitra-shed/, and Gemini 4 Carbon primary
# bench (.claude and .cursor archived under yonder/).

name grain
version 20261115.032000
myofascia 56.510

# Upstream git remote and branch-pushing defaults
remote xy
branch_main main
branch_push_default gemini-4-carbon

# Active primary bench: Google Gemini CLI (gemini-4-carbon)
provider_gemini Google
product_gemini Gemini CLI
model_gemini gemini-4-carbon
branch_gemini gemini-4-carbon
push_remote_gemini xy
push_branch_gemini gemini-4-carbon
door_gemini GEMINI.md
settings_gemini .gemini/settings.json
rules_gemini .gemini/rules/README.md

# Archived benches preserved in yonder/ (full table: context/MODEL_ROSTER.kyri)
provider_claude Anthropic
product_claude Claude Code
model_claude claude-opus-4-6
door_claude yonder/claude/CLAUDE.md
settings_claude yonder/claude/settings.json

provider_codex OpenAI
product_codex Codex CLI
model_codex gpt-6-sol

provider_cursor Cursor
product_cursor Cursor Agent CLI
model_cursor grok-4.7-high
settings_cursor yonder/cursor/cli.json

provider_opencode Together AI
product_opencode OpenCode
model_opencode together/deepseek-ai/DeepSeek-V4-Pro-0813
door_opencode yonder/opencode-AGENTS.md

provider_antigravity Google
product_antigravity Antigravity CLI
binary_antigravity agy

# Typo and synthesis aliases
alias Prim Prin
alias Synthesis Choir
file tools/l/launch-choir-synthesis-chapter.rish

# Rye compiler
file rye/src/main.rye

# Rishi shell
file rishi/src/main.rye

# Tally memory model and Blazepod two-mode profile
file tally/seed.rye
file tally/gardens.rye
file blazepod/blazepod.brix

# Caravan supervision
file caravan/seed.rye
file caravan/bounded.rye
file caravan/twin.rye
file caravan/chain.rye

# Blaze version control
file blaze/src/main.rye

# Gate witness runner
file tools/p/parity.rish

# Flare inference faculties (Lattice - Pulp - Lantern - Kiln)
file flare/lattice/lattice_core.rye
file flare/pulp/pulp_core.rye
file flare/lantern/lantern_core.rye
file flare/flare_core.rye

# Identity and topology (Kumara - Comlink)
file kumara/kumara.rye
file comlink/topology.rye

# Sundial -- health percent and myofascia indicator
file sundial/sundial.rye

# Living front doors, geode, shed ledger, and model roster
file GEMINI.md
file README.md
file SOURCE.md
file docs-geode/README.md
file mitra-shed/README.md
file context/MODEL_ROSTER.kyri
