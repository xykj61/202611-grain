//! sundial/sundial.rye -- the health face and myofascia indicator.
//!
//! Molted 20261115.031000 from `fascia` to `myofascia`:
//!   - Baseline lowered 8 whole points from 64.5 to 56.500 / 100.000,
//!   - Stored as exact integer thousandths (`0..100_000`, scale `1_000`) so
//!     each completed orbit advances the reading by `+0.001` (`+1` milli).
//!   - Keeps `fascia` / `fascia_units` compatibility fields beside `myofascia`
//!     and `myofascia_milli` (accrete-never-break).
//!
//!   rye build sundial/sundial.rye -femit-bin=sundial/bin/sundial
//!   sundial/bin/sundial selftest
//!   sundial/bin/sundial emit

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const sundial_version = "20261119.183931";

pub const max_modules: u32 = 256;

// Myofascia whole (0..100) & milli-points (0..100_000; +0.001/movement).
pub const myofascia_percent_max: u32 = 100;
pub const myofascia_milli_scale: u32 = 1000;
pub const myofascia_milli_max: u32 = 100000;
pub const myofascia_base_milli: u32 = 56500; // 56.500 baseline (64.500 - 8.000)

pub const Reading = struct {
    name: []const u8,
    green: bool,
    unit: []const u8,
    date: []const u8,
    source: []const u8,
};

pub const AddError = error{SourcelessReading};

pub const Sundial = struct {
    readings: [max_modules]Reading,
    count: u32,
    myofascia: u32,
    myofascia_milli: u32,
    pub fn init(myofascia: u32) Sundial {
        // invariant: whole myofascia stays within 0..100.
        assert(myofascia <= myofascia_percent_max);
        const milli = myofascia * myofascia_milli_scale;
        // invariant: scaled thousandths stay within 100_000.
        assert(milli <= myofascia_milli_max);
        return .{
            .readings = undefined,
            .count = 0,
            .myofascia = myofascia,
            .myofascia_milli = milli,
        };
    }

    pub fn init_myofascia(myofascia: u32, myofascia_milli: u32) Sundial {
        // invariant: whole myofascia stays within 0..100.
        assert(myofascia <= myofascia_percent_max);
        // invariant: thousandths stay within 0..100_000.
        assert(myofascia_milli <= myofascia_milli_max);
        return .{
            .readings = undefined,
            .count = 0,
            .myofascia = myofascia,
            .myofascia_milli = myofascia_milli,
        };
    }

    pub fn init_orbits(completed_orbits: u32) Sundial {
        // invariant: orbit bonus stays inside remaining headroom.
        assert(myofascia_base_milli + completed_orbits <=
            myofascia_milli_max);
        const milli = myofascia_base_milli + completed_orbits;
        const whole = milli / myofascia_milli_scale;
        assert(whole <= myofascia_percent_max);
        return init_myofascia(whole, milli);
    }

    pub fn add(
        self: *Sundial,
        name: []const u8,
        green: bool,
        unit: []const u8,
        date: []const u8,
        source: []const u8,
    ) AddError!void {
        if (source.len == 0) return error.SourcelessReading;
        // invariant: reading count stays below max_modules before write.
        assert(self.count < max_modules);
        self.readings[self.count] = .{
            .name = name,
            .green = green,
            .unit = unit,
            .date = date,
            .source = source,
        };
        self.count += 1;
        // invariant: reading count stays bounded by max_modules after write.
        assert(self.count <= max_modules);
    }

    pub fn green_count(self: *const Sundial) u32 {
        assert(self.count <= max_modules);
        var n: u32 = 0;
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (self.readings[i].green) n += 1;
        }
        return n;
    }

    pub fn all_green(self: *const Sundial) bool {
        return self.green_count() == self.count;
    }

    pub fn health_percent(self: *const Sundial) u32 {
        if (self.count == 0) return 0;
        return (self.green_count() * 100) / self.count;
    }
};

fn run_selftest() !u8 {
    // Baseline 56.500 + 578 completed steps = 57.078 (+0.001/movement)!
    var s = Sundial.init_orbits(578);
    if (s.myofascia != 57) return error.MyofasciaWholeWrong;
    if (s.myofascia_milli != 57078) return error.MyofasciaMilliWrong;
    try s.add("kumara", true, "witness-status", "20261115", "kumara-tile");
    try s.add("vault", true, "witness-status", "20261115", "vault-split");
    try s.add("basin", true, "witness-status", "20261115", "basin-suite");
    try s.add(
        "tablecloth",
        false,
        "witness-status",
        "20261115",
        "tablecloth-suite",
    );

    if (s.count != 4) return error.CountWrong;
    if (s.green_count() != 3) return error.GreenCountWrong;
    if (s.all_green()) return error.WronglyAllGreen;
    if (s.health_percent() != 75) return error.PercentWrong;

    var empty = Sundial.init(0);
    if (empty.health_percent() != 0) return error.EmptyNotZero;
    if (empty.myofascia_milli != 0) return error.EmptyMilliWrong;

    var whole = Sundial.init(100);
    if (whole.myofascia_milli != 100000) return error.FullMilliWrong;
    try whole.add(
        "scribe",
        true,
        "witness-status",
        "20261115",
        "scribe-reader",
    );
    try whole.add(
        "sundial",
        true,
        "witness-status",
        "20261115",
        "sundial-selftest",
    );
    if (!whole.all_green()) return error.NotAllGreen;
    if (whole.health_percent() != 100) return error.WholeNotFull;

    var refused = Sundial.init(0);
    if (refused.add("unknown", true, "witness-status", "20261115", "")) |_| {
        return error.SourcelessReadingAccepted;
    } else |err| {
        if (err != error.SourcelessReading) return err;
    }

    print("sundial: myofascia 57.078 (base 56.500 + 578 * 0.001).\n", .{});
    print("sundial: version {s}\n", .{sundial_version});
    print("GREEN: sundial -- health percent and myofascia proven.\n", .{});
    return 0;
}

const max_line: u32 = 128;

fn put_line(io: std.Io, comptime fmt: []const u8, args: anytype) void {
    var buf: [max_line]u8 = undefined;
    const line = std.fmt.bufPrint(&buf, fmt, args) catch return;
    const out = std.Io.File.stdout();
    out.writeStreamingAll(io, line) catch {};
}

fn status(green: bool) []const u8 {
    return if (green) "green" else "red";
}

fn run_emit(io: std.Io) !u8 {
    var s = Sundial.init_orbits(578);
    try s.add("glow", true, "witness-status", "20261115", "digraph-twin-48");
    try s.add("brix", true, "witness-status", "20261115", "brix-infuse");
    try s.add("flare", true, "witness-status", "20261115", "flare-faculties");
    try s.add(
        "sundial",
        true,
        "witness-status",
        "20261115",
        "sundial-selftest",
    );
    put_line(io, "format baton-v1\n", .{});
    put_line(io, "archetype ledgerworks\n", .{});
    put_line(io, "stamp {s}\n", .{sundial_version});
    var i: u32 = 0;
    while (i < s.count) : (i += 1) {
        const reading = s.readings[i];
        put_line(io, "member {s} {s} unit {s} date {s} source {s}\n", .{
            reading.name,
            status(reading.green),
            reading.unit,
            reading.date,
            reading.source,
        });
    }
    put_line(io, "roll {d} of {d} green\n", .{ s.green_count(), s.count });
    put_line(io, "health {d}% myofascia {d}\n", .{
        s.health_percent(),
        s.myofascia,
    });
    put_line(io, "myofascia_face {d}.{d:0>3}\n", .{
        s.myofascia_milli / myofascia_milli_scale,
        s.myofascia_milli % myofascia_milli_scale,
    });
    put_line(io, "next keep watch\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const args = try init.minimal.args.toSlice(init.arena.allocator());
    if (args.len >= 2 and std.mem.eql(u8, args[1], "emit")) {
        return run_emit(init.io);
    }
    return run_selftest();
}
