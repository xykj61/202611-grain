//! modules/sundial/calfive_wheel.rye -- Calfive 15-Sign Wheel & Round Load!
//!
//! Stamp: 20261115.123500 -- Single-strands the Panchanga (`15 - 75 - 375 -
//! 1,875 - 9,375` rounds) and the 15-Sign Wheel (`Aries`..`Pisces` + 3 `sky`
//! Aether seats ending at `Siya`) into an executable TAME Rye witness & CLI
//! (`grain-ww round-load`).

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const version = "20261115.123500";
pub const sign_count: u32 = 15;
pub const quest_rounds: u32 = 75;
pub const journey_rounds: u32 = 375;
pub const equinox_rounds: u32 = 1875;
pub const chapter_rounds: u32 = 9375;
const nl: u8 = 10;

pub const SignSeat = struct {
    round: u8,
    sign: []const u8,
    mode: []const u8,
    element: []const u8,
    goal: []const u8,
    craft_verb: []const u8,
};

pub const wheel = [sign_count]SignSeat{
    .{
        .round = 1,
        .sign = "Aries",
        .mode = "cardinal",
        .element = "fire",
        .goal = "talent",
        .craft_verb =
            "Ignite the seed: ship the smallest real file on metal.",
    },
    .{
        .round = 2,
        .sign = "Taurus",
        .mode = "fixed",
        .element = "earth",
        .goal = "law",
        .craft_verb =
            "Tend fertile ground: guard Tally bounds & keep what works.",
    },
    .{
        .round = 3,
        .sign = "Gemini",
        .mode = "dual",
        .element = "air",
        .goal = "fun",
        .craft_verb =
            "Speak between twins: pair citizen Glow with Rye plainly.",
    },
    .{
        .round = 4,
        .sign = "Cancer",
        .mode = "cardinal",
        .element = "water",
        .goal = "aesthetics",
        .craft_verb =
            "Make the home safe: Pond shelter, Glasswall, warm welcome.",
    },
    .{
        .round = 5,
        .sign = "Leo",
        .mode = "fixed",
        .element = "fire",
        .goal = "talent",
        .craft_verb =
            "Stand in daylight: Dimeroll books balance & Seva shines.",
    },
    .{
        .round = 6,
        .sign = "Virgo",
        .mode = "dual",
        .element = "earth",
        .goal = "law",
        .craft_verb =
            "Measure & prune: 80-col, ASCII, stamp-and-name, TAME gates.",
    },
    .{
        .round = 7,
        .sign = "Libra",
        .mode = "cardinal",
        .element = "air",
        .goal = "fun",
        .craft_verb =
            "Meet in balance: welcome & refusal paths answer each other.",
    },
    .{
        .round = 8,
        .sign = "Scorpio",
        .mode = "fixed",
        .element = "water",
        .goal = "aesthetics",
        .craft_verb =
            "Anuradha covenant: Mitra loyalty & clean secret zeroization.",
    },
    .{
        .round = 9,
        .sign = "Sagittarius",
        .mode = "dual",
        .element = "fire",
        .goal = "talent",
        .craft_verb =
            "Aim toward wisdom: connect proven code to Bloom & Shastra.",
    },
    .{
        .round = 10,
        .sign = "Capricorn",
        .mode = "cardinal",
        .element = "earth",
        .goal = "law",
        .craft_verb =
            "Stone & repair: bare-metal RISC-V & ten-year hardware.",
    },
    .{
        .round = 11,
        .sign = "Aquarius",
        .mode = "fixed",
        .element = "air",
        .goal = "fun",
        .craft_verb =
            "Commons & Comlink: peer constellations without gatekeepers.",
    },
    .{
        .round = 12,
        .sign = "Pisces",
        .mode = "dual",
        .element = "water",
        .goal = "aesthetics",
        .craft_verb =
            "Twilight close: clear residue & offer one clean seed.",
    },
    .{
        .round = 13,
        .sign = "sky",
        .mode = "cardinal",
        .element = "aether",
        .goal = "heart",
        .craft_verb =
            "Aether hears: step back and ask whom the work serves.",
    },
    .{
        .round = 14,
        .sign = "sky",
        .mode = "fixed",
        .element = "aether",
        .goal = "heart",
        .craft_verb =
            "Hold the whole cup: compress two truths into one macro.",
    },
    .{
        .round = 15,
        .sign = "sky (Siya)",
        .mode = "dual",
        .element = "aether",
        .goal = "heart",
        .craft_verb =
            "Siya's chair: carry the harvest whole into the next Dawn.",
    },
};

pub fn seat_for_commit_count(commit_count: u64) SignSeat {
    const eff = if (commit_count == 0) 1 else commit_count;
    const idx: usize = @intCast((eff - 1) % sign_count);
    // invariant: 15-sign modulo index lies strictly in 0..14.
    assert(idx < sign_count);
    const s = wheel[idx];
    assert(s.round == idx + 1);
    return s;
}

fn run_selftest() !u8 {
    // Verify Panchanga x5 ring progression: 15 -> 75 -> 375 -> 1875 -> 9375
    if (sign_count * 5 != quest_rounds or
        quest_rounds * 5 != journey_rounds or
        journey_rounds * 5 != equinox_rounds or
        equinox_rounds * 5 != chapter_rounds)
    {
        return error.PanchangaRatioBroken;
    }
    if (!std.mem.eql(u8, seat_for_commit_count(1).sign, "Aries")) {
        return error.Round1NotAries;
    }
    if (!std.mem.eql(u8, seat_for_commit_count(15).sign, "sky (Siya)")) {
        return error.Round15NotSiya;
    }
    print("GREEN: calfive_wheel -- 15 signs & x5 Panchanga proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const a = init.arena.allocator();
    const io = init.io;
    const args = try init.minimal.args.toSlice(a);

    if (args.len > 1 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }

    const r = try std.process.run(a, io, .{
        .argv = &[_][]const u8{ "git", "rev-list", "--count", "HEAD" },
    });
    const ws_trim = [_]u8{ 32, 9, 13, 10 };
    const trimmed = std.mem.trim(u8, r.stdout, &ws_trim);
    const cnt = std.fmt.parseInt(u64, trimmed, 10) catch 1;
    const seat = seat_for_commit_count(cnt);
    const q_place = ((cnt - 1) % quest_rounds) + 1;

    print("Calfive Round Load (commits={d}, quest_step={d}/75):{c}", .{
        cnt,
        q_place,
        nl,
    });
    print("  Round {d}/15 : {s} ({s} {s} -- goal: {s}){c}", .{
        seat.round,
        seat.sign,
        seat.mode,
        seat.element,
        seat.goal,
        nl,
    });
    print("  Theme       : {s}{c}", .{ seat.craft_verb, nl });
    return 0;
}
