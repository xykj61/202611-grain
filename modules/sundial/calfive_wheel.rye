            "Siya's chair: carry the harvest whole into the next Dawn.",
    },
};

pub fn seat_for_movement_count(mov_count: u64) SignSeat {
    const eff = if (mov_count == 0) 1 else mov_count;
    const idx: usize = @intCast((eff - 1) % sign_count);
    // invariant: 15-sign modulo index lies strictly in 0..14.
    assert(idx < sign_count);
    const s = wheel[idx];
    assert(s.movement == idx + 1);
    return s;
}

fn run_selftest() !u8 {
    // Verify x5 elemental progression: [15, 75, 375, 1875, 9375]
    if (orbit_movements * 5 != quest_movements or
        quest_movements * 5 != journey_movements or
        journey_movements * 5 != section_movements or
        section_movements * 5 != chapter_movements)
    {
        return error.PanchangaRatioBroken;
    }
    if (!std.mem.eql(u8, seat_for_movement_count(1).sign, "Aries")) {
        return error.Movement1NotAries;
    }
    if (!std.mem.eql(u8, seat_for_movement_count(15).sign, "sky (Siya)")) {
        return error.Movement15NotSiya;
    }
    print("GREEN: calfive_wheel -- [15..9375] & 15 signs proven.{c}", .{nl});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const a = init.arena.allocator();
    const io = init.io;
    const args = try init.minimal.args.toSlice(a);

    if (args.len > 1 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }

    const r = try std.process.run(a, io, .{
        .argv = &[_][]const u8{ "git", "rev-list", "--count", "HEAD" },
    });
    const ws_trim = [_]u8{ 32, 9, 13, 10 };
    const trimmed = std.mem.trim(u8, r.stdout, &ws_trim);
    const cnt = std.fmt.parseInt(u64, trimmed, 10) catch 1;
    const seat = seat_for_movement_count(cnt);
    const next_seat = seat_for_movement_count(cnt + 1);
    const orbits_done = cnt / orbit_movements;
    const q_place = ((cnt - 1) % quest_movements) + 1;

    print(
        "Calfive Round Load [15..9375] (mov={d}, orb={d}, q={d}/75):{c}",
        .{ cnt, orbits_done, q_place, nl },
    );
    print("  Movement {d}/15 : {s} ({s} {s} -- goal: {s}){c}", .{
        seat.movement,
        seat.sign,
        seat.mode,
        seat.element,
        seat.goal,
        nl,
    });
    print("  Theme          : {s}{c}", .{ seat.craft_verb, nl });
    print("  Recommend {d}/15: {s} -- {s}{c}", .{
        next_seat.movement,
        next_seat.sign,
        next_seat.craft_verb,
        nl,
    });
    return 0;
}
