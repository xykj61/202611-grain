//! modules/sundial/calfive_wheel.rye -- `[15..9375]` Calfive Movement Wheel!
//!
//! Stamp: `20261115.145000` -- Strict `round -> movement` Calfive Panchanga:
//!   `[15, 75, 375, 1875, 9375] : [orbit, quest, journey, section, chapter]`
//!   - `1 Orbit` strictly means **completion of 15 Movements**,
//!   - 15-Sign Wheel (`Aries`..`Pisces` + 3 `sky` Aether seats ending at
//!     `Siya`), executable via `grain-ww round-load` / `grain-ww movement`!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const version = "20261115.145000";
pub const sign_count: u32 = 15;
pub const orbit_movements: u32 = 15;
pub const quest_movements: u32 = 75;
pub const journey_movements: u32 = 375;
pub const section_movements: u32 = 1875;
pub const chapter_movements: u32 = 9375;
const nl: u8 = 10;

pub const SignSeat = struct {
    movement: u8,
    sign: []const u8,
    mode: []const u8,
    element: []const u8,
    goal: []const u8,
    craft_verb: []const u8,
};

pub const wheel = [sign_count]SignSeat{
    .{
        .movement = 1,
        .sign = "Aries",
        .mode = "cardinal",
        .element = "fire",
        .goal = "talent",
        .craft_verb =
            "First clay wick (Siraj): ship the smallest real file on metal.",
    },
    .{
        .movement = 2,
        .sign = "Taurus",
        .mode = "fixed",
        .element = "earth",
        .goal = "law",
        .craft_verb =
            "Venus student-teacher: weigh Sagittarius & scout Gemini.",
    },
    .{
        .movement = 3,
        .sign = "Gemini",
        .mode = "dual",
        .element = "air",
        .goal = "fun",
        .craft_verb =
            "Dancing friends, many weaves (Satsanga/Suhbah): Glow & Rye.",
    },
    .{
        .movement = 4,
        .sign = "Cancer",
        .mode = "cardinal",
        .element = "water",
        .goal = "aesthetics",
        .craft_verb =
            "Unwatched sanctuary (Sakinah): Pond shelter & Glasswall care.",
    },
    .{
        .movement = 5,
        .sign = "Leo",
        .mode = "fixed",
        .element = "fire",
        .goal = "talent",
        .craft_verb =
            "Wholehearted song (Sankirtana/Sama'): Resonance & WOOD/MALA.",
    },
    .{
        .movement = 6,
        .sign = "Virgo",
        .mode = "dual",
        .element = "earth",
        .goal = "law",
        .craft_verb =
            "Lantern/TAME/Civic/Radiant/Rota audit & orbit-efficiency review.",
    },
    .{
        .movement = 7,
        .sign = "Libra",
        .mode = "cardinal",
        .element = "air",
        .goal = "fun",
        .craft_verb =
            "Weigh 6-Virgo findings, plan tidy/Mitra list, & ask 8-Scorpio.",
    },
    .{
        .movement = 8,
        .sign = "Scorpio",
        .mode = "fixed",
        .element = "water",
        .goal = "aesthetics",
        .craft_verb =
            "Run approved sheds, clear spent keys to zero, & scout 9-Sag.",
    },
    .{
        .movement = 9,
        .sign = "Sagittarius",
        .mode = "dual",
        .element = "fire",
        .goal = "talent",
        .craft_verb =
            "Teacher/Karma response: Brushstroke/Skate art & re-prepend Pulp.",
    },
    .{
        .movement = 10,
        .sign = "Capricorn",
        .mode = "cardinal",
        .element = "earth",
        .goal = "law",
