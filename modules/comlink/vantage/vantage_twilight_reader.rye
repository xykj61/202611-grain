pub fn next_sign_1based(cur: u32) u32 {
    const clamped = if (cur < 1 or cur > 15) 13 else cur;
    const nxt = if (clamped == 15) @as(u32, 1) else clamped + 1;
    // invariant: next sign stays strictly in 1..15.
    assert(nxt >= 1 and nxt <= 15);
    return nxt;
}

pub fn render_dusk_card(sign_1based: u32, out: []u8) ![]const u8 {
    const idx: usize = if (sign_1based >= 1 and sign_1based <= 15)
        sign_1based - 1
    else
        12;
    const e = entries[idx];
    const s = try std.fmt.bufPrint(
        out,
        "  Twilight {d}/15 [{s}]:{c}" ++
            "    Shastra : {s}{c}" ++
            "    Risala  : {s}{c}" ++
            "    Counsel : {s}{c}",
        .{
            idx + 1,
            e.sign,
            nl,
            e.shastra,
            nl,
            e.risala,
            nl,
            e.counsel,
            nl,
        },
    );
    // invariant: rendered lines stay <= 80 columns for RLCD Glasswall!
    var it = std.mem.splitScalar(u8, s, nl);
    while (it.next()) |line| assert(line.len <= 80);
    return s;
}

fn run_selftest() !u8 {
    var b: [512]u8 = undefined;
    const s13 = try render_dusk_card(13, &b);
    if (std.mem.indexOf(u8, s13, "Nur al-Anwar") == null) {
        return error.MissingAether13;
    }
    if (next_sign_1based(15) != 1 or next_sign_1based(13) != 14) {
        return error.BadCycle;
    }
    if (builtin.os.tag != .freestanding) {
        std.debug.print(
            "GREEN: vantage_twilight_reader -- 15 Shastra & Risala cards.{c}",
            .{nl},
        );
    }
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
