//! modules/comlink/vantage/vantage_app.rye -- Unified Vantage Carry & Station!
//!
//! Waves A & B (`20261115.121500`): Unites `carry.rye`, `bloom.rye`,
//! `resonance_station.rye` (3-Zone Desktop DAW in `Vantage Station`), and
//! `vantage_mutations.rye` (live conserved writes in `Dimeroll`, `Scribe`, &
//! `Surf`)!

const std = @import("std");
const builtin = @import("builtin");
const assert = std.debug.assert;
const carry = @import("carry.rye");
const bloom = @import("bloom.rye");
const res_station = @import("resonance_station.rye");
const muts = @import("vantage_mutations.rye");

pub const version = "20261115.121500";
const nl: u8 = 10;

const dimeroll_views = [_][]const u8{
    "Dashboard",
    "Transactions",
    "Inventory",
    "Cash Flow",
    "Ledger",
    "Seal",
    "Price",
};

var app_state: carry.VantageCarryState =
    carry.VantageCarryState.init(720, 1600);
var write_store: muts.VantageWriteStore = muts.VantageWriteStore.init();
var store_ready: bool = false;

fn ensure_store() void {
    if (!store_ready) {
        write_store = muts.VantageWriteStore.init();
        store_ready = true;
    }
}

export fn vantage_app_init_ffi(shortest_dp: u32, viewport_px: u32) void {
    ensure_store();
    app_state = carry.VantageCarryState.init(shortest_dp, viewport_px);
}

export fn vantage_app_touch_ffi(
    kind: u32,
    x_px: i32,
    y_px: i32,
    radius_or_pressure: u32,
) bool {
    return app_state.ingest_pointer(kind, x_px, y_px, radius_or_pressure);
}

export fn vantage_app_pinch_ffi(permille: u32) void {
    app_state.apply_pinch_permille(permille);
}

export fn vantage_app_active_tab_ffi() u32 {
    return app_state.active_tab;
}

export fn vantage_app_posture_ffi() u32 {
    return @intFromEnum(app_state.posture);
}

export fn vantage_app_res_toggle_expert_ffi() void {
    res_station.resonance_station_toggle_expert_ffi();
}

export fn vantage_app_res_toggle_solo0_ffi() void {
    res_station.resonance_station_toggle_solo0_ffi();
}

/// Interactive Write/Seal action routed by Vantage's active room!
export fn vantage_app_write_active_room_ffi() bool {
    ensure_store();
    switch (app_state.active_tab) {
        1 => {
            write_store.post_dimeroll(0, 1, 250, "Co-op Harvest Box") catch {
                return false;
            };
            return true;
        },
        3 => {
            _ = write_store.seal_scribe_draft(
                "[gadya] Clear thought [padya] |= x=@ud x",
            ) catch return false;
            return true;
        },
        5 => {
            write_store.append_surf("New peer note sealed in Blaze") catch {
                return false;
            };
            return true;
        },
        else => return false,
    }
}

fn append_line(out: []u8, pos: *usize, text: []const u8) void {
    if (pos.* + text.len + 1 > out.len) return;
    @memcpy(out[pos.* .. pos.* + text.len], text);
    pos.* += text.len;
    out[pos.*] = nl;
    pos.* += 1;
}

pub fn render_screen(st: *const carry.VantageCarryState, out: []u8) u32 {
    ensure_store();
    assert(st.active_tab < carry.tab_count);
    var pos: usize = st.render_status_bar(out);
    if (pos + 1 <= out.len) {
        out[pos] = nl;
        pos += 1;
    }

    const layout_line = switch (st.posture) {
        .station_desktop => "Layout: Station Three-Column Desk",
        .carry_tablet_split => "Layout: Carry Tablet Split-Pane RLCD",
        .carry_mobile_deck => "Layout: Carry Mobile Single-Thumb Deck",
    };
    append_line(out, &pos, layout_line);

    switch (st.active_tab) {
        0 => {
            for (bloom.galaxies, 1..) |g, idx| {
                const row = std.fmt.bufPrint(
                    out[pos..],
                    "  Bloom {d}. {s} ({d} stages){c}",
                    .{ idx, g.name, g.files.len, nl },
                ) catch break;
                pos += row.len;
            }
        },
        1 => {
            for (dimeroll_views, 1..) |v, idx| {
                const row = std.fmt.bufPrint(
                    out[pos..],
                    "  Dimeroll {d}. {s}{c}",
                    .{ idx, v, nl },
                ) catch break;
                pos += row.len;
            }
            const j_row = std.fmt.bufPrint(
                out[pos..],
                "  Journal Entries: {d} | Conservation sum(nets) = {d}{c}",
                .{ write_store.entry_count, write_store.sum_balances(), nl },
            ) catch return @intCast(pos);
            pos += j_row.len;
        },
        2 => {
            pos += res_station.render_resonance_for_posture(
                @intFromEnum(st.posture),
                out[pos..],
            );
        },
        3 => {
            const s_row = std.fmt.bufPrint(
                out[pos..],
                "  Scribe: Linengrow Champu Desk | Sealed Revisions: {d}{c}",
                .{ write_store.scribe_revisions, nl },
            ) catch return @intCast(pos);
            pos += s_row.len;
        },
        4 => append_line(
            out,
            &pos,
            "  Blaze: Content-Addressed Weaves & 3-Tier Harness",
        ),
        else => {
            const sf_hdr = std.fmt.bufPrint(
                out[pos..],
                "  Surf Chronological Commons ({d} posts):{c}",
                .{ write_store.surf_count, nl },
            ) catch return @intCast(pos);
            pos += sf_hdr.len;
            var k: u32 = 0;
            while (k < write_store.surf_count) : (k += 1) {
                const ln = write_store.surf_lens[k];
                const p_row = std.fmt.bufPrint(
                    out[pos..],
                    "    - {s}{c}",
                    .{ write_store.surf_notes[k][0..ln], nl },
                ) catch break;
                pos += p_row.len;
            }
        },
    }
    // invariant: rendered screen byte count never exceeds caller capacity.
    assert(pos <= out.len);
    return @intCast(pos);
}

export fn vantage_app_render_screen_ffi(out_ptr: [*]u8, out_cap: u32) u32 {
    if (out_cap == 0) return 0;
    return render_screen(&app_state, out_ptr[0..out_cap]);
}

fn run_selftest() !u8 {
    vantage_app_init_ffi(720, 1600);
    var scr: [2048]u8 = undefined;
    const n0 = vantage_app_render_screen_ffi(&scr, 2048);
    if (std.mem.indexOf(u8, scr[0..n0], "Bloom 1. Curriculum (10 stages)") ==
        null)
    {
        return error.MissingBloomCurriculum;
    }

    // Tab 1 (Dimeroll): interactive post updates journal & preserves sum == 0!
    _ = vantage_app_touch_ffi(0, 900, 500, 12);
    _ = vantage_app_touch_ffi(2, 650, 502, 12);
    if (!vantage_app_write_active_room_ffi()) return error.DimerollWriteFailed;
    const n1 = vantage_app_render_screen_ffi(&scr, 2048);
    if (std.mem.indexOf(u8, scr[0..n1], "Journal Entries: 1") == null) {
        return error.MissingPostedDimerollEntry;
    }

    // Station (1200dp) Tab 2 (Resonance): 3-Zone Desktop DAW!
    vantage_app_init_ffi(1200, 1600);
    _ = vantage_app_touch_ffi(0, 600, 24, 10);
    _ = vantage_app_touch_ffi(2, 600, 24, 10);
    const n2_desk = vantage_app_render_screen_ffi(&scr, 2048);
    if (std.mem.indexOf(
        u8,
        scr[0..n2_desk],
        "RESONANCE STATION DESKTOP DAW",
    ) == null) {
        return error.MissingStationDawInVantage;
    }

    // Tab 3 (Scribe): interactive Champu seal increments revision!
    _ = vantage_app_touch_ffi(0, 880, 24, 10);
    _ = vantage_app_touch_ffi(2, 880, 24, 10);
    if (!vantage_app_write_active_room_ffi()) return error.ScribeSealFailed;
    const n3 = vantage_app_render_screen_ffi(&scr, 2048);
    if (std.mem.indexOf(u8, scr[0..n3], "Sealed Revisions: 1") == null) {
        return error.MissingScribeSealCount;
    }

    if (builtin.os.tag != .freestanding) {
        std.debug.print(
            "GREEN: vantage_app -- Station DAW & interactive writes proven.{c}",
            .{nl},
        );
    }
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
