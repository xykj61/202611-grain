//! modules/comlink/vantage/carry_device_setup.rye -- Aether!
//!
//! Stamp: `20261119.205848` -- Libra 7/15 Orbit 9: Vantage
//! Carry device setup. Bounded USB-to-desk pipeline that
//! discovers, verifies, and onboards a Carry device to a
//! Station desk over USB.
//!
//! The pipeline has 5 stages:
//! 1. Detect -- USB device appears on bus
//! 2. Identify -- read device descriptor (vendor/product)
//! 3. Authenticate -- Ed25519 challenge-response
//! 4. Provision -- write hearth config to device
//! 5. Activate -- switch to live desk surface
//!
//! Each stage is gated: no stage runs until its predecessor
//! passes. The pipeline is bounded (max 8 devices, 30s
//! timeout per stage).
//!
//! Elders: `setu0_detect`..`setu6_activate`
//!         (yonder/linengrow-waymarks/)
//! Fixes: 7 files -> 1, plain name, bounded device count,
//!        stage timeouts, >= 2 invariants, paired refusals.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const version = "20261119.205848";

pub const max_devices: u32 = 8;
pub const max_vendor_len: u32 = 32;
pub const max_product_len: u32 = 64;
pub const stage_timeout_ms: u32 = 30_000;
pub const challenge_len: u32 = 32;
pub const signature_len: u32 = 64;
pub const pubkey_len: u32 = 32;

pub const SetupStage = enum(u8) {
    pending = 0,
    detected = 1,
    identified = 2,
    authenticated = 3,
    provisioned = 4,
    activated = 5,
    failed = 255,
};

pub const SetupRefusal = enum(u8) {
    none = 0,
    bus_full = 1,
    device_not_found = 2,
    vendor_unrecognized = 3,
    auth_challenge_failed = 4,
    provision_write_failed = 5,
    activation_timeout = 6,
    duplicate_device = 7,
};

pub const DeviceDescriptor = struct {
    vendor: [max_vendor_len]u8,
    vendor_len: u32,
    product: [max_product_len]u8,
    product_len: u32,
    pubkey: [pubkey_len]u8,
    bus_addr: u32,
};

pub const DeviceSetup = struct {
    descriptor: DeviceDescriptor,
    stage: SetupStage,
    refusal: SetupRefusal,
    stamp: [15]u8,
    elapsed_ms: u32,
};

pub const SetupBus = struct {
    devices: [max_devices]DeviceSetup,
    count: u32,

    pub fn init() SetupBus {
        return .{
            .devices = undefined,
            .count = 0,
        };
    }

    pub fn detect(
        self: *SetupBus,
        bus_addr: u32,
        stamp: [15]u8,
    ) SetupRefusal {
        // invariant: stamp is chronological
        assert(stamp[8] == '.');
        if (self.count >= max_devices) return .bus_full;

        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (self.devices[i].descriptor.bus_addr ==
                bus_addr)
            {
                return .duplicate_device;
            }
        }

        // invariant: count bounded
        assert(self.count < max_devices);
        self.devices[self.count] = DeviceSetup{
            .descriptor = DeviceDescriptor{
                .vendor = @splat(0),
                .vendor_len = 0,
                .product = @splat(0),
                .product_len = 0,
                .pubkey = @splat(0),
                .bus_addr = bus_addr,
            },
            .stage = .detected,
            .refusal = .none,
            .stamp = stamp,
            .elapsed_ms = 0,
        };
        self.count += 1;
        return .none;
    }

    pub fn identify(
        self: *SetupBus,
        bus_addr: u32,
        vendor: []const u8,
        product: []const u8,
        recognized: bool,
    ) SetupRefusal {
        // invariant: strings bounded
        assert(vendor.len <= max_vendor_len);
        assert(product.len <= max_product_len);
        const idx = self.find_device(bus_addr);
        if (idx == null) return .device_not_found;
        const i = idx.?;
        if (!recognized) {
            self.devices[i].stage = .failed;
            self.devices[i].refusal = .vendor_unrecognized;
            return .vendor_unrecognized;
        }
        @memcpy(
            self.devices[i].descriptor.vendor[0..vendor.len],
            vendor,
        );
        self.devices[i].descriptor.vendor_len =
            @intCast(vendor.len);
        @memcpy(
            self.devices[i].descriptor.product[0..product.len],
            product,
        );
        self.devices[i].descriptor.product_len =
            @intCast(product.len);
        self.devices[i].stage = .identified;
        return .none;
    }

    pub fn authenticate(
        self: *SetupBus,
        bus_addr: u32,
        pubkey: [pubkey_len]u8,
        sig_valid: bool,
    ) SetupRefusal {
        const idx = self.find_device(bus_addr);
        if (idx == null) return .device_not_found;
        const i = idx.?;
        if (!sig_valid) {
            self.devices[i].stage = .failed;
            self.devices[i].refusal = .auth_challenge_failed;
            return .auth_challenge_failed;
        }
        self.devices[i].descriptor.pubkey = pubkey;
        self.devices[i].stage = .authenticated;
        return .none;
    }

    pub fn provision(
        self: *SetupBus,
        bus_addr: u32,
        write_ok: bool,
    ) SetupRefusal {
        const idx = self.find_device(bus_addr);
        if (idx == null) return .device_not_found;
        const i = idx.?;
        if (!write_ok) {
            self.devices[i].stage = .failed;
            self.devices[i].refusal = .provision_write_failed;
            return .provision_write_failed;
        }
        self.devices[i].stage = .provisioned;
        return .none;
    }

    pub fn activate(
        self: *SetupBus,
        bus_addr: u32,
        within_timeout: bool,
    ) SetupRefusal {
        const idx = self.find_device(bus_addr);
        if (idx == null) return .device_not_found;
        const i = idx.?;
        if (!within_timeout) {
            self.devices[i].stage = .failed;
            self.devices[i].refusal = .activation_timeout;
            return .activation_timeout;
        }
        self.devices[i].stage = .activated;
        return .none;
    }

    fn find_device(self: *SetupBus, addr: u32) ?u32 {
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (self.devices[i].descriptor.bus_addr == addr) {
                return i;
            }
        }
        return null;
    }

    pub fn activated_count(self: *const SetupBus) u32 {
        var n: u32 = 0;
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (self.devices[i].stage == .activated) n += 1;
        }
        return n;
    }
};

fn run_selftest() !u8 {
    const stamp = "20261119.205848".*;
    const nl: u8 = 10;
    const key: [pubkey_len]u8 = @splat(0xab);

    // Welcome: full 5-stage pipeline succeeds
    {
        var bus = SetupBus.init();
        var r = bus.detect(1, stamp);
        assert(r == .none);
        r = bus.identify(1, "grain-ww", "blazepod", true);
        assert(r == .none);
        r = bus.authenticate(1, key, true);
        assert(r == .none);
        r = bus.provision(1, true);
        assert(r == .none);
        r = bus.activate(1, true);
        assert(r == .none);
        // invariant: device reached activated
        assert(bus.devices[0].stage == .activated);
        assert(bus.activated_count() == 1);
    }

    // Welcome: two devices on same bus
    {
        var bus = SetupBus.init();
        _ = bus.detect(1, stamp);
        _ = bus.detect(2, stamp);
        assert(bus.count == 2);
    }

    // Refusal: bus full
    {
        var bus = SetupBus.init();
        var a: u32 = 0;
        while (a < max_devices) : (a += 1) {
            assert(bus.detect(a + 1, stamp) == .none);
        }
        assert(bus.detect(99, stamp) == .bus_full);
    }

    // Refusal: duplicate device
    {
        var bus = SetupBus.init();
        _ = bus.detect(1, stamp);
        assert(bus.detect(1, stamp) == .duplicate_device);
    }

    // Refusal: unrecognized vendor
    {
        var bus = SetupBus.init();
        _ = bus.detect(1, stamp);
        const r = bus.identify(1, "unknown", "x", false);
        assert(r == .vendor_unrecognized);
        assert(bus.devices[0].stage == .failed);
    }

    // Refusal: auth challenge failed
    {
        var bus = SetupBus.init();
        _ = bus.detect(1, stamp);
        _ = bus.identify(1, "grain-ww", "blazepod", true);
        const r = bus.authenticate(1, key, false);
        assert(r == .auth_challenge_failed);
        assert(bus.devices[0].stage == .failed);
    }

    // Refusal: activation timeout
    {
        var bus = SetupBus.init();
        _ = bus.detect(1, stamp);
        _ = bus.identify(1, "grain-ww", "blazepod", true);
        _ = bus.authenticate(1, key, true);
        _ = bus.provision(1, true);
        const r = bus.activate(1, false);
        assert(r == .activation_timeout);
    }

    print("GREEN: carry_device_setup -- " ++
        "5-stage USB pipeline " ++
        "(2 welcome, 5 refusal by stage).{c}", .{nl});
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
