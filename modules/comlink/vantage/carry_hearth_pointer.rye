//! modules/comlink/vantage/carry_hearth_pointer.rye -- Aether!
//!
//! Stamp: `20261119.204643` -- Taurus 2/15 Orbit 9: Vantage
//! Carry hearth pointer. Tracks which hearth is active across
//! sessions by reading/writing a bounded pointer file.
//!
//! The pointer file holds exactly one two-letter home_id. On
//! boot, Carry reads this file and switches the registry to
//! that hearth. On switch, Carry writes the new id. If the
//! file is missing or corrupt, Carry falls back to the first
//! registered hearth (safe default).
//!
//! Elder: persistence logic scattered across hearth_lulu0..5
//! Fixes: single module owns pointer, bounded read/write,
//!        corrupt-file refusal, missing-file fallback.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const mold = @import("carry_hearth_mold.rye");

pub const version = "20261119.204643";

pub const pointer_path = "files/hearth_pointer.kyri";
pub const max_pointer_file_len: u32 = 64;
pub const pointer_header = "format hearth-pointer\nhome_id ";

pub const PointerReadResult = struct {
    home_id: [mold.max_home_id_len]u8,
    valid: bool,
};

pub fn parse_pointer(
    buf: []const u8,
    len: u32,
) PointerReadResult {
    // invariant: len fits read buffer
    assert(len <= max_pointer_file_len);
    const hdr = pointer_header;
    if (len < hdr.len + mold.max_home_id_len) {
        return .{ .home_id = undefined, .valid = false };
    }
    if (!std.mem.eql(u8, buf[0..hdr.len], hdr)) {
        return .{ .home_id = undefined, .valid = false };
    }
    const id_start = hdr.len;
    const c0 = buf[id_start];
    const c1 = buf[id_start + 1];
    // invariant: home_id chars are printable ASCII
    if (c0 < 0x20 or c0 > 0x7e) {
        return .{ .home_id = undefined, .valid = false };
    }
    if (c1 < 0x20 or c1 > 0x7e) {
        return .{ .home_id = undefined, .valid = false };
    }
    return .{
        .home_id = .{ c0, c1 },
        .valid = true,
    };
}

pub fn serialize_pointer(
    home_id: [mold.max_home_id_len]u8,
    buf: []u8,
) u32 {
    // invariant: buffer fits pointer file
    assert(buf.len >= max_pointer_file_len);
    const hdr = pointer_header;
    @memcpy(buf[0..hdr.len], hdr);
    var pos: u32 = @intCast(hdr.len);
    buf[pos] = home_id[0];
    pos += 1;
    buf[pos] = home_id[1];
    pos += 1;
    buf[pos] = '\n';
    pos += 1;
    // invariant: output fits bounded buffer
    assert(pos <= max_pointer_file_len);
    return pos;
}

pub fn resolve_active(
    reg: *const mold.HearthRegistry,
    pointer: PointerReadResult,
) u32 {
    // invariant: registry has at least one hearth
    assert(reg.count > 0);
    if (!pointer.valid) return 0;
    var i: u32 = 0;
    while (i < reg.count) : (i += 1) {
        const h = &reg.hearths[i];
        if (h.home_id[0] == pointer.home_id[0] and
            h.home_id[1] == pointer.home_id[1])
        {
            return i;
        }
    }
    return 0;
}

fn run_selftest() !u8 {
    const stamp = "20261119.204643".*;
    const nl: u8 = 10;

    // Welcome: round-trip serialize and parse
    {
        const id = "kd".*;
        var buf: [max_pointer_file_len]u8 = @splat(0);
        const len = serialize_pointer(id, &buf);
        assert(len > 0);
        const result = parse_pointer(&buf, len);
        // invariant: round-trip preserves home_id
        assert(result.valid);
        assert(result.home_id[0] == 'k');
        assert(result.home_id[1] == 'd');
    }

    // Welcome: resolve finds registered hearth
    {
        var reg = mold.HearthRegistry.init();
        try reg.add(mold.HearthMold.init(
            "aa".*, .scaled_540, .local, stamp,
        ));
        try reg.add(mold.HearthMold.init(
            "kd".*, .blazepod_floor, .usb, stamp,
        ));
        const ptr = PointerReadResult{
            .home_id = "kd".*,
            .valid = true,
        };
        const idx = resolve_active(&reg, ptr);
        // invariant: found at index 1
        assert(idx == 1);
    }

    // Refusal: corrupt header
    {
        const bad = "garbage data here!!";
        const result = parse_pointer(bad, @intCast(bad.len));
        assert(!result.valid);
    }

    // Refusal: truncated file
    {
        const short = "format hearth";
        const result = parse_pointer(
            short,
            @intCast(short.len),
        );
        assert(!result.valid);
    }

    // Refusal: non-ASCII home_id (fallback to index 0)
    {
        var reg = mold.HearthRegistry.init();
        try reg.add(mold.HearthMold.init(
            "aa".*, .scaled_540, .local, stamp,
        ));
        const invalid_ptr = PointerReadResult{
            .home_id = undefined,
            .valid = false,
        };
        const idx = resolve_active(&reg, invalid_ptr);
        // invariant: invalid pointer falls back to 0
        assert(idx == 0);
    }

    // Refusal: pointer for unregistered hearth
    {
        var reg = mold.HearthRegistry.init();
        try reg.add(mold.HearthMold.init(
            "aa".*, .scaled_540, .local, stamp,
        ));
        const missing_ptr = PointerReadResult{
            .home_id = "zz".*,
            .valid = true,
        };
        const idx = resolve_active(&reg, missing_ptr);
        // invariant: missing hearth falls back to 0
        assert(idx == 0);
    }

    print("GREEN: carry_hearth_pointer -- " ++
        "round-trip + resolve (2 welcome), " ++
        "corrupt + truncated + invalid + missing " ++
        "(4 refusal).{c}", .{nl});
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
