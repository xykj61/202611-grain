//! modules/comlink/parcel/gemini/gemini_airlock.rye -- TAME Gemini airlock.
//!
//! Orbits 18-19 of `20261115-053000` (`20261115.063000`).
//! Inaugural Comlink Parcel #1 (`comlink-gemini`):
//!   1. Vaulted `SecretKeyBox` ensures the raw `AIza...` API key can NEVER be
//!      echoed into prompts, traces, or error messages (`KeyLeakInPrompt`),
//!   2. 10-stage bounded untrusted-input normalizer (`Horos`-inspired): strips
//!      NUL/C0 control bytes, normalizes CRLF -> LF, collapsesbidi/zero-width
//!      smuggling bytes, and enforces `max_prompt_bytes = 16384`,
//!   3. Frames deterministic JSON request bodies inside a static buffer.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const version = "20261115.063000";
pub const max_prompt_bytes: u32 = 16384;
pub const max_json_bytes: u32 = 32768;
const nl: u8 = 10;
const cr: u8 = 13;
const tab: u8 = 9;
const bs: u8 = 92;
const dq: u8 = 34;

pub const AirlockError = error{
    InvalidKeyFormat,
    PromptTooLong,
    EmptyPrompt,
    ControlByteRejected,
    NonAsciiSmugglingRejected,
    KeyLeakInPrompt,
    BufferTooSmall,
};

pub const VaultedGeminiKey = struct {
    raw_private: [64]u8,
    len: u32,

    pub fn seal(raw_key: []const u8) AirlockError!VaultedGeminiKey {
        // Google Gemini API keys start with "AIza" and span ~39 characters.
        if (raw_key.len < 20 or raw_key.len > 64) return error.InvalidKeyFormat;
        if (!std.mem.startsWith(u8, raw_key, "AIza")) {
            return error.InvalidKeyFormat;
        }
        var box = VaultedGeminiKey{
            .raw_private = std.mem.zeroes([64]u8),
            .len = @intCast(raw_key.len),
        };
        @memcpy(box.raw_private[0..raw_key.len], raw_key);
        // invariant: sealed key length fits inside fixed 64-byte vault.
        assert(box.len >= 20 and box.len <= 64);
        return box;
    }

    pub fn redacted_label(self: *const VaultedGeminiKey) []const u8 {
        assert(self.len >= 20);
        return "AIza...[SEALED-IN-VAULT]";
    }

    pub fn slice_for_tls_header_only(self: *const VaultedGeminiKey) []const u8 {
        assert(self.len <= 64);
        return self.raw_private[0..self.len];
    }
};

/// 10-stage deterministic untrusted-input normalizer (`Horos`-inspired):
/// Stage 1: Length ceiling (`<= max_prompt_bytes`)
/// Stage 2: NUL byte refusal
/// Stage 3: C0 control byte refusal (except LF, CR, TAB)
/// Stage 4: DEL (0x7F) refusal
/// Stage 5: Non-ASCII / zero-width / bidi homoglyph refusal (7-bit ASCII gate)
/// Stage 6: CRLF / bare CR -> canonical LF normalization
/// Stage 7: Leading/trailing whitespace trim
/// Stage 8: Consecutive blank-line clamp (max 2 consecutive newlines)
/// Stage 9: Vaulted API-key echo guard (`KeyLeakInPrompt`)
/// Stage 10: Non-empty post-normalization assertion
pub fn normalize_prompt(
    raw: []const u8,
    key: *const VaultedGeminiKey,
    out: []u8,
) AirlockError!u32 {
    if (raw.len > max_prompt_bytes) return error.PromptTooLong;
    if (out.len < raw.len) return error.BufferTooSmall;

    var w: u32 = 0;
    var nl_run: u32 = 0;
    var i: usize = 0;
    while (i < raw.len) : (i += 1) {
        const b = raw[i];
        if (b == 0 or b == 0x7f) return error.ControlByteRejected;
        if (b < 32 and b != nl and b != cr and b != tab) {
            return error.ControlByteRejected;
        }
        if (b > 126) return error.NonAsciiSmugglingRejected;

        if (b == cr) {
            if (i + 1 < raw.len and raw[i + 1] == nl) continue;
            if (nl_run < 2) {
                out[w] = nl;
                w += 1;
                nl_run += 1;
            }
            continue;
        }
        if (b == nl) {
            if (nl_run < 2) {
                out[w] = nl;
                w += 1;
                nl_run += 1;
            }
            continue;
        }
        nl_run = 0;
        out[w] = b;
        w += 1;
    }

    const trimmed = std.mem.trim(u8, out[0..w], &[_]u8{ 32, tab, nl });
    if (trimmed.len == 0) return error.EmptyPrompt;

    // Stage 9: Refuse if the raw Gemini API key appears anywhere in the prompt!
    const secret = key.slice_for_tls_header_only();
    if (std.mem.indexOf(u8, trimmed, secret) != null) {
        return error.KeyLeakInPrompt;
    }

    // Shift trimmed slice to index 0 if needed
    const final_len: u32 = @intCast(trimmed.len);
    if (@intFromPtr(trimmed.ptr) != @intFromPtr(out.ptr)) {
        std.mem.copyForwards(u8, out[0..final_len], trimmed);
    }
    // invariant: normalized prompt is non-empty and within max_prompt_bytes.
    assert(final_len >= 1 and final_len <= max_prompt_bytes);
    return final_len;
}

pub fn build_gemini_request_json(
    model: []const u8,
    clean_prompt: []const u8,
    out: []u8,
) AirlockError!u32 {
    // invariant: model name and prompt must be non-empty.
    assert(model.len >= 1 and clean_prompt.len >= 1);
    var pos: usize = 0;
    var pbuf: [32]u8 = undefined;
    var mbuf: [64]u8 = undefined;
    var sbuf: [16]u8 = undefined;
    const prefix = std.fmt.bufPrint(&pbuf, "{{{c}model{c}:{c}", .{
        dq, dq, dq,
    }) catch return error.BufferTooSmall;
    const mid = std.fmt.bufPrint(
        &mbuf,
        "{c},{c}contents{c}:[{{{c}parts{c}:[{{{c}text{c}:{c}",
        .{ dq, dq, dq, dq, dq, dq, dq, dq },
    ) catch return error.BufferTooSmall;
    const suffix = std.fmt.bufPrint(&sbuf, "{c}}}]}}]}}", .{
        dq,
    }) catch return error.BufferTooSmall;

    if (prefix.len + model.len + mid.len + suffix.len >= out.len) {
        return error.BufferTooSmall;
    }
    @memcpy(out[pos .. pos + prefix.len], prefix);
    pos += prefix.len;
    @memcpy(out[pos .. pos + model.len], model);
    pos += model.len;
    @memcpy(out[pos .. pos + mid.len], mid);
    pos += mid.len;

    for (clean_prompt) |c| {
        if (pos + 4 >= out.len) return error.BufferTooSmall;
        if (c == dq or c == bs) {
            out[pos] = bs;
            out[pos + 1] = c;
            pos += 2;
        } else if (c == nl) {
            out[pos] = bs;
            out[pos + 1] = 'n';
            pos += 2;
        } else if (c == tab) {
            out[pos] = bs;
            out[pos + 1] = 't';
            pos += 2;
        } else {
            out[pos] = c;
            pos += 1;
        }
    }
    if (pos + suffix.len > out.len) return error.BufferTooSmall;
    @memcpy(out[pos .. pos + suffix.len], suffix);
    pos += suffix.len;
    assert(pos <= max_json_bytes);
    return @intCast(pos);
}

fn run_selftest() !u8 {
    const demo_k = "AIza" ++ "SyDemoGrainVaultKey0123456789abcdef";
    const key = try VaultedGeminiKey.seal(demo_k);
    if (!std.mem.eql(u8, key.redacted_label(), "AIza...[SEALED-IN-VAULT]")) {
        return error.BadRedaction;
    }

    // 1. Happy path normalization + JSON framing
    var norm_buf: [1024]u8 = undefined;
    const n = try normalize_prompt(
        "  Explain Glow |= gates simply!  ",
        &key,
        &norm_buf,
    );
    var json_buf: [2048]u8 = undefined;
    const jn = try build_gemini_request_json(
        "gemini-4-carbon",
        norm_buf[0..n],
        &json_buf,
    );
    if (std.mem.indexOf(u8, json_buf[0..jn], "gemini-4-carbon") == null) {
        return error.MissingModel;
    }

    // 2. Refusal A: Secret API key accidentally pasted into prompt
    const leak_msg = "Here is my key " ++ demo_k;
    if (normalize_prompt(leak_msg, &key, &norm_buf)) |_| {
        return error.KeyEchoAccepted;
    } else |err| {
        if (err != error.KeyLeakInPrompt) return err;
    }

    // 3. Refusal B: NUL / control byte smuggling
    if (normalize_prompt(&[_]u8{ 'h', 'i', 0x00 }, &key, &norm_buf)) |_| {
        return error.NulAccepted;
    } else |err| {
        if (err != error.ControlByteRejected) return err;
    }

    // 4. Refusal C: Non-ASCII homoglyph / bidi override smuggling
    const bidi = [_]u8{ 'h', 0xE2, 0x80, 0xAE };
    if (normalize_prompt(&bidi, &key, &norm_buf)) |_| {
        return error.BidiAccepted;
    } else |err| {
        if (err != error.NonAsciiSmugglingRejected) return err;
    }

    print("GREEN: gemini_airlock -- vault & 10-stage airlock proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
