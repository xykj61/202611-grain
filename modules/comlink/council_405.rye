//! modules/comlink/council_405.rye -- `d15-3-9-405` & `324/405` (80%) Law!
//!
//! Stamp: `20261115.133500` -- Supersedes the legacy `d12-60-720` topology with
//! Keaton's single-stranded **`d15 -> 3 -> 9 -> 405`** Council & Direct-
//! Democracy Supermajority architecture uniting `Kumara`, `Mycelium`,
//! `Colloquium`, and `Blaze`:
//!   - `15` Root Galaxies (`d15` -- aligned 1:1 with the 15 Calfive Signs!),
//!   - `x 3` Modal Pillars per Galaxy (`Cardinal, Fixed, Dual` = `45` Stars),
//!   - `x 9` Navamsa Council Seats per Star (`45 * 9 = 405` Total Seats!),
//!   - **`324 / 405` Exact `80.000%` Supermajority (`324 * 5 == 405 * 4`):**
//!     zero floating-point rounding, exact 80/20 Pareto direct-democracy seal!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha3_256 = std.crypto.hash.sha3.Sha3_256;

pub const version = "20261115.133500";
pub const galaxy_count: u32 = 15;
pub const pillars_per_galaxy: u32 = 3;
pub const star_circles: u32 = galaxy_count * pillars_per_galaxy; // 45
pub const seats_per_star: u32 = 9;
pub const council_seats: u32 = star_circles * seats_per_star; // 405!
pub const supermajority_80pct: u32 = 324; // 324/405 = 4/5 (80%)!
const nl: u8 = 10;

pub const CouncilError = error{
    SeatOutOfRange,
    DuplicateBallotFromSeat,
    SupermajorityNotReached,
};

pub const SeatCoord = struct {
    galaxy: u8, // 0..14 (d15)
    pillar: u8, // 0..2  (cardinal, fixed, dual)
    navamsa: u8, // 0..8 (9 seats)
};

pub fn decode_seat(seat_id: u32) CouncilError!SeatCoord {
    if (seat_id >= council_seats) return error.SeatOutOfRange;
    const star_idx = seat_id / seats_per_star; // 0..44
    const nav: u8 = @intCast(seat_id % seats_per_star);
    const gal: u8 = @intCast(star_idx / pillars_per_galaxy);
    const pil: u8 = @intCast(star_idx % pillars_per_galaxy);
    // invariant: decoded coordinates reconstruct `seat_id` bijectively.
    assert(gal < 15 and pil < 3 and nav < 9);
    assert((@as(u32, gal) * 3 + pil) * 9 + nav == seat_id);
    return .{ .galaxy = gal, .pillar = pil, .navamsa = nav };
}

pub const ColloquiumBallotBox = struct {
    proposal_sha3: [32]u8,
    voted_words: [7]u64, // 7 * 64 = 448 bits >= 405 seats!
    yes_count: u32,
    no_count: u32,

    pub fn open(proposal_text: []const u8) ColloquiumBallotBox {
        // invariant: 324 is exact 4/5 (80.000%) of 405 with zero remainder!
        assert(supermajority_80pct * 5 == council_seats * 4);
        assert(council_seats - supermajority_80pct == 81);
        var box = std.mem.zeroes(ColloquiumBallotBox);
        Sha3_256.hash(proposal_text, &box.proposal_sha3, .{});
        return box;
    }

    pub fn cast_ballot(
        self: *ColloquiumBallotBox,
        seat_id: u32,
        approve: bool,
    ) CouncilError!void {
        _ = try decode_seat(seat_id);
        const word_idx: usize = seat_id / 64;
        const bit_idx: u6 = @intCast(seat_id % 64);
        const mask: u64 = @as(u64, 1) << bit_idx;
        if ((self.voted_words[word_idx] & mask) != 0) {
            return error.DuplicateBallotFromSeat;
        }
        self.voted_words[word_idx] |= mask;
        if (approve) self.yes_count += 1 else self.no_count += 1;
        assert(self.yes_count + self.no_count <= council_seats);
    }

    /// Seals a Blaze enactment certificate ONLY if `yes_count >= 324` (80.0%)!
    pub fn seal_blaze_enactment(
        self: *const ColloquiumBallotBox,
    ) CouncilError![32]u8 {
        if (self.yes_count < supermajority_80pct) {
            return error.SupermajorityNotReached;
        }
        var h = Sha3_256.init(.{});
        h.update("blaze-council-405-enacted:");
        h.update(&self.proposal_sha3);
        var b4: [4]u8 = undefined;
        std.mem.writeInt(u32, &b4, self.yes_count, .little);
        h.update(&b4);
        var cert: [32]u8 = undefined;
        h.final(&cert);
        assert(self.yes_count >= 324);
        return cert;
    }
};

fn run_selftest() !u8 {
    // 1. Bijective decode across all 405 seats (0..404) + 405 refused!
    var s: u32 = 0;
    while (s < council_seats) : (s += 1) _ = try decode_seat(s);
    if (decode_seat(405)) |_| {
        return error.Seat405Accepted;
    } else |err| {
        if (err != error.SeatOutOfRange) return err;
    }

    // 2. 323 yes votes (79.75%) MUST refuse; 324th vote (80.00%) enacts!
    var box = ColloquiumBallotBox.open("Adopt active-pulp & 324/405 law");
    var v: u32 = 0;
    while (v < 323) : (v += 1) try box.cast_ballot(v, true);
    if (box.seal_blaze_enactment()) |_| {
        return error.EnactedAt323;
    } else |err| {
        if (err != error.SupermajorityNotReached) return err;
    }

    // Duplicate vote from seat 0 refused!
    if (box.cast_ballot(0, true)) |_| {
        return error.DupBallotAccepted;
    } else |err| {
        if (err != error.DuplicateBallotFromSeat) return err;
    }

    // Seat 323 casts the 324th affirmative vote -> exact 80.000% enacted!
    try box.cast_ballot(323, true);
    const cert = try box.seal_blaze_enactment();
    if (cert[0] == 0 and cert[1] == 0) return error.EmptyCert;

    print("GREEN: council_405 -- d15-3-9-405 & 324/405 proven.{c}", .{nl});
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
