//! modules/comlink/constel_aquarius_federation.rye -- 405 Peer Federation!
//!
//! Stamp: `20261119.165127` -- Orbit 5, `Movement 11/15 : Aquarius` (*Share
//! clean water across 405 peers with little toll*), powering
//! `grain-ww aquarius-405` (Proof #58)!
//! Proves deterministic `<= 3`-hop `Constel` gossip convergence across all
//! `15 x 3 x 9 = 405` Colloquium seats under strict `<= 1,200`-byte MTU toll:
//!   - Hop 1: Origin -> `15` House bridges (`15` peers),
//!   - Hop 2: `15` House bridges -> `45` Triad relays (`15 x 3`),
//!   - Hop 3: `45` Triad relays -> all `405` seats (`45 x 9`),
//!   - Paired refusal witnesses for MTU overflow (`> 1200`), hop overflow
//!     (`> 3`), and duplicate/Sybil seat ballots!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha3_256 = std.crypto.hash.sha3.Sha3_256;

pub const version = "20261119.165127";
pub const total_seats: u32 = 405; // 15 houses * 3 triads * 9 seats
pub const max_hops: u32 = 3;
pub const max_mtu_bytes: u32 = 1200;
pub const op_quorum: u32 = 243;   // 60% of 405
pub const const_quorum: u32 = 324; // 80% of 405
const nl: u8 = 10;

pub const FederationError = error{
    HopLimitExceeded,
    MtuTollExceeded,
    SeatOutOfRange,
    DuplicateSeatBallotRefused,
};

pub const GossipPacket = struct {
    proposal_id: u64,
    hop: u32,
    wire_bytes: u32,
    seat_id: u32,
    approve: bool,
};

pub const FederationState = struct {
    seen: [total_seats]bool,
    yes_votes: u32,
    total_ballots: u32,
    max_hop_seen: u32,

    pub fn init() FederationState {
        return std.mem.zeroes(FederationState);
    }

    pub fn ingest_ballot(
        self: *FederationState,
        pkt: GossipPacket,
    ) FederationError!void {
        // invariant: enforce <=3 hops, <=1200 B toll, & unique seat 0..404.
        if (pkt.hop == 0 or pkt.hop > max_hops) {
            return error.HopLimitExceeded;
        }
        if (pkt.wire_bytes == 0 or pkt.wire_bytes > max_mtu_bytes) {
            return error.MtuTollExceeded;
        }
        if (pkt.seat_id >= total_seats) return error.SeatOutOfRange;
        if (self.seen[pkt.seat_id]) return error.DuplicateSeatBallotRefused;

        self.seen[pkt.seat_id] = true;
        self.total_ballots += 1;
        if (pkt.approve) self.yes_votes += 1;
        if (pkt.hop > self.max_hop_seen) self.max_hop_seen = pkt.hop;
        assert(self.total_ballots <= total_seats);
        assert(self.yes_votes <= self.total_ballots);
    }

    pub fn seal_quorum_digest(self: *const FederationState) [32]u8 {
        var out: [32]u8 = undefined;
        var h = Sha3_256.init(.{});
        h.update("grain-constel-aquarius-405-v1:");
        var b12: [12]u8 = undefined;
        std.mem.writeInt(u32, b12[0..4], self.total_ballots, .little);
        std.mem.writeInt(u32, b12[4..8], self.yes_votes, .little);
        std.mem.writeInt(u32, b12[8..12], self.max_hop_seen, .little);
        h.update(&b12);
        h.final(&out);
        assert((out[0] | out[1] | out[2]) != 0);
        return out;
    }
};

fn hop_for_seat(seat_id: u32) u32 {
    // 15 House bridges at hop 1; 30 extra Triad relays at hop 2; rest hop 3.
    const in_house = seat_id % 27;
    if (in_house == 0) return 1;
    if (in_house % 9 == 0) return 2;
    return 3;
}

fn run_selftest() !u8 {
    var fed = FederationState.init();

    // 1. Welcome: all 405 seats converge in <=3 hops at 112-byte wire toll
    var s: u32 = 0;
    while (s < total_seats) : (s += 1) {
        try fed.ingest_ballot(.{
            .proposal_id = 77,
            .hop = hop_for_seat(s),
            .wire_bytes = 112,
            .seat_id = s,
            .approve = (s < const_quorum), // exact 324/405 constitutional!
        });
    }
    if (fed.total_ballots != 405 or fed.yes_votes != 324) {
        return error.QuorumCountWrong;
    }
    if (fed.max_hop_seen != 3) return error.HopBoundWrong;
    const digest = fed.seal_quorum_digest();
    if (digest[0] == 0 and digest[1] == 0) return error.EmptyDigest;

    // 2. Refusal 1: duplicate/Sybil seat ballot rejected cleanly
    if (fed.ingest_ballot(.{
        .proposal_id = 77,
        .hop = 1,
        .wire_bytes = 112,
        .seat_id = 0,
        .approve = true,
    })) |_| {
        return error.SybilBallotAccepted;
    } else |err| {
        if (err != error.DuplicateSeatBallotRefused) return err;
    }

    // 3. Refusal 2: oversized MTU toll (1201 > 1200) rejected cleanly
    var fed2 = FederationState.init();
    if (fed2.ingest_ballot(.{
        .proposal_id = 77,
        .hop = 1,
        .wire_bytes = 1201,
        .seat_id = 5,
        .approve = true,
    })) |_| {
        return error.OversizedMtuAccepted;
    } else |err| {
        if (err != error.MtuTollExceeded) return err;
    }

    // 4. Refusal 3: hop count 4 (> 3) rejected cleanly
    if (fed2.ingest_ballot(.{
        .proposal_id = 77,
        .hop = 4,
        .wire_bytes = 112,
        .seat_id = 5,
        .approve = true,
    })) |_| {
        return error.ExcessHopAccepted;
    } else |err| {
        if (err != error.HopLimitExceeded) return err;
    }

    print(
        "GREEN: constel_aquarius -- 405/405 peers in <=3 hops (324 yes)!{c}",
        .{nl},
    );
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
