//! modules/comlink/constel_405_discovery.rye -- Gatekeeper-Free 405 Mesh!
//!
//! Stamp: `20261115.160500` -- `Movement 11/15 : Aquarius` (*Commons & Comlink:
//! peer constellations without gatekeepers*), powering `grain-ww constel`!
//!   1. **Self-Certifying `Kumara` Peer Cards:** Every seat `0..404` signs its
//!      own `Pond Puddle` UDP `ip_v4:port` + monotonic `revision` via Ed25519
//!      (zero DNS registrars or certificate authorities!),
//!   2. **Anti-Rollback Refusal:** Replayed stale revisions (`<= current`)
//!      refuse with `error.StaleRevisionRefused`,
//!   3. **Bounded `<= 3`-Hop Routing:** Same Star Circle = `1` hop; same
//!      Galaxy = `2` hops; cross-Galaxy = `3` hops across all 405 seats!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Ed25519 = std.crypto.sign.Ed25519;
const c405 = @import("council_405.rye");

pub const version = "20261115.160500";
const nl: u8 = 10;

pub const DiscoveryError = error{
    SeatOutOfRange,
    InvalidSignature,
    PubkeyPinMismatch,
    StaleRevisionRefused,
};

pub const SignedPeerCard = struct {
    seat_id: u32,
    revision: u64,
    ip_v4: u32,
    udp_port: u16,
    pubkey: [32]u8,
    sig: [64]u8,

    pub fn sign_card(
        seat_id: u32,
        revision: u64,
        ip_v4: u32,
        udp_port: u16,
        kp: Ed25519.KeyPair,
    ) !SignedPeerCard {
        var payload: [18]u8 = undefined;
        pack_fields(seat_id, revision, ip_v4, udp_port, &payload);
        const sig = try kp.sign(&payload, null);
        return .{
            .seat_id = seat_id,
            .revision = revision,
            .ip_v4 = ip_v4,
            .udp_port = udp_port,
            .pubkey = kp.public_key.toBytes(),
            .sig = sig.toBytes(),
        };
    }
};

fn pack_fields(
    seat_id: u32,
    revision: u64,
    ip_v4: u32,
    udp_port: u16,
    out: *[18]u8,
) void {
    std.mem.writeInt(u32, out[0..4], seat_id, .little);
    std.mem.writeInt(u64, out[4..12], revision, .little);
    std.mem.writeInt(u32, out[12..16], ip_v4, .little);
    std.mem.writeInt(u16, out[16..18], udp_port, .little);
}

pub const PeerSlot = struct {
    occupied: bool,
    revision: u64,
    ip_v4: u32,
    udp_port: u16,
    pubkey: [32]u8,
};

pub const ConstelDirectory = struct {
    slots: [c405.council_seats]PeerSlot,

    pub fn init() ConstelDirectory {
        return std.mem.zeroes(ConstelDirectory);
    }

    pub fn announce_card(
        self: *ConstelDirectory,
        card: SignedPeerCard,
    ) DiscoveryError!void {
        if (card.seat_id >= c405.council_seats) return error.SeatOutOfRange;

        var payload: [18]u8 = undefined;
        pack_fields(
            card.seat_id,
            card.revision,
            card.ip_v4,
            card.udp_port,
            &payload,
        );
        const pk = Ed25519.PublicKey.fromBytes(card.pubkey) catch {
            return error.InvalidSignature;
        };
        const sig = Ed25519.Signature.fromBytes(card.sig);
        sig.verify(&payload, pk) catch return error.InvalidSignature;

        var slot = &self.slots[card.seat_id];
        if (slot.occupied) {
            if (!std.mem.eql(u8, &slot.pubkey, &card.pubkey)) {
                return error.PubkeyPinMismatch;
            }
            if (card.revision <= slot.revision) {
                return error.StaleRevisionRefused;
            }
        }
        slot.* = .{
            .occupied = true,
            .revision = card.revision,
            .ip_v4 = card.ip_v4,
            .udp_port = card.udp_port,
            .pubkey = card.pubkey,
        };
        // invariant: stored revision is >= 1 and seat is occupied.
        assert(slot.occupied and slot.revision >= 1);
    }

    /// Exact hop distance in `d15 -> 3 -> 9 -> 405`: `0`, `1`, `2`, or `3`!
    pub fn hop_distance(src_seat: u32, dst_seat: u32) !u8 {
        if (src_seat == dst_seat) return 0;
        const a = try c405.decode_seat(src_seat);
        const b = try c405.decode_seat(dst_seat);
        const hops: u8 = if (a.galaxy == b.galaxy and a.pillar == b.pillar)
            1
        else if (a.galaxy == b.galaxy)
            2
        else
            3;
        // invariant: every distinct seat pair in 0..404 routes in 1..3 hops!
        assert(hops >= 1 and hops <= 3);
        return hops;
    }
};

fn run_selftest() !u8 {
    var dir = ConstelDirectory.init();
    const seed: [32]u8 = @splat(0x2B);
    const kp = try Ed25519.KeyPair.generateDeterministic(seed);

    // 1. Seat 297 (Aquarius Galaxy 10!) announces rev 1 -> roams to rev 2!
    const c1 = try SignedPeerCard.sign_card(297, 1, 0xC0A8_010A, 9405, kp);
    try dir.announce_card(c1);

    const c2 = try SignedPeerCard.sign_card(297, 2, 0x0A00_0042, 9406, kp);
    try dir.announce_card(c2);
    if (dir.slots[297].udp_port != 9406) return error.RoamUpdateMissed;

    // 2. Replaying stale revision 1 MUST refuse!
    if (dir.announce_card(c1)) |_| {
        return error.StaleCardAccepted;
    } else |err| {
        if (err != error.StaleRevisionRefused) return err;
    }

    // 3. Exhaustive diameter proof: all 405x405 pairs route in <= 3 hops!
    if ((try ConstelDirectory.hop_distance(0, 8)) != 1) return error.BadHop1;
    if ((try ConstelDirectory.hop_distance(0, 9)) != 2) return error.BadHop2;
    if ((try ConstelDirectory.hop_distance(0, 404)) != 3) return error.BadHop3;

    print(
        "GREEN: constel_405_discovery -- <=3-hop mesh & Ed25519 cards.{c}",
        .{nl},
    );
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
