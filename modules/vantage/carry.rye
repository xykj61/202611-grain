//! modules/vantage/carry.rye -- Vantage Carry application core & FFI.
//!
//! Stamp: `20261115.090500`): Implements `Carry` (`Carry Tablet` on
//! Daylight Computer DC-1 Kotlin, `Carry Mobile` handheld RLCD, macOS Swift,
//! and browser WASM) strictly in terms of **Vantage**.
//!
//! Architectural invariant:
//!   Platform shells (Kotlin, Swift, WASM) hold ZERO application logic, posture
//!   thresholds, tab state, or gesture math. Every shell forwards raw pointer
//!   events into `carry_ingest_touch_ffi` and queries Vantage's state & RLCD
//!   bar bytes via the C-ABI exports declared in `include/vantage_carry.h`.

const std = @import("std");
const builtin = @import("builtin");
const assert = std.debug.assert;

pub const carry_version = "20261115.090500";
pub const tab_count: u32 = 6;
pub const max_finger_radius_px: u32 = 28;
pub const swipe_threshold_px: i32 = 96;
pub const tap_slop_px: u32 = 20;
pub const min_font_pt: u32 = 12;
pub const max_font_pt: u32 = 32;
pub const max_stylus_points: u32 = 256;
const nl: u8 = 10;

pub const Posture = enum(u32) {
    station_desktop = 0,
    carry_tablet_split = 1, // Daylight DC-1 10.5" (>= 600dp shortest width)
    carry_mobile_deck = 2,  // Pocket Blazepod (< 600dp single-thumb deck)
};

pub const tab_labels = [tab_count][*:0]const u8{
    "Bloom",
    "Dimeroll",
    "Resonance",
    "Scribe",
    "Blaze",
    "Surf",
};

pub const StylusPoint = struct {
    x_px: i32,
    y_px: i32,
    pressure: u32,
};

pub const VantageCarryState = struct {
    posture: Posture,
    active_tab: u32,
    font_size_pt: u32,
    viewport_width_px: u32,
    down_active: bool,
    down_x: i32,
    down_y: i32,
    stylus_ring: [max_stylus_points]StylusPoint,
    stylus_count: u32,

    pub fn init(
        shortest_width_dp: u32,
        viewport_width_px: u32,
    ) VantageCarryState {
        const vw = if (viewport_width_px == 0) 1600 else viewport_width_px;
        const p = select_posture(shortest_width_dp);
        // invariant: initial active_tab is 0 and font_size_pt in 12..32.
        const st = VantageCarryState{
            .posture = p,
            .active_tab = 0,
            .font_size_pt = 18,
            .viewport_width_px = vw,
            .down_active = false,
            .down_x = 0,
            .down_y = 0,
            .stylus_ring = std.mem.zeroes([max_stylus_points]StylusPoint),
            .stylus_count = 0,
        };
        assert(st.active_tab < tab_count);
        assert(st.font_size_pt >= min_font_pt and
            st.font_size_pt <= max_font_pt);
        return st;
    }

    pub fn select_posture(shortest_width_dp: u32) Posture {
        if (shortest_width_dp >= 960) return .station_desktop;
        if (shortest_width_dp >= 600) return .carry_tablet_split;
        return .carry_mobile_deck;
    }

    /// Reduces raw pointer/Wacom events directly into Vantage tab, zoom, & ink
    /// state! Returns `true` when accepted, `false` when palm-rejected.
    pub fn ingest_pointer(
        self: *VantageCarryState,
        kind: u32, // 0=down, 1=move, 2=up, 3=wacom_stylus
        x_px: i32,
        y_px: i32,
        radius_or_pressure: u32,
    ) bool {
        // invariant: active_tab always stays within 0..tab_count-1.
        assert(self.active_tab < tab_count and self.viewport_width_px >= 1);

        if (kind == 3) {
            // Wacom EMR stylus sample on Daylight DC-1
            const slot = self.stylus_count % max_stylus_points;
            self.stylus_ring[slot] = .{
                .x_px = x_px,
                .y_px = y_px,
                .pressure = radius_or_pressure,
            };
            self.stylus_count += 1;
            assert(slot < max_stylus_points);
            return true;
        }

        // Hardware palm rejection for finger contacts
        if (radius_or_pressure > max_finger_radius_px) {
            self.down_active = false;
            return false;
        }

        if (kind == 0) {
            self.down_active = true;
            self.down_x = x_px;
            self.down_y = y_px;
            return true;
        }

        if (kind == 2 and self.down_active) {
            self.down_active = false;
            const dx = x_px - self.down_x;
            const dy = y_px - self.down_y;
            const adx: u32 = @intCast(if (dx < 0) -dx else dx);
            const ady: u32 = @intCast(if (dy < 0) -dy else dy);

            // Tap in top 64px header bar selects tab directly
            if (adx <= tap_slop_px and ady <= tap_slop_px and
                y_px >= 0 and y_px < 64)
            {
                const ux: u32 = @intCast(x_px);
                const seg = self.viewport_width_px / tab_count;
                if (seg > 0) {
                    const idx = ux / seg;
                    self.active_tab = @min(idx, tab_count - 1);
                }
            } else if (dx <= -swipe_threshold_px) {
                // Swipe left advances to next Vantage tab
                self.active_tab = (self.active_tab + 1) % tab_count;
            } else if (dx >= swipe_threshold_px) {
                // Swipe right steps back to previous Vantage tab
                self.active_tab = (self.active_tab + tab_count - 1) % tab_count;
            }
            assert(self.active_tab < tab_count);
            return true;
        }
        return true;
    }

    pub fn apply_pinch_permille(self: *VantageCarryState, permille: u32) void {
        assert(self.font_size_pt >= min_font_pt);
        if (permille == 0) return;
        const scaled: u64 = (@as(u64, self.font_size_pt) *
            @as(u64, permille)) / 1000;
        const clamped: u32 = @intCast(
            @max(@as(u64, min_font_pt), @min(scaled, max_font_pt)),
        );
        self.font_size_pt = clamped;
        assert(self.font_size_pt >= min_font_pt and
            self.font_size_pt <= max_font_pt);
    }

    pub fn render_status_bar(self: *const VantageCarryState, out: []u8) u32 {
        assert(self.active_tab < tab_count);
        const mode_s = switch (self.posture) {
            .station_desktop => "Vantage Station",
            .carry_tablet_split => "Vantage Carry Tablet",
            .carry_mobile_deck => "Vantage Carry Mobile",
        };
        const tab_s = std.mem.span(tab_labels[self.active_tab]);
        const s = std.fmt.bufPrint(
            out,
            "[{s} | {s} | {d}pt | 60Hz RLCD]",
            .{ mode_s, tab_s, self.font_size_pt },
        ) catch return 0;
        assert(s.len <= out.len);
        return @intCast(s.len);
    }
};

// -- Static singleton state for C-ABI / Swift / WASM / Kotlin JNI shells ------
var global_carry: VantageCarryState = VantageCarryState.init(720, 1600);

export fn carry_init_ffi(shortest_width_dp: u32, viewport_width_px: u32) void {
    global_carry = VantageCarryState.init(shortest_width_dp, viewport_width_px);
}

export fn carry_posture_ffi() u32 {
    return @intFromEnum(global_carry.posture);
}

export fn carry_active_tab_ffi() u32 {
    return global_carry.active_tab;
}

export fn carry_tab_label_ffi(index: u32) [*:0]const u8 {
    if (index >= tab_count) return "";
    return tab_labels[index];
}

export fn carry_font_size_pt_ffi() u32 {
    return global_carry.font_size_pt;
}

export fn carry_stylus_count_ffi() u32 {
    return global_carry.stylus_count;
}

export fn carry_ingest_touch_ffi(
    kind: u32,
    x_px: i32,
    y_px: i32,
    radius_or_pressure: u32,
) bool {
    return global_carry.ingest_pointer(kind, x_px, y_px, radius_or_pressure);
}

export fn carry_pinch_zoom_ffi(permille: u32) void {
    global_carry.apply_pinch_permille(permille);
}

export fn carry_render_bar_ffi(out_ptr: [*]u8, out_cap: u32) u32 {
    if (out_cap == 0) return 0;
    return global_carry.render_status_bar(out_ptr[0..out_cap]);
}

fn run_selftest() !u8 {
    // 1. Daylight DC-1 (720dp shortest width, 1600px wide) selects Carry Tablet
    carry_init_ffi(720, 1600);
    if (carry_posture_ffi() != 1) return error.ExpectedTabletPosture;
    if (carry_active_tab_ffi() != 0) return error.ExpectedBloomDefault;

    // 2. Palm contact (`radius = 40 > 28`) is rejected by Vantage!
    if (carry_ingest_touch_ffi(0, 300, 300, 40)) return error.PalmAccepted;

    // 3. Swipe left advances Bloom (0) -> Dimeroll (1) inside Vantage!
    _ = carry_ingest_touch_ffi(0, 800, 400, 10);
    _ = carry_ingest_touch_ffi(2, 600, 402, 10);
    if (carry_active_tab_ffi() != 1) return error.SwipeLeftDidNotAdvanceTab;

    // 4. Pinch zoom (`1500` permille) scales 18pt -> 27pt bounded `[12..32]`
    carry_pinch_zoom_ffi(1500);
    if (carry_font_size_pt_ffi() != 27) return error.PinchFontWrong;

    // 5. Wacom stylus sample & status bar formatting
    _ = carry_ingest_touch_ffi(3, 512, 384, 2048);
    if (carry_stylus_count_ffi() != 1) return error.StylusMissed;

    var bar: [128]u8 = undefined;
    const bn = carry_render_bar_ffi(&bar, 128);
    if (std.mem.indexOf(u8, bar[0..bn], "Vantage Carry Tablet | Dimeroll") ==
        null)
    {
        return error.BadStatusBar;
    }

    // 6. Pocket Blazepod (420dp) selects Carry Mobile Deck (`2`)
    carry_init_ffi(420, 480);
    if (carry_posture_ffi() != 2) return error.ExpectedMobilePosture;

    if (builtin.os.tag != .freestanding) {
        std.debug.print(
            "GREEN: vantage/carry -- Vantage owns Carry app logic.{c}",
            .{nl},
        );
    }
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
