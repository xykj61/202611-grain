//! modules/pond/puddle/puddle_remote.rye -- TAME SSH/Mosh & `scp` Equivalent!
//!
//! Stamp: `20261115.133500` -- Unites `Pond` + `Puddle` + `Comlink` + `Kumara`
//! + `Vault` for native<->cloud remote server access & key/file transfer:
//!   1. **Kumara Key Admission (`enroll_kumara_pubkey`):** Ed25519 binary key
//!      enrollment replacing brittle `~/.ssh/authorized_keys` text parsing!
//!   2. **Mosh-Style Roaming Session (`step_roaming_turn`):** UDP state-sync
//!      envelope surviving laptop Wi-Fi -> cellular IP roaming via monotonic
//!      `epoch_seq` + Ed25519 signature (refusing replays & unauth keys!),
//!   3. **TAME Parcel Copy (`verify_puddle_parcel` -- `scp` equivalent):**
//!      Refuses `..` or absolute `/` path escapes outside the Puddle sandbox
//!      and verifies SHA3-256 + Ed25519 before committing bytes!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Ed25519 = std.crypto.sign.Ed25519;
const Sha3_256 = std.crypto.hash.sha3.Sha3_256;

pub const version = "20261115.133500";
pub const max_enrolled_keys: u32 = 16;
pub const max_parcel_bytes: u32 = 65536;
const nl: u8 = 10;

pub const PuddleError = error{
    KeyringFull,
    UnauthorizedKumaraKey,
    ReplayEpochRefused,
    InvalidSignature,
    PathTraversalRefused,
    ParcelExceedsCeiling,
    DigestMismatch,
};

pub const RoamingTurn = struct {
    epoch_seq: u64,
    client_ip_tag: u32, // may change freely on Wi-Fi <-> LTE handoff!
    state_diff: []const u8,
    pubkey: [32]u8,
    sig: [64]u8,
};

pub const PuddleHost = struct {
    allowed_keys: [max_enrolled_keys][32]u8,
    key_count: u32,
    high_water_seq: u64,
    last_client_ip: u32,

    pub fn init() PuddleHost {
        return std.mem.zeroes(PuddleHost);
    }

    /// TAME equivalent of `ssh-copy-id`: enrolls a 32-byte Kumara Ed25519 key!
    pub fn enroll_kumara_pubkey(
        self: *PuddleHost,
        pk: [32]u8,
    ) PuddleError!void {
        if (self.key_count >= max_enrolled_keys) return error.KeyringFull;
        self.allowed_keys[self.key_count] = pk;
        self.key_count += 1;
        assert(self.key_count <= max_enrolled_keys);
    }

    fn is_enrolled(self: *const PuddleHost, pk: [32]u8) bool {
        var i: u32 = 0;
        while (i < self.key_count) : (i += 1) {
            if (std.mem.eql(u8, &self.allowed_keys[i], &pk)) return true;
        }
        return false;
    }

    /// Mosh-style roaming turn: survives client IP changes seamlessly!
    pub fn step_roaming_turn(
        self: *PuddleHost,
        turn: RoamingTurn,
    ) PuddleError!void {
        if (!self.is_enrolled(turn.pubkey)) return error.UnauthorizedKumaraKey;
        if (turn.epoch_seq <= self.high_water_seq) {
            return error.ReplayEpochRefused;
        }
        const pk = Ed25519.PublicKey.fromBytes(turn.pubkey) catch {
            return error.InvalidSignature;
        };
        const sig = Ed25519.Signature.fromBytes(turn.sig);
        sig.verify(turn.state_diff, pk) catch return error.InvalidSignature;

        self.high_water_seq = turn.epoch_seq;
        self.last_client_ip = turn.client_ip_tag;
        // invariant: monotonic epoch advanced regardless of roaming IP change.
        assert(self.high_water_seq == turn.epoch_seq);
    }

    /// TAME equivalent of `scp`: enforces relative sandbox path + SHA3 + sig!
    pub fn receive_parcel(
        self: *const PuddleHost,
        rel_dest: []const u8,
        payload: []const u8,
        expected_sha3: [32]u8,
        pk_bytes: [32]u8,
        sig_bytes: [64]u8,
    ) PuddleError!void {
        if (!self.is_enrolled(pk_bytes)) return error.UnauthorizedKumaraKey;
        if (rel_dest.len == 0 or rel_dest[0] == '/' or
            std.mem.indexOf(u8, rel_dest, "..") != null)
        {
            return error.PathTraversalRefused;
        }
        if (payload.len > max_parcel_bytes) return error.ParcelExceedsCeiling;

        var got_sha3: [32]u8 = undefined;
        Sha3_256.hash(payload, &got_sha3, .{});
        if (!std.mem.eql(u8, &got_sha3, &expected_sha3)) {
            return error.DigestMismatch;
        }
        const pk = Ed25519.PublicKey.fromBytes(pk_bytes) catch {
            return error.InvalidSignature;
        };
        const sig = Ed25519.Signature.fromBytes(sig_bytes);
        sig.verify(&got_sha3, pk) catch return error.InvalidSignature;
        assert(rel_dest[0] != '/');
    }
};

fn run_selftest() !u8 {
    var host = PuddleHost.init();
    const seed: [32]u8 = @splat(0x42);
    const kp = try Ed25519.KeyPair.generateDeterministic(seed);
    try host.enroll_kumara_pubkey(kp.public_key.toBytes());

    // 1. Laptop starts on Wi-Fi `0xC0A8_0105`, roams to LTE `0x0A00_0099`!
    const diff1 = "cursor:row=12,col=4";
    const s1 = try kp.sign(diff1, null);
    try host.step_roaming_turn(.{
        .epoch_seq = 1,
        .client_ip_tag = 0xC0A8_0105,
        .state_diff = diff1,
        .pubkey = kp.public_key.toBytes(),
        .sig = s1.toBytes(),
    });
    const diff2 = "cursor:row=13,col=1";
    const s2 = try kp.sign(diff2, null);
    try host.step_roaming_turn(.{
        .epoch_seq = 2,
        .client_ip_tag = 0x0A00_0099, // Roamed IP!
        .state_diff = diff2,
        .pubkey = kp.public_key.toBytes(),
        .sig = s2.toBytes(),
    });
    if (host.last_client_ip != 0x0A00_0099) return error.RoamMissed;

    // 2. TAME `scp` parcel welcome + `../etc/passwd` traversal refusal!
    const data = "name 202611-cloud-deploy";
    var d_sha3: [32]u8 = undefined;
    Sha3_256.hash(data, &d_sha3, .{});
    const d_sig = try kp.sign(&d_sha3, null);
    try host.receive_parcel(
        "deploys/app.brix",
        data,
        d_sha3,
        kp.public_key.toBytes(),
        d_sig.toBytes(),
    );
    if (host.receive_parcel(
        "../outside.brix",
        data,
        d_sha3,
        kp.public_key.toBytes(),
        d_sig.toBytes(),
    )) |_| {
        return error.TraversalAccepted;
    } else |err| {
        if (err != error.PathTraversalRefused) return err;
    }

    print("GREEN: puddle_remote -- roaming Mosh & TAME scp proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
