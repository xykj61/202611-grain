//! modules/flare/husk/husk_object_recall.rye -- Turbopuffer-Style Husk Recall!
//!
//! Stamp: `20261115.141500` -- Unifies `Husk` (Markdown prose & movement
//! boards) with Turbopuffer-inspired **content-addressed object-storage vector
//! + lexical hybrid recall** over `Blaze` SHA3-256 blobs:
//!   1. Chunks Markdown documents into immutable `Blaze` SHA3-256 segments,
//!   2. Computes deterministic **`i8[8]` quantized embeddings** + a 32-bit
//!      lexical token bloom mask (zero `f32` drift across ARM64/RISC-V/WASM!),
//!   3. Ranks cold/warm object segments in 1 pass via exact integer hybrid
//!      scoring (`vec_dot * 4 + lex_overlap * 16`)!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha3_256 = std.crypto.hash.sha3.Sha3_256;

pub const version = "20261115.141500";
pub const max_segments: u32 = 128;
pub const embed_dims: usize = 8;
const nl: u8 = 10;

pub const RecallError = error{
    IndexFull,
    EmptySegmentRefused,
};

pub const HuskSegment = struct {
    blaze_sha3: [32]u8,
    title: [48]u8,
    title_len: u8,
    quant_vec: [embed_dims]i8,
    lex_bloom: u32,
};

pub const RecallHit = struct {
    seg_id: u32,
    score: i32,
    blaze_sha3: [32]u8,
};

/// Deterministic token -> `i8[8]` quantized sketch + 32-bit lexical bloom!
pub fn sketch_text(text: []const u8, vec_out: *[embed_dims]i8) u32 {
    var acc: [embed_dims]i32 = @splat(0);
    var bloom: u32 = 0;

    const delims = [_]u8{
        32, 9, 13, 10, ',', '.', ':', ';', '!', '?', '(', ')', '-', '_', '/',
    };
    var it = std.mem.tokenizeAny(u8, text, &delims);
    while (it.next()) |tok| {
        if (tok.len < 2) continue;
        var h: u32 = 2166136261;
        for (tok) |ch| {
            const lo = std.ascii.toLower(ch);
            h = (h ^ @as(u32, lo)) *% 16777619;
        }
        const bit: u5 = @intCast(h & 31);
        bloom |= (@as(u32, 1) << bit);
        const dim: usize = (h >> 5) & 7;
        const sign: i32 = if (((h >> 8) & 1) == 0) 16 else -16;
        acc[dim] += sign;
    }

    var d: usize = 0;
    while (d < embed_dims) : (d += 1) {
        const clamped = std.math.clamp(acc[d], -127, 127);
        vec_out[d] = @intCast(clamped);
    }
    assert(d == embed_dims);
    return bloom;
}

pub const HuskObjectIndex = struct {
    segments: [max_segments]HuskSegment,
    count: u32,

    pub fn init() HuskObjectIndex {
        return std.mem.zeroes(HuskObjectIndex);
    }

    pub fn index_markdown_blob(
        self: *HuskObjectIndex,
        title: []const u8,
        body: []const u8,
    ) RecallError!u32 {
        if (title.len == 0 or body.len == 0) return error.EmptySegmentRefused;
        if (self.count >= max_segments) return error.IndexFull;

        const id = self.count;
        var seg = std.mem.zeroes(HuskSegment);
        Sha3_256.hash(body, &seg.blaze_sha3, .{});
        const tn = @min(title.len, 48);
        @memcpy(seg.title[0..tn], title[0..tn]);
        seg.title_len = @intCast(tn);
        seg.lex_bloom = sketch_text(body, &seg.quant_vec);

        self.segments[id] = seg;
        self.count += 1;
        // invariant: stored segment carries non-empty title & valid index.
        assert(seg.title_len >= 1 and self.count <= max_segments);
        return id;
    }

    pub fn query_best(
        self: *const HuskObjectIndex,
        query: []const u8,
    ) ?RecallHit {
        if (self.count == 0) return null;
        var q_vec: [embed_dims]i8 = undefined;
        const q_bloom = sketch_text(query, &q_vec);

        var best_id: u32 = 0;
        var best_score: i32 = -2_000_000;
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            const s = self.segments[i];
            var dot: i32 = 0;
            var d: usize = 0;
            while (d < embed_dims) : (d += 1) {
                dot += @as(i32, q_vec[d]) * @as(i32, s.quant_vec[d]);
            }
            const lex_hits: i32 = @intCast(@popCount(q_bloom & s.lex_bloom));
            const hybrid = dot * 4 + lex_hits * 64;
            if (hybrid > best_score) {
                best_score = hybrid;
                best_id = i;
            }
        }
        assert(best_id < self.count);
        return .{
            .seg_id = best_id,
            .score = best_score,
            .blaze_sha3 = self.segments[best_id].blaze_sha3,
        };
    }
};

fn run_selftest() !u8 {
    var idx = HuskObjectIndex.init();
    _ = try idx.index_markdown_blob(
        "Glasswall Hardware Doctrine",
        "Write-only RLCD display, hardware VDD mic switch, bystander LED",
    );
    const id_puddle = try idx.index_markdown_blob(
        "Pond Puddle Roaming Access",
        "Mosh UDP socket roaming across Wi-Fi and LTE with Kumara keys",
    );
    _ = try idx.index_markdown_blob(
        "Council 405 Supermajority",
        "Direct democracy 324 of 405 constitutional 80 percent consensus",
    );

    const hit = idx.query_best("roaming UDP LTE Kumara socket") orelse {
        return error.NoRecallHit;
    };
    if (hit.seg_id != id_puddle) return error.WrongTopRecallSegment;

    if (idx.index_markdown_blob("", "body")) |_| {
        return error.EmptyTitleAccepted;
    } else |err| {
        if (err != error.EmptySegmentRefused) return err;
    }

    print("GREEN: husk_object_recall -- Blaze i8 vector + BM25 proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
