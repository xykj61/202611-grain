//! modules/flare/husk/husk_movement_stack.rye -- `grain-ww husk` Stack!
//!
//! Stamp: `20261115.135500` -- Powers `grain-ww husk [<checklist.md>]
//! [--prepend "<urgent movement>"]` over `active-husk/` checklists:
//!   - `[15, 75, 375, 1875, 9375] : [orbit, quest, journey, section, chapter]`,
//!   - `1 Orbit` strictly means **completion of 15 Movements**,
//!   - Adaptable **prepend-to-front** stack (`prepend_front` inserts urgent
//!     reds at index 0 with zero serial renumbering!).

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const version = "20261115.135500";
pub const orbit_movements: u32 = 15;
pub const quest_movements: u32 = 75;
pub const journey_movements: u32 = 375;
pub const section_movements: u32 = 1875;
pub const chapter_movements: u32 = 9375;
pub const max_stack_items: u32 = 128;
const nl: u8 = 10;
const cr: u8 = 13;

pub const StackError = error{
    StackFull,
    StackEmpty,
    EmptyTitleRefused,
};

pub const MovementCard = struct {
    title: [56]u8,
    title_len: u8,
    done: bool,
};

pub const CalfiveProgress = struct {
    completed_movements: u32,
    completed_orbits: u32,
    orbit_step: u32,
    quest_step: u32,
};

pub const HuskMovementStack = struct {
    cards: [max_stack_items]MovementCard,
    count: u32,
    completed_total: u32,

    pub fn init() HuskMovementStack {
        // invariant: x5 elemental ring ratios [15, 75, 375, 1875, 9375] hold.
        assert(orbit_movements * 5 == quest_movements);
        assert(section_movements * 5 == chapter_movements);
        return std.mem.zeroes(HuskMovementStack);
    }

    pub fn prepend_front(
        self: *HuskMovementStack,
        title: []const u8,
    ) StackError!void {
        if (title.len == 0) return error.EmptyTitleRefused;
        if (self.count >= max_stack_items) return error.StackFull;

        var i: u32 = self.count;
        while (i > 0) : (i -= 1) {
            self.cards[i] = self.cards[i - 1];
        }
        var c = std.mem.zeroes(MovementCard);
        const n = @min(title.len, 56);
        @memcpy(c.title[0..n], title[0..n]);
        c.title_len = @intCast(n);
        self.cards[0] = c;
        self.count += 1;
        assert(self.count <= max_stack_items and !self.cards[0].done);
    }

    pub fn complete_front(self: *HuskMovementStack) StackError!void {
        var idx: u32 = 0;
        while (idx < self.count and self.cards[idx].done) : (idx += 1) {}
        if (idx >= self.count) return error.StackEmpty;
        self.cards[idx].done = true;
        self.completed_total += 1;
        assert(self.completed_total >= 1);
    }

    pub fn progress(self: *const HuskMovementStack) CalfiveProgress {
        const m = self.completed_total;
        const p = CalfiveProgress{
            .completed_movements = m,
            .completed_orbits = m / orbit_movements,
            .orbit_step = m % orbit_movements,
            .quest_step = m % quest_movements,
        };
        assert(p.completed_orbits * orbit_movements + p.orbit_step == m);
        return p;
    }

    pub fn ingest_markdown(
        self: *HuskMovementStack,
        md: []const u8,
    ) StackError!void {
        var it = std.mem.splitScalar(u8, md, nl);
        while (it.next()) |raw| {
            const line = std.mem.trim(u8, raw, &[_]u8{ ' ', cr });
            if (std.mem.startsWith(u8, line, "- [ ] ")) {
                try self.prepend_front(line[6..]);
            } else if (std.mem.startsWith(u8, line, "- [x] ")) {
                try self.prepend_front(line[6..]);
                self.cards[0].done = true;
                self.completed_total += 1;
            }
        }
    }
};

fn run_selftest() !u8 {
    var st = HuskMovementStack.init();
    var k: u32 = 0;
    while (k < 14) : (k += 1) {
        try st.prepend_front("Planned craft step");
        try st.complete_front();
    }
    if (st.progress().completed_orbits != 0) return error.PrematureOrbit;

    try st.prepend_front("Urgent Standfast red fix");
    const top = st.cards[0].title[0..st.cards[0].title_len];
    if (!std.mem.startsWith(u8, top, "Urgent")) {
        return error.PrependNotAtFront;
    }
    try st.complete_front();
    if (st.progress().completed_orbits != 1 or st.progress().orbit_step != 0) {
        return error.Orbit15NotCompleted;
    }

    print("GREEN: husk_movement_stack -- [15..9375] & prepend proven.{c}", .{
        nl,
    });
    return 0;
}

const default_board =
    "active-husk/date/202611/00/" ++
    "20261119-171652-est_quest1-husk-breach-and-journey1-spine/" ++
    "CHECKLIST.md";

pub fn main(init: std.process.Init) !u8 {
    const a = init.arena.allocator();
    const io = init.io;
    const args = try init.minimal.args.toSlice(a);

    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }

    const path = if (args.len >= 2 and args[1][0] != '-')
        args[1]
    else
        default_board;

    const cwd = std.Io.Dir.cwd();
    const md = try cwd.readFileAlloc(io, path, a, .limited(131072));
    var st = HuskMovementStack.init();
    try st.ingest_markdown(md);

    var j: usize = 1;
    while (j + 1 < args.len) : (j += 1) {
        if (std.mem.eql(u8, args[j], "--prepend")) {
            try st.prepend_front(args[j + 1]);
            break;
        }
    }

    const p = st.progress();
    print(
        "Husk Stack [15 75 375 1875 9375] ({s}):{c}",
        .{ std.fs.path.basename(path), nl },
    );
    print(
        "  Movements done : {d} (orbits={d}, step={d}/15, quest={d}/75){c}",
        .{
            p.completed_movements,
            p.completed_orbits,
            p.orbit_step,
            p.quest_step,
            nl,
        },
    );
    var idx: u32 = 0;
    while (idx < st.count and st.cards[idx].done) : (idx += 1) {}
    if (idx < st.count) {
        const t = st.cards[idx].title[0..st.cards[idx].title_len];
        print("  Front of stack : {s}{c}", .{ t, nl });
    }
    return 0;
}
