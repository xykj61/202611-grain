//! modules/harness/harness_core.rye -- capability router & 3-tier review gate.
//!
//! Stamp: `20261119.182008` -- Core TAME Harness gate proving:
//!   1. Capability-bitmask tool routing + turn-budget ceiling (`max_turns`),
//!   2. OmniDiff-inspired 3-Tier semantic diff classification (Tier 0 cosmetic
//!      early-cutoff, Tier 1 bounded logic, Tier 2 custody/security gate),
//!   3. Superfan sentinel health check over Myofascia & boundary invariants.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha3_256 = std.crypto.hash.sha3.Sha3_256;

pub const version = "20261119.182008";
pub const max_turns: u32 = 32;
pub const max_subagents: u32 = 16;
const nl: u8 = 10;
const bs: u8 = 92;
const ws = [_]u8{ 32, 9, 13 };

pub const cap_pure_compute: u32 = 1 << 0;
pub const cap_skate_surface: u32 = 1 << 1;
pub const cap_resonance_audio: u32 = 1 << 2;
pub const cap_comlink_peer: u32 = 1 << 3;
pub const cap_vault_gemini_key: u32 = 1 << 4;

pub const HarnessError = error{
    TurnBudgetExceeded,
    CapabilityDenied,
    TooManySubagents,
};

pub const ReviewTier = enum {
    tier0_cosmetic_early_cutoff,
    tier1_bounded_logic,
    tier2_steward_custody_gate,
};

pub const AgentSession = struct {
    granted_caps: u32,
    turns_used: u32,
    turn_limit: u32,

    pub fn init(granted_caps: u32, turn_limit: u32) AgentSession {
        assert(turn_limit >= 1 and turn_limit <= max_turns);
        return .{
            .granted_caps = granted_caps,
            .turns_used = 0,
            .turn_limit = turn_limit,
        };
    }

    pub fn authorize_tool(
        self: *AgentSession,
        required_cap: u32,
    ) HarnessError!void {
        // invariant: turns_used never exceeds turn_limit prior to check.
        assert(self.turns_used <= self.turn_limit);
        if (self.turns_used >= self.turn_limit) {
            return error.TurnBudgetExceeded;
        }
        if ((self.granted_caps & required_cap) != required_cap) {
            return error.CapabilityDenied;
        }
        self.turns_used += 1;
        // invariant: turns_used stays bounded by turn_limit and max_turns.
        assert(self.turns_used <= self.turn_limit and
            self.turns_used <= max_turns);
    }
};

fn strip_comment(line: []const u8) []const u8 {
    var in_str = false;
    var i: usize = 0;
    while (i < line.len) : (i += 1) {
        const c = line[i];
        if (c == '"' and (i == 0 or line[i - 1] != bs)) {
            in_str = !in_str;
            continue;
        }
        if (!in_str) {
            if (c == '#') return line[0..i];
            if (i + 1 < line.len) {
                if (c == '/' and line[i + 1] == '/') return line[0..i];
                if (c == ':' and line[i + 1] == ':') return line[0..i];
            }
        }
    }
    return line;
}

fn semantic_hash(src: []const u8) [32]u8 {
    var h = Sha3_256.init(.{});
    var it = std.mem.splitScalar(u8, src, nl);
    while (it.next()) |raw| {
        const clean = std.mem.trim(u8, strip_comment(raw), &ws);
        if (clean.len == 0) continue;
        h.update(clean);
        h.update(&[_]u8{nl});
    }
    var out: [32]u8 = undefined;
    h.final(&out);
    return out;
}

fn is_custody_sensitive_path(path: []const u8) bool {
    const guarded = [_][]const u8{
        "template-manifest.kyri",
        "publish-seed.rish",
        "modules/crypto/",
        "modules/pond/",
        "modules/caravan/custody/",
        "modules/kumara/vault/",
    };
    for (guarded) |g| {
        if (std.mem.startsWith(u8, path, g) or std.mem.eql(u8, path, g)) {
            return true;
        }
    }
    return false;
}

/// Classifies an edit `(path, before_src, after_src, frame_budget_increased)`
/// into Tier 0 (early-cutoff), Tier 1 (bounded), or Tier 2 (steward gate).
pub fn classify_edit(
    path: []const u8,
    before_src: []const u8,
    after_src: []const u8,
    frame_budget_increased: bool,
) ReviewTier {
    assert(path.len >= 1);
    if (is_custody_sensitive_path(path) or frame_budget_increased) {
        return .tier2_steward_custody_gate;
    }
    const h_before = semantic_hash(before_src);
    const h_after = semantic_hash(after_src);
    if (std.mem.eql(u8, &h_before, &h_after)) {
        return .tier0_cosmetic_early_cutoff;
    }
    return .tier1_bounded_logic;
}

pub const SuperfanVerdict = struct {
    healthy: bool,
    myofascia_milli: u32,
};

pub fn evaluate_superfan_watch(
    myofascia_milli: u32,
    floor_milli: u32,
    dangling_symlinks: u32,
    gate_failures: u32,
) SuperfanVerdict {
    assert(myofascia_milli <= 100000 and floor_milli <= 100000);
    const ok = (myofascia_milli >= floor_milli) and
        (dangling_symlinks == 0) and
        (gate_failures == 0);
    return .{ .healthy = ok, .myofascia_milli = myofascia_milli };
}

fn run_selftest() !u8 {
    // 1. Capability routing & turn budget refusal
    var sess = AgentSession.init(cap_pure_compute | cap_skate_surface, 2);
    try sess.authorize_tool(cap_skate_surface);
    if (sess.authorize_tool(cap_vault_gemini_key)) |_| {
        return error.UnauthorizedCapAccepted;
    } else |err| {
        if (err != error.CapabilityDenied) return err;
    }
    try sess.authorize_tool(cap_pure_compute);
    if (sess.authorize_tool(cap_pure_compute)) |_| {
        return error.OverBudgetTurnAccepted;
    } else |err| {
        if (err != error.TurnBudgetExceeded) return err;
    }

    // 2. 3-Tier OmniDiff semantic review gate
    var b1: [64]u8 = undefined;
    var b2: [96]u8 = undefined;
    const s1 = try std.fmt.bufPrint(
        &b1,
        "// old note{c}const x: u32 = 7;{c}",
        .{ nl, nl },
    );
    const s2 = try std.fmt.bufPrint(
        &b2,
        "// clearer Radiant comment{c}const x: u32 = 7;{c}",
        .{ nl, nl },
    );
    if (classify_edit("modules/apps/bloom/demo.rye", s1, s2, false) !=
        .tier0_cosmetic_early_cutoff)
    {
        return error.Tier0Missed;
    }
    if (classify_edit(
        "modules/apps/bloom/demo.rye",
        s1,
        "const x: u32 = 8;",
        false,
    ) != .tier1_bounded_logic) {
        return error.Tier1Missed;
    }
    if (classify_edit("modules/crypto/sha3.rye", s1, s2, false) !=
        .tier2_steward_custody_gate)
    {
        return error.Tier2CustodyMissed;
    }

    // 3. Superfan sentinel check
    const sf_ok = evaluate_superfan_watch(56544, 56500, 0, 0);
    if (!sf_ok.healthy) return error.SuperfanFalseAlarm;
    const sf_bad = evaluate_superfan_watch(56544, 56500, 1, 0);
    if (sf_bad.healthy) return error.SuperfanMissedDanglingLink;

    print("GREEN: harness_core -- caps, 3-tier gate, & superfan proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
