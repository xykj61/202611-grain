//! modules/fusion/gate_runner.rye -- declarative `.kyri` invariant evaluator.
//!
//! Orbit 7 of `20261115-053000` (`20261115.062500`).
//! Evaluates `max_cols`, `ascii_7bit`, and `must_contain` rules declared in
//! `modules/fusion/gates.kyri` in one fast in-memory Rye pass (< 5 ms),
//! replacing dozens of single-purpose shell `grep`/`awk` scripts.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const version = "20261115.062500";
const nl: u8 = 10;
const tab: u8 = 9;
const cr: u8 = 13;
const ws = [_]u8{ 32, 9, 13 };

pub const GateError = error{
    LineTooLong,
    NonAsciiByte,
    MissingRequiredSubstring,
    MalformedRule,
};

pub fn check_max_cols(bytes: []const u8, limit: u32) GateError!void {
    // invariant: column limit is positive and reasonable.
    assert(limit >= 1 and limit <= 4096);
    var it = std.mem.splitScalar(u8, bytes, nl);
    var line_no: u32 = 0;
    while (it.next()) |raw| {
        line_no += 1;
        const clean = std.mem.trimEnd(u8, raw, &[_]u8{cr});
        if (clean.len > limit) return error.LineTooLong;
    }
    // invariant: splitScalar yields at least 1 slice.
    assert(line_no >= 1);
}

pub fn check_ascii_7bit(bytes: []const u8) GateError!void {
    var i: usize = 0;
    while (i < bytes.len) : (i += 1) {
        const b = bytes[i];
        const ok = (b >= 32 and b <= 126) or b == nl or b == tab or b == cr;
        if (!ok) return error.NonAsciiByte;
    }
    // invariant: full slice scanned without early exit.
    assert(i == bytes.len);
}

pub fn check_must_contain(bytes: []const u8, needle: []const u8) GateError!void {
    // invariant: non-empty needle required.
    assert(needle.len >= 1);
    if (std.mem.indexOf(u8, bytes, needle) == null) {
        return error.MissingRequiredSubstring;
    }
}

fn run_selftest() !u8 {
    try check_max_cols("short line", 80);
    if (check_max_cols("123456", 5)) |_| {
        return error.OverlongAccepted;
    } else |err| {
        if (err != error.LineTooLong) return err;
    }

    try check_ascii_7bit("plain 7-bit ASCII");
    if (check_ascii_7bit(&[_]u8{ 'a', 0xC3, 0xA9 })) |_| {
        return error.NonAsciiAccepted;
    } else |err| {
        if (err != error.NonAsciiByte) return err;
    }

    try check_must_contain("Myofascia 56.529", "Myofascia");
    if (check_must_contain("plain text", "missing")) |_| {
        return error.MissingNeedleAccepted;
    } else |err| {
        if (err != error.MissingRequiredSubstring) return err;
    }
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = try run_selftest();
    const a = init.arena.allocator();
    const io = init.io;
    const cwd = std.Io.Dir.cwd();
    const args = try init.minimal.args.toSlice(a);

    const gates_path = if (args.len >= 2)
        args[1]
    else
        "modules/fusion/gates.kyri";

    const spec = try cwd.readFileAlloc(io, gates_path, a, .limited(1024 * 1024));
    var rules_checked: u32 = 0;
    var it = std.mem.splitScalar(u8, spec, nl);
    while (it.next()) |raw| {
        const line = std.mem.trim(u8, raw, &ws);
        if (line.len == 0 or line[0] == '#') continue;
        if (std.mem.startsWith(u8, line, "format ") or
            std.mem.startsWith(u8, line, "stamp ") or
            std.mem.startsWith(u8, line, "voice ") or
            std.mem.startsWith(u8, line, "status "))
        {
            continue;
        }
        var tok = std.mem.tokenizeAny(u8, line, &[_]u8{ 32, tab });
        const verb = tok.next() orelse continue;
        const max_f = 8 * 1024 * 1024;
        if (std.mem.eql(u8, verb, "max_cols")) {
            const lim_s = tok.next() orelse return error.MalformedRule;
            const path = tok.rest();
            const lim = try std.fmt.parseInt(u32, lim_s, 10);
            const b = try cwd.readFileAlloc(io, path, a, .limited(max_f));
            check_max_cols(b, lim) catch {
                print("FAIL max_cols {d} on {s}{c}", .{ lim, path, nl });
                return 1;
            };
            rules_checked += 1;
        } else if (std.mem.eql(u8, verb, "ascii_7bit")) {
            const path = std.mem.trim(u8, tok.rest(), &ws);
            const b = try cwd.readFileAlloc(io, path, a, .limited(max_f));
            check_ascii_7bit(b) catch {
                print("FAIL ascii_7bit on {s}{c}", .{ path, nl });
                return 1;
            };
            rules_checked += 1;
        } else if (std.mem.eql(u8, verb, "must_contain")) {
            const path = tok.next() orelse return error.MalformedRule;
            const needle = std.mem.trim(u8, tok.rest(), &ws);
            const b = try cwd.readFileAlloc(io, path, a, .limited(max_f));
            check_must_contain(b, needle) catch {
                print("FAIL must_contain '{s}' in {s}{c}", .{
                    needle,
                    path,
                    nl,
                });
                return 1;
            };
            rules_checked += 1;
        }
    }
    assert(rules_checked >= 10);
    print("GREEN: gate_runner -- {d} declarative invariants held.{c}", .{
        rules_checked,
        nl,
    });
    return 0;
}
