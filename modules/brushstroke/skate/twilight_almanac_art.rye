//! modules/brushstroke/skate/twilight_almanac_art.rye -- Twilight Almanac!
//!
//! Stamp: `20261119.134045` -- `Movement 12/15 : Pisces` (*Twilight Radiant
//! Silo art: gratitude-born artifact*), powering `grain-ww twilight-art`!
//! Distills gratitude for quiet soil stewardship, tensegrity balance, live
//! visual craft, living watersheds, and the 15-sign *Sandhya / Shafaq* dusk
//! sky into one deterministic Glasswall RLCD/RGB24 almanac card (`max_cmds=96`,
//! SHA3-256 frame seal, zero telemetry, paired welcome + refusal witnesses).

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha3_256 = std.crypto.hash.sha3.Sha3_256;

pub const version = "20261119.134045";
pub const max_cmds: u32 = 96;

// Grain Dusk Palette: Deep Indigo, Sandhya Saffron, Oat, Emerald, Violet
pub const color_indigo: u32 = 0x1A237E;
pub const color_saffron: u32 = 0xE65100;
pub const color_oat: u32 = 0xF5F3EE;
pub const color_emerald: u32 = 0x1B5E20;
pub const color_violet: u32 = 0x6A1B9A;
pub const color_ink: u32 = 0x0A0A0A;
const nl: u8 = 10;

pub const AlmanacError = error{
    SignOutOfRange,
    ViewportTooSmall,
    CmdLimitExceeded,
};

pub const DuskEntry = struct {
    sign_num: u8,
    sign_name: []const u8,
    shastra_risala: []const u8,
    dusk_line: []const u8,
    canopy_stories: u8,
    dew_cool_deci_c: u8,
};

