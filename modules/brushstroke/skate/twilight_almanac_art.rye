pub const AlmanacTile = struct {
    x: u16,
    y: u16,
    w: u16,
    h: u16,
    rgb24: u32,
};

pub const TwilightCard = struct {
    entry: DuskEntry,
    tiles: [max_cmds]AlmanacTile,
    count: u32,
    tensegrity_balance: u32,
    card_sha3: [32]u8,
};

fn push_tile(c: *TwilightCard, t: AlmanacTile) AlmanacError!void {
    // invariant: tile count remains strictly bounded by max_cmds.
    assert(c.count <= max_cmds);
    if (c.count >= max_cmds) return error.CmdLimitExceeded;
    c.tiles[c.count] = t;
    c.count += 1;
    // invariant: tile insertion advances monotonically within bounds.
    assert(c.count >= 1 and c.count <= max_cmds);
}

pub fn compose_twilight_card(
    sign_1_to_15: u8,
    width_px: u16,
    height_px: u16,
) AlmanacError!TwilightCard {
    // invariant: validate Calfive sign 1..15 and legible viewport floor.
    if (sign_1_to_15 < 1 or sign_1_to_15 > 15) return error.SignOutOfRange;
    if (width_px < 120 or height_px < 60) return error.ViewportTooSmall;

    const entry = dusk_wheel[sign_1_to_15 - 1];
    var card = TwilightCard{
        .entry = entry,
        .tiles = undefined,
        .count = 0,
        .tensegrity_balance = @as(u32, entry.canopy_stories) * 25 +
            @as(u32, entry.dew_cool_deci_c),
        .card_sha3 = std.mem.zeroes([32]u8),
    };

    const sky_h: u16 = height_px / 2;
    const band_h: u16 = @max(@as(u16, 6), height_px / 10);

    // 1. Dusk Indigo upper vault + Sandhya Saffron glow + Vegan Oat ground
    try push_tile(&card, .{
        .x = 0,
        .y = 0,
        .w = width_px,
        .h = sky_h,
        .rgb24 = color_indigo,
    });
    try push_tile(&card, .{
        .x = 0,
        .y = sky_h -| band_h,
        .w = width_px,
        .h = band_h,
        .rgb24 = color_saffron,
    });
    try push_tile(&card, .{
        .x = 0,
        .y = sky_h,
        .w = width_px,
        .h = height_px -| sky_h,
        .rgb24 = color_oat,
    });

    // 2. Layered canopy silhouette + tensegrity strut accent
    var i: u8 = 0;
    while (i < entry.canopy_stories) : (i += 1) {
        const inset: u16 = @as(u16, i) * 8;
        try push_tile(&card, .{
            .x = inset,
            .y = sky_h -| (@as(u16, i + 1) * 6),
            .w = width_px -| (inset * 2),
            .h = 5,
            .rgb24 = color_emerald,
        });
    }
    try push_tile(&card, .{
        .x = 8,
        .y = height_px -| 14,
        .w = width_px -| 16,
        .h = 6,
        .rgb24 = color_violet,
    });

    // 3. Glasswall SHA3-256 deterministic card seal
    var h = Sha3_256.init(.{});
    h.update("grain-twilight-almanac-v1:");
    h.update(&[_]u8{ entry.sign_num, entry.canopy_stories });
    h.update(entry.sign_name);
    h.update(entry.dusk_line);
    h.final(&card.card_sha3);

    // invariant: emitted card has >= 5 tiles and non-zero tensegrity score.
    assert(card.count >= 5 and card.tensegrity_balance > 0);
    return card;
}

fn print_card(c: *const TwilightCard) void {
    print("+----------------------------------------------------------+{c}", .{
        nl,
    });
    print("| GRAIN TWILIGHT ALMANAC -- Sign {d}/15: {s}{c}", .{
        c.entry.sign_num,
        c.entry.sign_name,
        nl,
    });
    print("| Sky   : {s}{c}", .{ c.entry.shastra_risala, nl });
    print("| Craft : {s}{c}", .{ c.entry.dusk_line, nl });
    print("| Canopy: {d} stories | Dew cool: {d}.{d} C | Tiles: {d}{c}", .{
        c.entry.canopy_stories,
        c.entry.dew_cool_deci_c / 10,
        c.entry.dew_cool_deci_c % 10,
        c.count,
        nl,
    });
    print("+----------------------------------------------------------+{c}", .{
        nl,
    });
}

fn run_selftest(show_sign: ?u8) !u8 {
    // Welcome: compose all 15 signs deterministically
    var s: u8 = 1;
    while (s <= 15) : (s += 1) {
        const c1 = try compose_twilight_card(s, 320, 180);
        const c2 = try compose_twilight_card(s, 320, 180);
        if (!std.mem.eql(u8, &c1.card_sha3, &c2.card_sha3)) {
            return error.NonDeterministicCard;
        }
    }

    // Refusal 1: sign 0 and sign 16 rejected cleanly
    if (compose_twilight_card(0, 320, 180)) |_| {
        return error.ZeroSignAccepted;
    } else |err| {
        if (err != error.SignOutOfRange) return err;
    }
    if (compose_twilight_card(16, 320, 180)) |_| {
        return error.HighSignAccepted;
    } else |err| {
        if (err != error.SignOutOfRange) return err;
    }

    // Refusal 2: sub-floor viewport rejected cleanly
    if (compose_twilight_card(12, 80, 40)) |_| {
        return error.SmallViewportAccepted;
    } else |err| {
        if (err != error.ViewportTooSmall) return err;
    }

    if (show_sign) |sn| {
        const card = try compose_twilight_card(sn, 320, 180);
        print_card(&card);
    }

    print(
        "GREEN: twilight_almanac_art -- 15/15 dusk cards & Glasswall seal.{c}",
        .{nl},
    );
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const args = try init.minimal.args.toSlice(init.arena.allocator());
    if (args.len >= 2) {
        const parsed = std.fmt.parseInt(u8, args[1], 10) catch 12;
        return run_selftest(parsed);
    }
    return run_selftest(null);
}
