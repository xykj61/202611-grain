//! modules/brushstroke/skate/realidream_compose.rye -- Realidream Glasswall!
//!
//! Orbits 96-98 (`20261115.095500`): Pure TAME immediate-mode `Realidream`
//! surface composer uniting:
//!   - `Blaze` content-addressed weave head digest (`[32]u8`),
//!   - `VantageCarry` posture (`0=station`, `1=tablet_dc1`, `2=mobile_deck`)
//!     and active tab (`0..5`),
//!   - Bounded monochrome 60Hz RLCD `DrawCmd` list (`max_cmds = 128`, vegan
//!     Oat `#F5F3EE` / Ink `#0A0A0A` / Purple `#4A148C` / Red `#D32F2F`),
//!   - `Glasswall` write-only display invariant: deterministic SHA3 frame seal
//!     with zero external ad/script/telemetry hooks!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha3_256 = std.crypto.hash.sha3.Sha3_256;

pub const version = "20261115.095500";
pub const max_cmds: u32 = 128;
pub const color_oat: u32 = 0xF5F3EE;
pub const color_ink: u32 = 0x0A0A0A;
pub const color_purple: u32 = 0x4A148C;
pub const color_red: u32 = 0xD32F2F;
const nl: u8 = 10;

pub const ComposeError = error{
    CmdLimitExceeded,
    ZeroViewport,
    BadTabIndex,
};

pub const DrawKind = enum(u8) {
    clear_oat_ground = 1,
    header_bar = 2,
    split_divider = 3,
    thumb_card = 4,
    weave_badge = 5,
};

pub const DrawCmd = struct {
    kind: DrawKind,
    x: u16,
    y: u16,
    w: u16,
    h: u16,
    rgb24: u32,
};

pub const RealidreamFrame = struct {
    cmds: [max_cmds]DrawCmd,
    count: u32,
    frame_sha3: [32]u8,
};

pub fn compose_surface(
    posture: u32, // 0=station, 1=tablet_dc1, 2=mobile_deck
    active_tab: u32,
    width_px: u16,
    height_px: u16,
    weave_nib: [32]u8,
) ComposeError!RealidreamFrame {
    if (width_px == 0 or height_px == 0) return error.ZeroViewport;
    if (active_tab >= 6) return error.BadTabIndex;

    var f = RealidreamFrame{
        .cmds = undefined,
        .count = 0,
        .frame_sha3 = std.mem.zeroes([32]u8),
    };

    // 1. Vegan Oat ground fill
    try push_cmd(&f, .{
        .kind = .clear_oat_ground,
        .x = 0,
        .y = 0,
        .w = width_px,
        .h = height_px,
        .rgb24 = color_oat,
    });

    // 2. Royal Material Purple top status/tab strip
    try push_cmd(&f, .{
        .kind = .header_bar,
        .x = 0,
        .y = 0,
        .w = width_px,
        .h = 64,
        .rgb24 = color_purple,
    });

    // 3. Posture-adaptive body (Daylight DC-1 split pane vs Mobile thumb deck)
    if (posture <= 1) {
        try push_cmd(&f, .{
            .kind = .split_divider,
            .x = width_px / 3,
            .y = 64,
            .w = 2,
            .h = height_px -| 64,
            .rgb24 = color_ink,
        });
    } else {
        try push_cmd(&f, .{
            .kind = .thumb_card,
            .x = 12,
            .y = height_px / 2,
            .w = width_px -| 24,
            .h = (height_px / 2) -| 12,
            .rgb24 = color_ink,
        });
    }

    // 4. Material Red weave verification badge anchored in top-right corner
    try push_cmd(&f, .{
        .kind = .weave_badge,
        .x = width_px -| 48,
        .y = 16,
        .w = 32,
        .h = 32,
        .rgb24 = color_red,
    });

    var h = Sha3_256.init(.{});
    h.update("realidream-glasswall-v1:");
    h.update(&weave_nib);
    var b4: [4]u8 = undefined;
    std.mem.writeInt(u32, &b4, active_tab, .little);
    h.update(&b4);
    std.mem.writeInt(u32, &b4, f.count, .little);
    h.update(&b4);
    h.final(&f.frame_sha3);

    // invariant: non-empty bounded DrawCmd list sealed with 32-byte SHA3.
    assert(f.count >= 4 and f.count <= max_cmds);
    return f;
}

fn push_cmd(f: *RealidreamFrame, cmd: DrawCmd) ComposeError!void {
    if (f.count >= max_cmds) return error.CmdLimitExceeded;
    f.cmds[f.count] = cmd;
    f.count += 1;
    assert(f.count <= max_cmds);
}

fn run_selftest() !u8 {
    const nib: [32]u8 = @splat(0xAB);
    // 1. Cold replay determinism on Daylight DC-1 (1600x1200, posture=1)
    const f1 = try compose_surface(1, 0, 1600, 1200, nib);
    const f2 = try compose_surface(1, 0, 1600, 1200, nib);
    if (!std.mem.eql(u8, &f1.frame_sha3, &f2.frame_sha3)) {
        return error.ReplayNonDeterministic;
    }
    if (f1.cmds[2].kind != .split_divider) return error.ExpectedSplitDivider;

    // 2. Pocket Blazepod Carry Mobile posture (posture=2) emits thumb_card!
    const fm = try compose_surface(2, 0, 480, 800, nib);
    if (fm.cmds[2].kind != .thumb_card) return error.ExpectedThumbCard;

    // 3. Zero-viewport & invalid-tab refusals
    if (compose_surface(1, 0, 0, 1200, nib)) |_| {
        return error.ZeroWidthAccepted;
    } else |err| {
        if (err != error.ZeroViewport) return err;
    }

    print("GREEN: realidream_compose -- Oat/Purple/Red RLCD proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
