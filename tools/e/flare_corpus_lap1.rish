# tools/e/flare_corpus_lap1.rish -- shim -> tools/gen/flare/flare_corpus_lap1.rish (born Oven Chapter o1)
if length args == 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/flare/flare_corpus_lap1.rish"]
if length args != 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/flare/flare_corpus_lap1.rish" args[0]]
if r.out != "" then say r.out
exit r.code
