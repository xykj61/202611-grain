# blaze_snapshot_replay.rish -- I2 snapshot export and catalog replay on host - 20260713.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/blaze_snapshot_replay.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "blaze/bin/snapshot-export"

let build = run ["sh" "-c" "mkdir -p blaze/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh blaze/snapshot_export.rye -femit-bin=${bin}"]
assert build.ok else "snapshot export build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "snapshot export selftest exited non-zero"
assert selftest.out contains "GREEN" else "snapshot export selftest not GREEN"

say "GREEN: I2 snapshot replay witness passed (export → import → equal recall)."
