# blaze_recall_tablecloth_query.rish -- Tablecloth query witness (in-process).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/blaze_recall_tablecloth_query.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "blaze/bin/recall-tablecloth-query"

let build = run ["sh" "-c" "mkdir -p blaze/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh blaze/recall_tablecloth_query.rye -femit-bin=${bin}"]
assert build.ok else "recall_tablecloth_query build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "recall_tablecloth_query selftest exited non-zero"
assert selftest.out contains "GREEN" else "recall_tablecloth_query selftest not GREEN"

say "GREEN: Tablecloth query witness passed (optional fields, every match)."
