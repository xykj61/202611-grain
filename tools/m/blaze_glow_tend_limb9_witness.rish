# tools/m/blaze_glow_tend_limb9_witness.rish -- Blaze M9 in src/shape/.
#
#   rishi/bin/rishi run tools/m/blaze_glow_tend_limb9_witness.rish

say "blaze-tend-9: Language EN -- Blaze Glow Tend limb 9 (sur museum)."
say "blaze-tend-9: Style Radiant -- Dimeroll's own intake, seven fields."
say "blaze-tend-9: Lens TAME -- Ashvini nest-only - Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/shape/shape-dimeroll-intake-field-count.glow"
let elder = "blaze/src/dimeroll_receipt_offer.rye"

say "blaze-tend-9: placard..."
let placard = run ["sh" "-c" "head -n 10 src/shape/shape-dimeroll-intake-field-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "blaze-tend-9: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "blaze-tend-9: placard missing six lines"

let pex = run ["sh" "-c" "grep -q 'example    7' src/shape/shape-dimeroll-intake-field-count.glow"]
assert pex.ok else "blaze-tend-9: example 7 missing"
let pelder = run ["sh" "-c" "grep -q 'blaze/src/dimeroll_receipt_offer.rye' src/shape/shape-dimeroll-intake-field-count.glow"]
assert pelder.ok else "blaze-tend-9: citation missing"

# The claim is the placard's own, read against the rye rather than copied a second time here --
# the same discipline the limb5, limb7, and limb8 witnesses already carry: a guard holding its
# own copy of a number can only ever agree with itself.
say "blaze-tend-9: the placard's own number, read against DimerollReceiptIntake..."
let declared = run ["sh" "-c" "grep -E '^::  example' src/shape/shape-dimeroll-intake-field-count.glow | sed -E 's/^.*example[[:space:]]+//'"]
assert declared.ok else "blaze-tend-9: the placard's example line is unreadable"
let want = trim declared.out
let counted = run ["sh" "tools/fixtures/r/rye_struct_fields_scan.sh" "--count" elder "DimerollReceiptIntake"]
assert counted.ok else "blaze-tend-9: the field reader refused on DimerollReceiptIntake -- ${counted.out_brief}"
let got = trim counted.out
assert got == want else "blaze-tend-9: DimerollReceiptIntake declares ${got} fields where the placard says ${want}"
let named = run ["sh" "tools/fixtures/r/rye_struct_fields_scan.sh" "--fields" elder "DimerollReceiptIntake"]
assert named.ok else "blaze-tend-9: the field reader refused on DimerollReceiptIntake fields -- ${named.out_brief}"
let gotfields = trim named.out
assert gotfields == "receipt_id source_fact evidence_status offered_value value_unit recognition_status journal_entry_count" else "blaze-tend-9: DimerollReceiptIntake fields missing or reordered in the rye -- ${gotfields}"

# The struct's own comptime proof, read rather than trusted by name -- intake_fields is the
# number from_snapshot's comptime assert ties to @typeInfo(DimerollReceiptIntake).fields.len, so
# a field added without updating it fails the Rye build before this placard could ever drift.
say "blaze-tend-9: the module's own stated field count agrees..."
let stated = run ["sh" "-c" "grep -q 'pub const intake_fields = 7;' blaze/src/dimeroll_receipt_offer.rye"]
assert stated.ok else "blaze-tend-9: intake_fields moved off 7 in the rye"

say "blaze-tend-9: lower and run the desk..."
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "blaze-tend-9: dimeroll intake shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "blaze-tend-9: dimeroll intake shape did not exit 0"

say "blaze-tend-9: max_fields untouched..."
let ceiling = run ["sh" "-c" "grep -q 'max_fields: u32 = 15' glow/rune_shape.rye"]
assert ceiling.ok else "blaze-tend-9: rune_shape.max_fields moved off 15 -- this fruit must not raise it"

say "GREEN: blaze Glow Tend limb 9 -- Dimeroll's own intake, seven fields, in src/shape/."
