# tools/g/glow_rune_book_witness.rish -- Glow Mill Orbit 1 SLC witness.
#
# Proves that `languages/glow/front/rune_book.rye`, `languages/glow/tokens.rye`,
# `tools/fixtures/g/glow_digraph_table.txt`, and `docs-geode/api/glow-runes.md`
# agree at 30/30 live heads with zero drift, and that planting an undocumented
# 31st head in a temporary pen refuses by name (`DigraphDrift`).

let zig = "vendor/zig-toolchain/zig"
let build_rb = run ["sh" "-c" "mkdir -p tools/.build && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh languages/glow/front/rune_book.rye -femit-bin=tools/.build/glow_rune_book"]
assert build_rb.ok else "glow_rune_book build failed"

let build_tc = run ["sh" "-c" "mkdir -p tools/.build && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh languages/glow/digraph_twin_check.rye -femit-bin=tools/.build/glow_digraph_twin_check"]
assert build_tc.ok else "glow_digraph_twin_check build failed"

# 1. Internal positive + negative invariants
let st = run ["tools/.build/glow_rune_book"]
assert st.ok else "rune_book selftest failed"
assert (st.err contains "GREEN: rune_book") else "rune_book selftest missing GREEN"

# 2. Lexer twin check (tokens.rye reads rune_book.rye)
let tc = run ["tools/.build/glow_digraph_twin_check"]
assert tc.ok else "digraph_twin_check failed"
assert (tc.err contains "OK digraph_twin_check 48") else "digraph_twin_check did not report 48"

# 3. Live 3-way agreement: rune_book.rye == glow_digraph_table.txt == glow-runes.md
let chk = run ["tools/.build/glow_rune_book" "check" "tools/fixtures/g/glow_digraph_table.txt" "docs-geode/api/glow-runes.md"]
assert chk.ok else "3-way rune_book check failed"
assert (chk.err contains "GREEN: rune_book check") else "3-way check missing GREEN"

# 4. Negative refusal: planting an undocumented 49th head in a temp pen must red by name
let neg = run ["sh" "-c" "pen=tools/.build/rune_drift_pen.txt; cp tools/fixtures/g/glow_digraph_table.txt $pen; echo '/?' >> $pen; tools/.build/glow_rune_book check $pen docs-geode/api/glow-runes.md; rc=$?; rm -f $pen; exit $rc"]
assert neg.code != 0 else "undocumented 49th head was wrongly accepted"
assert (neg.err contains "DigraphDrift") else "negative refusal did not name DigraphDrift"

say "GREEN: glow_rune_book_witness -- 48/48 live runes, 13 families, and docs-geode/api/glow-runes.md verified zero-drift."
