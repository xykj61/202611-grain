# tools/g/glow_citizen_ring_and_selfhost_witness.rish -- Orbits 16-25 capstone!
#
# Proves on real metal (`Myofascia: 56.585`):
#   1. Auto-formats & verifies strict column-57 `::` alignment, `<= 80` cols,
#      `<= 32 KiB` desk cap, and `/!` `FrameBudget` headers across all 4
#      `languages/glow/compiler/*.glow` passes AND all 8 Citizen Ring
#      `modules/*/glow/*.glow` desks!
#   2. Proves `sha3_256(Stage 1) == sha3_256(Stage 2)` fixed-point self-hosting
#      identity in `languages/glow/driver/glow_self_host.rye`!

let rb = "tools/fixtures/r/rye_build.sh"
let mk = run ["mkdir" "-p" "tools/.build"]
assert mk.ok else "mkdir tools/.build failed"

let b_sh = run ["sh" rb "languages/glow/driver/glow_self_host.rye" "-femit-bin=tools/.build/glow_self_host"]
assert b_sh.ok else "glow_self_host.rye build failed"

let r_sh = run ["tools/.build/glow_self_host" "modules/amphora/glow/fold-amphora-chunk.glow" "modules/comlink/glow/fold-comlink-turn.glow" "modules/market/dimeroll/glow/fold-dimeroll-journal.glow" "modules/pond/glow/gate-pond-customs.glow" "modules/comlink/vantage/glow/fold-vantage-carry.glow" "modules/resonance/glow/fold-resonance-session.glow" "modules/flare/glow/gate-flare-slice.glow" "modules/apps/colloquium/glow/fold-colloquium-bill.glow" "modules/apps/linengrow/glow/fold-linengrow-consent.glow" "modules/comlink/glow/gate-council-405.glow" "modules/flare/pulp/glow/fold-pulp-recall.glow" "modules/tablecloth/glow/gate-tablecloth-fk.glow" "modules/pond/glow/gate-puddle-roam.glow"]
assert r_sh.ok else "glow_self_host Stage1==Stage2 or citizen desk audit failed"
assert (r_sh.err contains "Stage1==Stage2 & 13 desks proven") else "unexpected glow_self_host summary"

say "GREEN: glow_citizen_ring_and_selfhost_witness -- Stage1==Stage2 fixed-point & all 13 Citizen Ring Glow desks proven."
