# tools/g/grainos_glow_resonance_vantage_150_witness.rish -- 150th Orbit (`56.650`)!
#
# Proves all 4 approved pillars on real metal:
#   1. Native macOS Swift `vantage_mac_live.swift` linked directly against Rye
#      `libvantage_app_mac.a` (`grainos vantage --selftest`) + Daylight DC-1
#      `build_dc1_apk.rish` (`grainos carry-apk`)!
#   2. Native Rye `sow_native_gates.rye` linear-time API-secret & PEM scanner!
#   3. `Resonance` 4-track 48 kHz 16-bit RIFF `.wav` bounce (`studio_wav_bounce`
#      via `grainos resonance-bounce tools/.build/resonance_4track.wav`)!
#   4. End-to-end `grainos glow` native compiler (`double_harvest.glow` ->
#      standalone binary `./tools/.build/double_harvest 21` == `49`!)!

let rb = "tools/fixtures/r/rye_build.sh"
let rye = "languages/rye/bin/rye"
let mk = run ["mkdir" "-p" "tools/.build" "languages/rishi/bin"]
assert mk.ok else "mkdir failed"

# Build grainos umbrella CLI first
let b_go = run ["sh" rb "languages/rishi/grainos_cli.rye" "-femit-bin=languages/rishi/bin/grainos"]
assert b_go.ok else "grainos_cli build failed"

# 1. Pillar 1: Swift <-> Rye VantageApp macOS live app + Daylight DC-1 APK stage
let b_vlib = run [rye "build-lib" "modules/comlink/vantage/vantage_app.rye" "-dynamic" "-femit-bin=tools/.build/libvantage_app_mac.dylib"]
assert b_vlib.ok else "libvantage_app_mac.dylib build failed"
let b_swift = run ["swiftc" "terrarium/app/vantage_mac_live.swift" "tools/.build/libvantage_app_mac.dylib" "-Xlinker" "-rpath" "-Xlinker" "@executable_path" "-framework" "AppKit" "-o" "tools/.build/vantage_mac_live"]
assert b_swift.ok else "swiftc vantage_mac_live failed"
let r_vantage = run ["languages/rishi/bin/grainos" "vantage" "--selftest"]
assert r_vantage.ok else "grainos vantage --selftest failed"
assert (r_vantage.err contains "GREEN: vantage_mac_live") else "vantage_mac_live missing GREEN"

let r_apk = run ["languages/rishi/bin/grainos" "carry-apk"]
assert r_apk.ok else "grainos carry-apk failed"

# 2. Pillar 2: Native Rye sow secret & PEM scanner
let b_sn = run ["sh" rb "modules/fusion/sow_native_gates.rye" "-femit-bin=tools/.build/sow_native_gates"]
assert b_sn.ok else "sow_native_gates build failed"
let r_sn = run ["tools/.build/sow_native_gates"]
assert r_sn.ok else "sow_native_gates selftest failed"

# 3. Pillar 3: Resonance 4-track 48 kHz 16-bit RIFF .wav bounce
let b_wav = run ["sh" rb "modules/resonance/studio_wav_bounce.rye" "-femit-bin=tools/.build/studio_wav_bounce"]
assert b_wav.ok else "studio_wav_bounce build failed"
let r_wav_st = run ["tools/.build/studio_wav_bounce" "selftest"]
assert r_wav_st.ok else "studio_wav_bounce selftest failed"
let r_wav_out = run ["languages/rishi/bin/grainos" "resonance-bounce" "tools/.build/resonance_4track.wav"]
assert r_wav_out.ok else "grainos resonance-bounce failed"
let chk_wav = run ["sh" "-c" "test -s tools/.build/resonance_4track.wav"]
assert chk_wav.ok else "resonance_4track.wav empty"

# 4. Pillar 4: End-to-end `grainos glow` (.glow -> standalone native executable!)
let b_gc = run ["sh" rb "languages/glow/driver/glow_compile_cli.rye" "-femit-bin=tools/.build/glow_compile_cli"]
assert b_gc.ok else "glow_compile_cli build failed"
let r_gc_build = run ["languages/rishi/bin/grainos" "glow" "languages/glow/examples/double_harvest.glow" "-o" "tools/.build/double_harvest"]
assert r_gc_build.ok else "grainos glow double_harvest.glow failed"
let r_exec = run ["tools/.build/double_harvest" "21"]
assert r_exec.ok else "running compiled double_harvest binary failed"
assert (r_exec.err contains "49") else "double_harvest(21) did not produce 49!"

say "GREEN: grainos_glow_resonance_vantage_150_witness -- Swift VantageApp, DC-1 APK stage, sow_native_gates, 48kHz Resonance WAV, & grainos glow native binary proven (Myofascia 56.650)."
