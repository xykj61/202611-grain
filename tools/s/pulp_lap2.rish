# pulp_lap2.rish -- Pulp lap 1 rye_fence snippet extraction witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/s/pulp_lap2.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "pulp/bin/pulp"

let build = run ["sh" "-c" "mkdir -p pulp/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh pulp/pulp.rye -femit-bin=${bin}"]
assert build.ok else "Pulp lap 1 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Pulp selftest exited non-zero"
assert selftest.out contains "GREEN" else "Pulp selftest not GREEN"
assert selftest.out contains "rye snippets extracted" else "Pulp missing snippet extraction"
assert selftest.out contains "snippet overflow refused" else "Pulp missing snippet overflow unwelcome"

say "GREEN: Pulp lap 1 — rye_fence training snippets from session fixture."
