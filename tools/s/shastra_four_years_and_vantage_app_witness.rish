# tools/s/shastra_four_years_and_vantage_app_witness.rish -- Orbits 101-115!
#
# Proves on real metal (`Myofascia: 56.615`):
#   1. Complete 4-Year *Bloom & Shastra* Spiral executables:
#        - Year 1: `tiruppavai_dawn` (30 Andal dawn songs),
#        - Year 2: `rasamrita_waves` (Rupa Goswami 5 primary rasas),
#        - Year 3: `sikshastakam_eight` (Chaitanya Mahaprabhu 8 verses),
#        - Year 4: `gopala_champu_weave` (Jiva Goswami Gadya+Padya weaver),
#      plus `grainos sikshastakam 3` & `grainos champu`!
#   2. Unified `modules/comlink/vantage/vantage_app.rye` uniting `carry.rye` +
#      `bloom.rye` + `Dimeroll` + `Resonance` inside Vantage AND cross-compiling
#      cleanly to WASM (`vantage_app.wasm`) & Android DC-1 (`libvantage_app_dc1.a`)!
#   3. Civic `Glasswall` audit on `terrarium/carry-tablet/AndroidManifest.xml`
#      (zero `INTERNET` or `RECORD_AUDIO` permissions)!

let rb = "tools/fixtures/r/rye_build.sh"
let rye = "languages/rye/bin/rye"
let mk = run ["mkdir" "-p" "tools/.build" "libraries/shastra/sikshastakam/bin" "libraries/shastra/champu/bin" "languages/rishi/bin"]
assert mk.ok else "mkdir failed"

# 1. Year 3 Sikshastakam & Year 4 Gopala-champu + grainos CLI
let b_s3 = run ["sh" rb "libraries/shastra/sikshastakam/sikshastakam_eight.rye" "-femit-bin=libraries/shastra/sikshastakam/bin/sikshastakam_eight"]
assert b_s3.ok else "sikshastakam_eight build failed"
let r_s3 = run ["libraries/shastra/sikshastakam/bin/sikshastakam_eight" "selftest"]
assert r_s3.ok else "sikshastakam_eight selftest failed"

let b_s4 = run ["sh" rb "libraries/shastra/champu/gopala_champu_weave.rye" "-femit-bin=libraries/shastra/champu/bin/gopala_champu_weave"]
assert b_s4.ok else "gopala_champu_weave build failed"
let r_s4 = run ["libraries/shastra/champu/bin/gopala_champu_weave" "selftest"]
assert r_s4.ok else "gopala_champu_weave selftest failed"

let b_go = run ["sh" rb "languages/rishi/grain_ww_cli.rye" "-femit-bin=languages/rishi/bin/grain-ww"]
assert b_go.ok else "grain_ww_cli build failed"
let r_gs = run ["languages/rishi/bin/grain-ww" "sikshastakam" "3"]
assert r_gs.ok else "grain-ww sikshastakam 3 failed"
assert (r_gs.err contains "Trinad api sunichena") else "missing Verse 3"
let r_gc = run ["languages/rishi/bin/grain-ww" "champu"]
assert r_gc.ok else "grain-ww champu failed"

# 2. Unified `vantage_app.rye` host selftest + WASM + Android DC-1 arm64
let b_va = run ["sh" rb "modules/comlink/vantage/vantage_app.rye" "-femit-bin=tools/.build/vantage_app"]
assert b_va.ok else "vantage_app build failed"
let r_va = run ["tools/.build/vantage_app"]
assert r_va.ok else "vantage_app selftest failed"

let va_wasm = run [rye "build" "modules/comlink/vantage/vantage_app.rye" "-target" "wasm32-wasi" "-rdynamic" "-femit-bin=tools/.build/vantage_app.wasm"]
assert va_wasm.ok else "vantage_app wasm32 cross-compile failed"
let va_dc1 = run [rye "build-lib" "modules/comlink/vantage/vantage_app.rye" "-target" "aarch64-linux-musl" "-femit-bin=tools/.build/libvantage_app_dc1.a"]
assert va_dc1.ok else "vantage_app Android DC-1 arm64 cross-compile failed"

# 3. Glasswall AndroidManifest audit: zero INTERNET / RECORD_AUDIO permissions
let gw_xml = run ["sh" "-c" "! grep -E 'android.permission.INTERNET|android.permission.RECORD_AUDIO' terrarium/carry-tablet/AndroidManifest.xml"]
assert gw_xml.ok else "AndroidManifest.xml violated Glasswall zero-spyware rule!"

say "GREEN: shastra_four_years_and_vantage_app_witness -- All 4 Shastra years, unified VantageApp (macOS/WASM/DC-1), & Glasswall AndroidManifest proven."
