# pulp_lap4.rish -- Pulp lap 3: heading extract witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/s/pulp_lap4.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "pulp/bin/pulp"

let build = run ["sh" "-c" "mkdir -p pulp/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh pulp/pulp.rye -femit-bin=${bin}"]
assert build.ok else "Pulp lap 3 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Pulp selftest exited non-zero"
assert selftest.out contains "GREEN" else "Pulp selftest not GREEN"
assert selftest.out contains "headings extracted" else "Pulp missing heading extract"
assert selftest.out contains "heading overflow refused" else "Pulp missing heading overflow"

say "GREEN: Pulp lap 3 — heading extract from outline fixture."
