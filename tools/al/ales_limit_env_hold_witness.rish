# tools/al/ales_limit_env_hold_witness.rish -- an attack/HOLD/release limiter: the held dynamics trio made whole (resonance-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Resonance - the creative suite) - waymark resonance-audio - rung resonance-audio.
# Design read: active-designing/date/20260814/20260814-182307_fill-ales59-resonance-attack-hold-release-limiter.md
# Stands on: resonance/timeline.rye (resonance-audio -- the Clip, sample_min/sample_max, max_clip, the range law shape); resonance/limit.rye (resonance-audio --
# the hard ceiling this drives over time, re-proven below); resonance/hold_env.rye (resonance-audio -- the HELD time base, re-proven below); resonance/
# limit_env.rye (resonance-audio -- the un-held attack/release limiter this reduces to at a hold of zero, re-proven below).
#
# resonance/limit_env_hold.rye drives resonance-audio's hard ceiling from resonance-audio's HELD follower: each sample advances the held follower one step
# (attack rising and rearming the hold, the peak pinned while the countdown lasts, the release only once it expires), and when the held
# envelope rises above the ceiling the gain ceil/envelope is applied to the raw sample. The selftest proves: silence stays silence; a
# hold of zero reduces to the plain resonance-audio attack/release limiter byte-for-byte (proven by running both tools on one signal); below the
# ceiling is the identity; a loud signal has its magnitude reduced with the sign held and never expanding; a nonzero hold keeps the
# gain reduction engaged across a brief duck (it does not pump, the knob monotone); the state carries so a span in two pieces equals the
# whole once; a bad ceiling refuses BadCeiling, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span
# BadRange. Purely local -- no lookahead, no network, no keys, no funds, no real device, no sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_limit_env_hold_witness.rish

say "ales-limit-env-hold: Language EN — resonance-audio spends the resonance-audio hold proof for the limiter and completes the held dynamics trio: resonance-audio gave the limiter a patient sense of time, yet an un-held limiter still lets its gain jump back toward unity the moment a loud passage momentarily ducks below the ceiling (it pumps). This rung swaps the plain follower for the HELD one, so on a fall away from a peak the envelope pins the peak above the ceiling and the gain reduction stays engaged through the duck — the level stays steady. It is the mirror-sibling of resonance-audio's held compressor (the compressor at an infinite ratio, the target pinned to the ceiling)."
say "ales-limit-env-hold: Style Radiant — the law is stated positively: a hold of zero IS the plain resonance-audio attack/release limiter byte-for-byte (the zero-hold limit, proven by running both tools on one signal), below the ceiling is the identity, a nonzero hold keeps the gain reduction engaged across a brief duck (it does not pump, the knob monotone), and the state carries — env and hold_left both — so a span in two pieces equals the whole once, the seam invisible (resonance-audio's lesson). With the gate, compressor, and limiter all holding, the held dynamics trio is whole."
say "ales-limit-env-hold: Lens TAME — bounded Clip, u32 span, i16 samples, i64 envelope, u32 hold counter; ceiling checked in [1, sample_max], both coefficients in (0, 1] by the follower's one proven rule, the hold bounded by max_clip, all before any write; the gain ceil/envelope sits in (0, 1) so every written magnitude is at most the input's, fitting i16; the branch is e > ceil >= 1 so the divide is always safe (no zero-envelope case, unlike the gate); NO LOOKAHEAD (an honest gain-reducer over time, not a sample-clamp); a bad ceiling refuses BadCeiling, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange; siloed to resonance/, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err_brief}"
let bin = "${pen.out}/limit_env_hold"

let build = run ["sh" "-c" "mkdir -p resonance/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/limit_env_hold.rye -femit-bin=${bin}"]
assert build.ok else "ales-limit-env-hold: build failed — ${build.err_brief}"

let outfile = "resonance/bin/limit_env_hold.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-limit-env-hold: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-limit-env-hold: ${shown.out_brief}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-limit-env-hold' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-limit-env-hold: selftest did not print the GREEN ales-limit-env-hold line"

# This rung composes three parents over their public APIs -- re-prove resonance-audio's held follower, resonance-audio's limiter, and resonance-audio's un-held
# limiter still stand green under it.
let h = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/hold_env.rye -femit-bin=resonance/bin/hold_env && resonance/bin/hold_env selftest 2>&1 | grep -q 'GREEN ales-hold-env' && echo yes"]
assert (trim h.out) == "yes" else "ales-limit-env-hold: the resonance-audio held follower regressed under the attack/hold/release limiter"

let l = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/limit.rye -femit-bin=resonance/bin/limit && resonance/bin/limit selftest 2>&1 | grep -q 'GREEN ales-limit' && echo yes"]
assert (trim l.out) == "yes" else "ales-limit-env-hold: the resonance-audio limiter regressed under the attack/hold/release limiter"

let le = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/limit_env.rye -femit-bin=resonance/bin/limit_env && resonance/bin/limit_env selftest 2>&1 | grep -q 'GREEN ales-limit-env' && echo yes"]
assert (trim le.out) == "yes" else "ales-limit-env-hold: the resonance-audio attack/release limiter regressed under the attack/hold/release limiter"

say "ales-limit-env-hold: GREEN — an attack/HOLD/release limiter drives resonance-audio's hard ceiling from resonance-audio's HELD envelope, each sample advancing the held follower one step and, when the held envelope rises above the ceiling, applying the gain ceil/envelope to the raw sample; a hold of zero is the plain resonance-audio limiter byte-for-byte, below the ceiling is the identity, a loud signal's magnitude reduces with the sign held, a nonzero hold keeps the gain reduction engaged across a brief duck (the knob monotone, no pumping), the state carries so a span in two pieces equals the whole once; a bad ceiling refuses BadCeiling, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange, each leaving the clip untouched; the resonance-audio held follower, resonance-audio limiter, and resonance-audio limiter selftests stay GREEN. With the gate, compressor, and limiter all holding, the HELD dynamics trio is whole — the mirror of the un-held trio over one proven held follower; the lookahead delay for a true brickwall stays Keaton's hand."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err_brief}"
