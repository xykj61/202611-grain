# tools/al/ales_limit_env_witness.rish -- an attack/release limiter: the hard ceiling given a patient sense of time (resonance-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Resonance - the creative suite) - waymark resonance-audio - rung resonance-audio.
# Design read: active-designing/date/20260814/20260814-174700_fill-ales55-resonance-attack-release-limiter.md
# Stands on: resonance/timeline.rye (resonance-audio -- the Clip, sample_min/sample_max, the range law shape); resonance/limit.rye (resonance-audio -- the hard
# ceiling this drives over time, re-proven below); resonance/envelope.rye (resonance-audio -- the proven time base, re-proven below).
#
# resonance/limit_env.rye drives resonance-audio's limiter from resonance-audio's envelope: each sample advances the proven follower one step (the attack
# fraction rising, the release falling), and when the smoothed envelope rises above the ceiling the gain ceil/envelope is applied to
# the raw sample -- the compressor at an infinite ratio, the target pinned to the ceiling. The selftest proves: silence stays
# silence; unit attack and release reduce it to the plain resonance-audio limiter byte-for-byte (proven by running both tools on one signal);
# below the ceiling is the identity; a loud signal has its magnitude reduced with the sign held and never expanding; a slower attack
# lets the transient through (the gain reduction lags, the knob monotone, the honest overshoot of a limiter without lookahead); the
# state carries so a span in two pieces equals the whole once; a bad ceiling refuses BadCeiling, an illegal coefficient BadCoeff, an
# out-of-range span BadRange. Purely local -- no network, no keys, no funds, no real device, no sample rate, no lookahead.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_limit_env_witness.rish

say "ales-limit-env: Language EN — resonance-audio completes the breathing trio: the limiter (resonance-audio) proved a hard ceiling, the envelope follower (resonance-audio) proved a patient sense of time, and this rung drives the first from the second so the ceiling is approached over an attack and released gently — the compressor (resonance-audio) and gate (resonance-audio) already learned this breath, and now the limiter reads the same proven follower."
say "ales-limit-env: Style Radiant — the law is stated positively: with instant attack and release the smoothed limiter IS the plain resonance-audio limiter byte-for-byte (the zero-smoothing limit, proven by running both tools on one signal), below the ceiling is the identity, a slower attack lets the transient through (the gain reduction lags, the knob monotone), and the state carries so a span in two pieces equals the whole once — the seam invisible, resonance-audio's lesson. Honest about the horizon: without lookahead a slow attack overshoots the ceiling, a true brickwall wants a delay line."
say "ales-limit-env: Lens TAME — bounded Clip, u32 span, i16 samples, i64 envelope; ceiling checked in [1, sample_max], both coefficients in (0, 1] by the follower's one proven rule, all before any write; the gain ceil/envelope kept in (0, 1) so every written magnitude is at most the input's, fitting i16; the above-ceiling branch (e > ceil >= 1) makes the divide always safe (the zero-envelope case the gate faced cannot arise here); a bad ceiling refuses BadCeiling, an illegal coefficient BadCoeff, an out-of-range span BadRange; siloed to resonance/, no network, no keys, no funds, no device, no sample rate, no lookahead."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err_brief}"
let bin = "${pen.out}/limit_env"

let build = run ["sh" "-c" "mkdir -p resonance/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/limit_env.rye -femit-bin=${bin}"]
assert build.ok else "ales-limit-env: build failed — ${build.err_brief}"

let outfile = "resonance/bin/limit_env.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-limit-env: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-limit-env: ${shown.out_brief}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-limit-env' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-limit-env: selftest did not print the GREEN ales-limit-env line"

# This rung composes both parents over their public APIs -- re-prove resonance-audio's follower and resonance-audio's limiter still stand green.
let env = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/envelope.rye -femit-bin=resonance/bin/envelope && resonance/bin/envelope selftest 2>&1 | grep -q 'GREEN ales-envelope' && echo yes"]
assert (trim env.out) == "yes" else "ales-limit-env: the resonance-audio envelope follower regressed under the attack/release limiter"

let lim = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/limit.rye -femit-bin=resonance/bin/limit && resonance/bin/limit selftest 2>&1 | grep -q 'GREEN ales-limit' && echo yes"]
assert (trim lim.out) == "yes" else "ales-limit-env: the resonance-audio limiter regressed under the attack/release limiter"

say "ales-limit-env: GREEN — an attack/release limiter drives resonance-audio's hard ceiling from resonance-audio's proven envelope, each sample advancing the follower one step and, when the smoothed envelope rises above the ceiling, applying the gain ceil/envelope to the raw sample; with instant attack and release it is the plain limiter byte-for-byte, below the ceiling is the identity, a loud signal's magnitude only reduces with the sign held, a slower attack lets the transient through (the knob monotone, the honest no-lookahead overshoot), the state carries so a span in two pieces equals the whole once; a bad ceiling refuses BadCeiling, an illegal coefficient BadCoeff, an out-of-range span BadRange, each leaving the clip untouched; the resonance-audio follower and resonance-audio limiter selftests stay GREEN. With the limiter, compressor, and gate all breathing over one proven follower, the dynamics trio is whole — the family's next rung can open a hold stage between attack and release, or a lookahead delay for a true brickwall."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err_brief}"
