# tools/al/ales_expand_env_witness.rish -- an attack/release downward expander: the expander given a sense of time (resonance-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Resonance - the creative suite) - waymark resonance-audio - rung resonance-audio.
# Design read: active-designing/date/20260814/20260814-183555_fill-ales61-resonance-attack-release-expander.md
# Stands on: resonance/timeline.rye (resonance-audio -- the Clip, the range law shape); resonance/expand.rye (resonance-audio -- the deepened floor this drives
# over time, re-proven below); resonance/envelope.rye (resonance-audio -- the proven time base); resonance/gate_env.rye (resonance-audio -- the sibling this mirrors).
#
# resonance/expand_env.rye advances the resonance-audio follower one step per sample and, when the smoothed envelope falls below the threshold,
# widens its deficit by the ratio (resonance-audio's law) and applies that gain to the raw sample. The selftest proves: silence stays silence;
# unit attack/release reduces to the plain resonance-audio expander byte-for-byte; unit ratio is the identity everywhere; a quiet signal's
# floor deepens with the sign held and the magnitude never expanding; a slower release eases the widening longer (the knob monotone);
# the state carries so a span in two pieces equals the whole once; a zero threshold refuses BadThreshold, a sub-unity or
# zero-denominator ratio BadRatio, an illegal coefficient BadCoeff, an out-of-range span BadRange. Purely local -- no lookahead, no
# network, no keys, no funds, no real device, no sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_expand_env_witness.rish

say "ales-expand-env: Language EN — resonance-audio gives the downward expander (resonance-audio) a patient sense of time by driving its deepened floor from resonance-audio's proven envelope follower, exactly as resonance-audio gave the gate its breath. The expander eases in as a sound arrives and eases out patiently as it falls away, so a note's tail falls smoothly rather than being wrenched down, and the expander does not pump on every dip between two loud samples."
say "ales-expand-env: Style Radiant — the law is stated positively: unit attack and release reduce it to the plain resonance-audio expander byte-for-byte (the instantaneous expander is the zero-smoothing limit), unit ratio is the identity everywhere, a slower release eases the widening longer (the knob monotone), and the state carries so a span in two pieces equals the whole once — the seam invisible, the release easing across the boundary."
say "ales-expand-env: Lens TAME — bounded Clip, u32 span, i16 samples, i64 carried envelope; the threshold checked in [1, sample_max], the ratio at least unity with a nonzero denominator, both coefficients in (0,1] by the follower's one proven rule, all before any write; the deficit widened in i64 and floored at zero so the expanded envelope is at most the envelope, the gain in [0,1] and every written magnitude at most the input's; a zero threshold refuses BadThreshold, a sub-unity or zero-denominator ratio BadRatio, an illegal coefficient BadCoeff, an out-of-range span BadRange; siloed to resonance/, no lookahead, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err_brief}"
let bin = "${pen.out}/expand_env"

let build = run ["sh" "-c" "mkdir -p resonance/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/expand_env.rye -femit-bin=${bin}"]
assert build.ok else "ales-expand-env: build failed — ${build.err_brief}"

let outfile = "resonance/bin/expand_env.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-expand-env: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-expand-env: ${shown.out_brief}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-expand-env' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-expand-env: selftest did not print the GREEN ales-expand-env line"

# The attack/release expander drives the plain resonance-audio expander over time -- re-prove it still stands green beneath the new rung.
let expand = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/expand.rye -femit-bin=resonance/bin/expand && resonance/bin/expand selftest 2>&1 | grep -q 'GREEN ales-expand' && echo yes"]
assert (trim expand.out) == "yes" else "ales-expand-env: the resonance-audio expander witness regressed under the attack/release expander"

# The time base is resonance-audio's proven follower -- re-prove it too, so the rung rests on both parents.
let env = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/envelope.rye -femit-bin=resonance/bin/envelope && resonance/bin/envelope selftest 2>&1 | grep -q 'GREEN ales-envelope' && echo yes"]
assert (trim env.out) == "yes" else "ales-expand-env: the resonance-audio envelope follower witness regressed under the attack/release expander"

say "ales-expand-env: GREEN — an attack/release downward expander drives resonance-audio's deepened floor from resonance-audio's proven envelope; unit attack/release reduces to the plain resonance-audio expander byte-for-byte, unit ratio is the identity everywhere, a quiet signal's floor deepens with the sign held and the magnitude never expanding, a slower release eases the widening longer (the knob monotone), and the state carries so a span in two pieces equals the whole once; a zero threshold refuses BadThreshold, a sub-unity or zero-denominator ratio BadRatio, an illegal coefficient BadCoeff, an out-of-range span BadRange, each leaving the clip untouched; the resonance-audio expander and resonance-audio follower stay GREEN beneath it. The dynamics family now shares one time base across all four members — the next rung can give the expander its hold too (resonance-audio's held follower), or open the lookahead delay for a true brickwall (a Keaton's-word horizon)."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err_brief}"
