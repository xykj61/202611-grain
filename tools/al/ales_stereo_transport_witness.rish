# tools/al/ales_stereo_transport_witness.rish -- the stereo transport: one head reading two channels (resonance-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Resonance - the creative suite) - waymark resonance-audio - rung resonance-audio.
# Design read: active-designing/date/20260814/20260814-fill-ales15-resonance-stereo-transport.md
# Stands on: resonance/transport.rye (resonance-audio) -- the single-position Transport head reused whole; resonance/pan.rye (resonance-audio) -- the
# StereoClip whose two channels share one length; resonance/clock.rye (resonance-audio) -- seek/elapsed in real time; resonance/timeline.rye
# (resonance-audio) -- the Clip each channel is. Plays back a master rendered by resonance/power.rye (resonance-audio).
#
# resonance/stereo_transport.rye makes the read side genuinely stereo: one head advances through both channels in LOCKSTEP,
# because a stereo master's two channels share one length (resonance-audio's StereoClip invariant). The selftest proves: reading fixed
# blocks concatenates back to EACH channel byte-for-byte, both channels aligned; the last block short and the read past the
# end empty; at_end exact; mismatched out buffers refuse BadBlock; seek_ms/elapsed_ms round-trip a real moment, a seek past
# the master refusing PastEnd; a StereoClip rendered by resonance-audio's power.render_stereo plays back exactly; the transport reads
# only, never mutating the master. Purely local -- no network, no keys, no funds, no real device, no real speaker.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_stereo_transport_witness.rish

say "ales-stereo-transport: Language EN — resonance-audio plays a stereo master: one head reading both channels together, the read side finally as wide as the stereo side that built the second channel."
say "ales-stereo-transport: Style Radiant — the law is stated positively: one head reads both channels in LOCKSTEP because a stereo master's two channels share one length, so left and right never drift and each concatenates back byte-for-byte."
say "ales-stereo-transport: Lens TAME — reuses resonance-audio's single Transport head whole (no second cursor); refuses BadBlock / PastEnd by name; bounds proven within the shared length; read-only, never mutating the master; siloed to resonance/, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err_brief}"
let bin = "${pen.out}/stereo_transport"

let build = run ["sh" "-c" "mkdir -p resonance/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/stereo_transport.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-transport: build failed — ${build.err_brief}"

let outfile = "resonance/bin/stereo_transport.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-transport: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-transport: ${shown.out_brief}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-transport' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-transport: selftest did not print the GREEN ales-stereo-transport line"

say "ales-stereo-transport: GREEN — one head reads both channels in lockstep, each concatenating back byte-for-byte, and a power-rendered stereo master plays back exactly. The next Resonance rung can meter a stereo master during playback, loop a stereo region, or drive the paused two-channel sound-card write."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err_brief}"
