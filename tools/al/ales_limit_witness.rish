# tools/al/ales_limit_witness.rish -- a peak limiter: a hard ceiling the signal may touch yet never cross (resonance-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Resonance - the creative suite) - waymark resonance-audio - rung resonance-audio.
# Design read: active-designing/date/20260814/20260814-170815_fill-ales49-resonance-peak-limiter.md
# Stands on: resonance/timeline.rye (resonance-audio -- the Clip, sample_min/sample_max, the range law shape); rests beside the whole
# EQ family (resonance-audio-48, resonance-audio's bell re-proven below) without disturbing it.
#
# resonance/limit.rye passes a sample within the ceiling byte-for-byte and pins a louder sample to sign(x)-ceil. The selftest proves:
# silence stays silence; below the ceiling is the identity; a signal pinning both rails limits so no output crosses the ceiling and
# every sign is held; a ceiling at sample_max is the identity for in-range audio; a zero ceiling refuses BadCeiling, an over-rail
# ceiling BadCeiling, an out-of-range span BadRange. Purely local -- no network, no keys, no funds, no real device, no sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_limit_witness.rish

say "ales-limit: Language EN — resonance-audio opens the DYNAMICS family: a peak limiter, a hard ceiling the signal may touch yet never cross. Where the fixed-EQ family (resonance-audio–48) turns frequency, dynamics turns level — a limiter stands between a master and a blown speaker, between a loud take and a clipped file."
say "ales-limit: Style Radiant — the law is stated positively: below the ceiling is the identity (a signal whose peaks all sit within the ceiling passes untouched), and above it every sample is pinned to sign(x)·ceil so the ceiling is never crossed and the sign is always held — the magnitude only ever shrinks."
say "ales-limit: Lens TAME — bounded Clip, u32 span, i16 samples; the ceiling checked as a legal magnitude in [1, sample_max] before any write (a zero ceiling refuses BadCeiling, an over-rail ceiling BadCeiling), an out-of-range span refuses BadRange; one comparison and at most one sign-carry per sample, nothing on the audio path can overflow since a limited magnitude is min(|x|, ceil) <= i16; siloed to resonance/, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err_brief}"
let bin = "${pen.out}/limit"

let build = run ["sh" "-c" "mkdir -p resonance/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/limit.rye -femit-bin=${bin}"]
assert build.ok else "ales-limit: build failed — ${build.err_brief}"

let outfile = "resonance/bin/limit.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-limit: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-limit: ${shown.out_brief}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-limit' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-limit: selftest did not print the GREEN ales-limit line"

# The dynamics opener rests beside the finished EQ family -- re-prove resonance-audio's bell still stands green, so nothing regressed.
let bell = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/bell.rye -femit-bin=resonance/bin/bell && resonance/bin/bell selftest 2>&1 | grep -q 'GREEN ales-bell' && echo yes"]
assert (trim bell.out) == "yes" else "ales-limit: the resonance-audio parametric-bell witness regressed under the limiter"

say "ales-limit: GREEN — a peak limiter holds a hard ceiling the signal may touch yet never cross; below the ceiling is the identity byte-for-byte, above it every sample is pinned to sign(x)·ceil so the ceiling is never crossed and the sign is always held; a ceiling at sample_max is the identity for in-range audio; a zero ceiling refuses BadCeiling, an over-rail ceiling BadCeiling, an out-of-range span BadRange, each leaving the clip untouched; the resonance-audio bell selftest stays GREEN. The fixed-EQ family turned frequency; dynamics now turns level — the next Resonance rung can soften the brickwall with a ratio (a compressor), invert its threshold (a gate), or give it an attack and release over a real time base."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err_brief}"
