# inference_pulp_rish_blocks_view.rish -- Pulp rish+blocks combo -> Skate.
let bin = "pond/bin/drawn-terminal"
say "build: Pulp rish blocks view — drawn-terminal compile"
let build = run ["sh" "tools/fixtures/p/pond_build_drawn_terminal.sh"]
assert build.ok else "drawn_terminal build failed for pulp rish blocks view"
assert build.out contains "GREEN:" else "drawn_terminal build did not reach GREEN"
let view = run ["sh" "-c" "${bin} pulprishblocksviewtest 2>&1"]
assert view.ok else "drawn terminal pulprishblocksviewtest exited non-zero"
assert view.out contains "pulp rish blocks view" else "rish blocks view missing expected output"
assert view.out contains "GREEN" else "Pulp rish blocks view not GREEN"
assert view.out contains "lines=5" else "rish blocks view missing five-line frame"
assert view.out contains "rish=1" else "rish blocks view missing rish=1"
assert view.out contains "blocks=4" else "rish blocks view missing blocks=4"
say "GREEN: Pulp rish blocks view — rish and blocks on one Skate frame."
