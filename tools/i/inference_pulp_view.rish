# inference_pulp_view.rish -- Pulp outline headings -> Skate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/i/inference_pulp_view.rish

let bin = "pond/bin/drawn-terminal"

say "build: Pulp outline view — drawn-terminal compile"
let build = run ["sh" "tools/fixtures/p/pond_build_drawn_terminal.sh"]
assert build.ok else "drawn_terminal build failed for pulp view"
assert build.out contains "GREEN:" else "drawn_terminal build did not reach GREEN"

let view = run ["sh" "-c" "${bin} pulpviewtest 2>&1"]
assert view.ok else "drawn terminal pulpviewtest exited non-zero"
assert view.out contains "pulp view" else "pulp view missing expected output"
assert view.out contains "GREEN" else "Pulp outline view not GREEN"
assert view.out contains "lines=6" else "pulp view missing six-line frame"

say "GREEN: Pulp outline view — headings compose a Skate frame."
