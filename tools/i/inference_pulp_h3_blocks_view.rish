# inference_pulp_h3_blocks_view.rish -- Pulp h3+blocks combo -> Skate.
let bin = "pond/bin/drawn-terminal"
say "build: Pulp h3 blocks view — drawn-terminal compile"
let build = run ["sh" "tools/fixtures/p/pond_build_drawn_terminal.sh"]
assert build.ok else "drawn_terminal build failed for pulp h3 blocks view"
assert build.out contains "GREEN:" else "drawn_terminal build did not reach GREEN"
let view = run ["sh" "-c" "${bin} pulph3blocksviewtest 2>&1"]
assert view.ok else "drawn terminal pulph3blocksviewtest exited non-zero"
assert view.out contains "pulp h3 blocks view" else "h3 blocks view missing expected output"
assert view.out contains "GREEN" else "Pulp h3 blocks view not GREEN"
assert view.out contains "lines=5" else "h3 blocks view missing five-line frame"
assert view.out contains "h3=1" else "h3 blocks view missing h3=1"
assert view.out contains "blocks=6" else "h3 blocks view missing blocks=6"
say "GREEN: Pulp h3 blocks view — h3 and blocks on one Skate frame."
