# tame_check_th2b.rish -- TH-2b witness: Blaze module clean under tame-check.
#
# Gates blaze/src/* only -- global tame-check gates the full corpus after TH-2c.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/t/tame_check_th2b.rish

let result = run ["rishi/bin/rishi" "run" "tools/fixtures/t/tame_check_blaze.rish"]
assert result.ok else "Blaze must have zero unqualified std.debug.assert calls and import-once binding in each file"

say "GREEN: TH-2b — Blaze reads bare assert; module gated clean."
