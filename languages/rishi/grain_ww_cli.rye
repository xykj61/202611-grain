        "USAGE: grain-ww <command> [args...]\n\n" ++
        "TOOLCHAIN\n" ++
        "  status         live project health summary\n" ++
        "  calfive        live calfive snapshot table\n" ++
        "  preflight      cross-file integrity check\n" ++
        "  version        print version + myofascia\n" ++
