            "tools/.build/libra_preflight",
            null,
            &.{},
        );
    }
    if (std.mem.eql(u8, sub, "readme-refresh")) {
        const rr: []const []const u8 = &.{
            "run",
            "tools/readme_metrics_patch.rish",
        };
        return dispatch_exec(
            a,
            io,
            "languages/rishi/bin/rishi",
            null,
            rr,
