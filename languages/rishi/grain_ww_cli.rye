        "  witness-all    run all metal witnesses\n\n" ++
        "CLOCK & CALFIVE\n" ++
        "  stamp [file]   print chronological stamp\n" ++
        "  cadence        bench/seed remote config\n" ++
        "  movement       current calfive position\n" ++
        "  orbit-harvest  siya orbit harvest seal\n" ++
        "  round-load     full calfive round reading\n\n" ++
        "VANTAGE CARRY\n" ++
        "  carry-gate     admission gate selftest\n" ++
        "  carry-publish  3-door publish gate\n" ++
        "  carry-device   5-stage USB pipeline\n" ++
        "  carry-session  multi-signer session\n" ++
        "  carry-hearth   hearth display mold\n" ++
        "  carry-manifest android manifest emission\n\n" ++
        "CONIFER & HARNESS\n" ++
        "  conifer        CLI terminal (journal+prompt)\n" ++
        "  harness-cache  cached harness dispatch\n" ++
        "  harness-console visual console\n" ++
        "  harness-wood   WOOD compute ledger\n\n" ++
        "HUSK & STUDIO\n" ++
        "  husk-lower     .husk -> .md template lower\n" ++
        "  readme-refresh patch README from .husk\n" ++
        "  husk-editor    husk movement editor\n" ++
        "  studio-deck    vantage studio deck\n" ++
        "  triptych-art   triptych canvas\n\n" ++
        "MARKET & SKY\n" ++
        "  market         dimeroll WOOD market\n" ++
        "  market-deck    C-ABI market surface\n" ++
        "  market-e2e     end-to-end market flow\n" ++
        "  sky-view       realidream constellation\n\n" ++
        "AUDIT & WITNESS\n" ++
        "  audit-clean    residue-free file check\n" ++
        "  virgo-audit    compass topology audit\n" ++
        "  libra-scales   scales gate\n" ++
        "  pond-airlock   sanctuary airlock\n" ++
        "  whole-cup      sameness macro cup\n" ++
        "  stamp-ratchet  stamp-no-serial ratchet\n\n" ++
        "Run grain-ww <command> with no args for its\n" ++
        "selftest. See grain_ww_cli.rye for all 85.\n";
    print("{s}", .{h});
    return 0;
}

fn dispatch_exec(
    a: std.mem.Allocator,
    io: std.Io,
    bin: []const u8,
    extra_first: ?[]const u8,
    tail: []const []const u8,
) !u8 {
    var argv: std.ArrayListUnmanaged([]const u8) = .empty;
    try argv.append(a, bin);
    if (extra_first) |ef| try argv.append(a, ef);
    for (tail) |x| try argv.append(a, x);
    const r = try std.process.run(a, io, .{ .argv = argv.items });
    print("{s}{s}", .{ r.stdout, r.stderr });
    return switch (r.term) {
        .exited => |c| c,
        else => 1,
    };
}

fn run_selftest(io: std.Io) !u8 {
    var buf: [128]u8 = undefined;
    const b = try format_banner(&buf);
    if (std.mem.indexOf(u8, b, grain_ww_version) == null) {
        return error.BadBanner;
    }
    if ((try run_doctor(io)) != 0) return error.DoctorFailed;
    print("GREEN: grain_ww_cli -- banner, doctor, & subcommands proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const a = init.arena.allocator();
    const io = init.io;
    const args = try init.minimal.args.toSlice(a);

    if (args.len <= 1) {
        var buf: [128]u8 = undefined;
        const b = try format_banner(&buf);
        print("{s}\nRun grain-ww help for commands.\n", .{b});
        return 0;
    }
    if (std.mem.eql(u8, args[1], "version") or
        std.mem.eql(u8, args[1], "--version"))
    {
        var buf: [128]u8 = undefined;
        const b = try format_banner(&buf);
        print("{s}", .{b});
        return 0;
    }
    const sub = args[1];
    if (std.mem.eql(u8, sub, "selftest")) return run_selftest(io);
    if (std.mem.eql(u8, sub, "help") or
        std.mem.eql(u8, sub, "--help") or
        std.mem.eql(u8, sub, "-h"))
    {
        return print_help();
    }
    if (std.mem.eql(u8, sub, "doctor")) return run_doctor(io);
    if (std.mem.eql(u8, sub, "stamp")) {
        return dispatch_exec(
            a,
            io,
            "tools/.build/one_clock",
            null,
            args[2..],
        );
    }
    if (std.mem.eql(u8, sub, "cadence")) {
        return dispatch_exec(
