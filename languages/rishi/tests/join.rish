# join.rish -- tests for the `join` list builtin.

let words = ["rye" "rishi" "blaze"]
assert join words " " == "rye rishi blaze" else "join: space failed"
assert join words "," == "rye,rishi,blaze" else "join: comma failed"

let one = ["solo"]
assert join one "|" == "solo" else "join: single element failed"

let empty = []
assert join empty "," == "" else "join: empty list failed"

# compose with map: build a path from segments
let segs = ["home" "xy" "grain"]
let path = join segs "/"
assert path == "home/xy/grain" else "join: path compose failed"

say "join held."
