//! languages/glow/front/trace_trail.rye -- `~&`, `~|`, & `!:` diagnostics.
//!
//! Glow Mill & Citizen Ring Orbit 3 (`20261115.085000`).
//! Gives Glow humane, TAME-bounded observability without breaking purity:
//!   1. `~&` (`sigpam`): records formatted trace lines into a bounded Basin
//!      ring (`max_traces = 64`) while returning the inner expression's value
//!      100% unchanged (referential transparency preserved!),
//!   2. `~|` (`sigbar`) + `!:` (`zapcol`): maintains a bounded breadcrumb
//!      stack (`max_breadcrumbs = 16`) with `file:line:col` source spans so
//!      any tripped `?>` / `?<` assertion formats a crystal-clear trail!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const version = "20261115.085000";
pub const max_traces: u32 = 64;
pub const max_trace_bytes: u32 = 128;
pub const max_breadcrumbs: u32 = 16;
const nl: u8 = 10;

pub const TrailError = error{
    BreadcrumbStackOverflow,
    BreadcrumbStackUnderflow,
    AssertionRefused,
    BufferTooSmall,
};

pub const SourceSpan = struct {
    file: []const u8,
    line: u32,
    col: u32,
};

pub const Breadcrumb = struct {
    note: []const u8,
    span: SourceSpan,
};

pub const BasinTraceContext = struct {
    traces: [max_traces][max_trace_bytes]u8,
    trace_lens: [max_traces]u32,
    trace_count: u32,
    crumbs: [max_breadcrumbs]Breadcrumb,
    crumb_depth: u32,
    active_span: SourceSpan,

    pub fn init(root_file: []const u8) BasinTraceContext {
        assert(root_file.len > 0);
        return .{
            .traces = undefined,
            .trace_lens = std.mem.zeroes([max_traces]u32),
            .trace_count = 0,
            .crumbs = undefined,
            .crumb_depth = 0,
            .active_span = .{ .file = root_file, .line = 1, .col = 1 },
        };
    }

    /// `!:` (`zapcol`) updates the active `file:line:col` span for downstream
    /// assertions without altering evaluation semantics.
    pub fn mark_zapcol(self: *BasinTraceContext, line: u32, col: u32) void {
        assert(line >= 1 and col >= 1);
        self.active_span.line = line;
        self.active_span.col = col;
        assert(self.active_span.line == line);
    }

    /// `~&` (`sigpam`) records a diagnostic note and returns `val` untouched!
    pub fn eval_sigpam_u64(
        self: *BasinTraceContext,
        tag: []const u8,
        val: u64,
    ) u64 {
        // invariant: trace cursor stays bounded via modulo ring wrap.
        const slot = self.trace_count % max_traces;
        assert(slot < max_traces);
        if (std.fmt.bufPrint(
            &self.traces[slot],
            "~&  [{s} {d}]",
            .{ tag, val },
        )) |s| {
            self.trace_lens[slot] = @intCast(s.len);
        } else |_| {
            self.trace_lens[slot] = 0;
        }
        self.trace_count += 1;
        // invariant: returned value equals input `val` bit-for-bit.
        assert(self.trace_count >= 1);
        return val;
    }

    /// `~|` (`sigbar`) pushes a breadcrumb onto the bounded stack.
    pub fn push_sigbar(
        self: *BasinTraceContext,
        note: []const u8,
    ) TrailError!void {
        assert(self.crumb_depth <= max_breadcrumbs);
        if (self.crumb_depth >= max_breadcrumbs) {
            return error.BreadcrumbStackOverflow;
        }
        self.crumbs[self.crumb_depth] = .{
            .note = note,
            .span = self.active_span,
        };
        self.crumb_depth += 1;
        assert(self.crumb_depth <= max_breadcrumbs);
    }

    pub fn pop_sigbar(self: *BasinTraceContext) TrailError!void {
        if (self.crumb_depth == 0) return error.BreadcrumbStackUnderflow;
        self.crumb_depth -= 1;
        assert(self.crumb_depth < max_breadcrumbs);
    }

    /// Evaluates `?>` (`wutgar`) positive assertion; on refusal, formats the
    /// full `file:line:col` + reverse breadcrumb stack into `report_out`.
    pub fn check_wutgar(
        self: *const BasinTraceContext,
        cond: bool,
        report_out: []u8,
    ) TrailError!void {
        assert(self.crumb_depth <= max_breadcrumbs);
        if (cond) return;

        var pos: usize = 0;
        const head = std.fmt.bufPrint(
            report_out[pos..],
            "glow refusal at {s}:{d}:{d}{c}",
            .{
                self.active_span.file,
                self.active_span.line,
                self.active_span.col,
                nl,
            },
        ) catch return error.BufferTooSmall;
        pos += head.len;

        var d = self.crumb_depth;
        while (d > 0) {
            d -= 1;
            const c = self.crumbs[d];
            const row = std.fmt.bufPrint(
                report_out[pos..],
                "  ~| {s} ({s}:{d}:{d}){c}",
                .{ c.note, c.span.file, c.span.line, c.span.col, nl },
            ) catch return error.BufferTooSmall;
            pos += row.len;
        }
        assert(pos <= report_out.len);
        return error.AssertionRefused;
    }
};

fn run_selftest() !u8 {
    var ctx = BasinTraceContext.init("modules/market/glow/settle.glow");

    // 1. `~&` preserves output value identically while recording Basin trace!
    const plain: u64 = 42 * 2;
    const traced = ctx.eval_sigpam_u64("mid-step", 42) * 2;
    if (plain != traced) return error.SigpamAlteredValue;
    if (ctx.trace_count != 1) return error.MissingTraceLine;
    const line0 = ctx.traces[0][0..ctx.trace_lens[0]];
    if (!std.mem.eql(u8, line0, "~&  [mid-step 42]")) return error.BadTraceFmt;

    // 2. `~|` + `!:` + failing `?>` formats full breadcrumb trail & line:col!
    ctx.mark_zapcol(12, 3);
    try ctx.push_sigbar("settling dimeroll batch");
    ctx.mark_zapcol(19, 5);
    try ctx.push_sigbar("checking positive amount");
    ctx.mark_zapcol(20, 7);

    var rep: [512]u8 = undefined;
    try ctx.check_wutgar(true, &rep);
    if (ctx.check_wutgar(false, &rep)) |_| {
        return error.FalseAssertionPassed;
    } else |err| {
        if (err != error.AssertionRefused) return err;
    }
    if (std.mem.indexOf(u8, &rep, "settle.glow:20:7") == null or
        std.mem.indexOf(u8, &rep, "checking positive amount") == null or
        std.mem.indexOf(u8, &rep, "settling dimeroll batch") == null)
    {
        return error.BreadcrumbTrailIncomplete;
    }

    print("GREEN: trace_trail -- ~&, ~|, & !: structured trails proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
