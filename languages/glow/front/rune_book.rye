    fam('|', "bar", "cores, gates, doors, loops", .carried, "Core code blocks"),
    fam('$', "buc", "structural shapes & unions", .carried, "Static layouts"),
    fam('%', "cen", "calls & functional updates", .carried, "Gate calls/recur"),
    fam(':', "col", "tuple / cell constructors", .carried, "Fixed-arity cells"),
    fam('^', "ket", "explicit type casts", .carried, "Compile-time cast"),
    fam('=', "tis", "subject bindings & state", .carried, "Pure state-thread"),
    fam('?', "wut", "conditionals & guards", .carried, "Tags & assertions"),
    fam('/', "fas", "Sheaf imports & pins", .module_mapped, "Sheaf + Brix"),
    fam('+', "lus", "chapter arms & shape defs", .carried, "++ arms, +$ molds"),
    fam(';', "mic", "wire combinators", .module_mapped, "Wire ;~ parsers"),
    fam('~', "sig", "pure traces & intrinsics", .carried, "Basin ~& & ~%"),
    fam('!', "zap", "refusal & span trails", .carried, "Refusal breadcrumbs"),
    fam('.', "dot", "Nock untyped operators", .dissolved, "Replaced by Pith"),
