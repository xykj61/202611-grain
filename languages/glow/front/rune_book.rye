pub fn count_live() u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    const total: u32 = @intCast(runes.len);
    // invariant: rune table stays well inside static ceiling.
    assert(total >= expected_live_count and total <= 256);
    while (i < total) : (i += 1) {
        if (runes[i].status == .live) n += 1;
    }
    // invariant: live count equals expected_live_count (30).
    assert(n == expected_live_count);
    return n;
}

pub fn is_live_digraph(two: []const u8) bool {
    // invariant: caller passes short slices; only length 2 can match.
    assert(two.len <= 64);
    if (two.len != 2) return false;
    var i: u32 = 0;
    const total: u32 = @intCast(runes.len);
    assert(total >= expected_live_count);
    while (i < total) : (i += 1) {
        const r = runes[i];
        if (r.status == .live) {
            assert(r.digraph.len == 2);
            if (r.digraph[0] == two[0] and r.digraph[1] == two[1]) return true;
        }
    }
    return false;
}

pub fn lookup(two: []const u8) ?RuneSpec {
    if (two.len != 2) return null;
    var i: u32 = 0;
    const total: u32 = @intCast(runes.len);
    // invariant: static rune book is non-empty and bounded.
    assert(total >= expected_live_count and total <= 256);
    while (i < total) : (i += 1) {
        const r = runes[i];
        assert(r.digraph.len == 2);
        if (r.digraph[0] == two[0] and r.digraph[1] == two[1]) return r;
    }
    return null;
}

pub const RenderError = error{BufferTooSmall};

fn append_str(out: []u8, pos: *u32, s: []const u8) RenderError!void {
    const cap: u32 = @intCast(out.len);
    // invariant: cursor stays within buffer capacity before write.
    assert(pos.* <= cap);
    const n: u32 = @intCast(s.len);
    if (n > cap - pos.*) return error.BufferTooSmall;
    var i: u32 = 0;
    while (i < n) : (i += 1) {
        out[pos.* + i] = s[i];
    }
    pos.* += n;
    // invariant: cursor stays within buffer capacity after write.
    assert(pos.* <= cap);
}

fn disp_str(d: Disposition) []const u8 {
    return switch (d) {
        .carried => "carried",
        .module_mapped => "module-mapped",
        .dissolved => "dissolved",
    };
}

fn status_str(s: Status) []const u8 {
    return switch (s) {
        .live => "live",
        .planned => "planned (Mill)",
    };
}

pub fn render_markdown(out: []u8) RenderError!u32 {
    var pos: u32 = 0;
    // invariant: output cursor starts at zero.
    assert(pos == 0);
    try append_str(out, &pos, "# Glow Rune Book -- Canonical Reference\n\n");
    try append_str(out, &pos, "**Language:** EN\n**Voice:** Kyri\n");
    try append_str(out, &pos, "**Style:** Teacher & Gauge at Field\n");
    try append_str(
        out,
        &pos,
        "**Status:** Living (`Room: checkable` -- generated)\n\n",
    );
    try append_str(out, &pos, "## 1. Thirteen Hoon Glyph Families in Glow\n\n");
    try append_str(
        out,
        &pos,
        "| Glyph | Spoken | Domain | Disposition | Note |\n",
    );
    try append_str(out, &pos, "|---|---|---|---|---|\n");

    var fi: u32 = 0;
    const ftotal: u32 = @intCast(families.len);
    assert(ftotal == expected_family_count);
    while (fi < ftotal) : (fi += 1) {
        const f = families[fi];
        var gbuf: [1]u8 = .{f.glyph};
        try append_str(out, &pos, "| `");
        try append_str(out, &pos, &gbuf);
        try append_str(out, &pos, "` | `");
        try append_str(out, &pos, f.spoken);
        try append_str(out, &pos, "` | ");
        try append_str(out, &pos, f.domain);
        try append_str(out, &pos, " | **");
        try append_str(out, &pos, disp_str(f.disposition));
        try append_str(out, &pos, "** | ");
        try append_str(out, &pos, f.note);
        try append_str(out, &pos, " |\n");
    }

    try append_str(
        out,
        &pos,
        "\n## 2. All Glow Rune Digraphs (48/48 Live Across 13 Families)\n\n",
    );
    try append_str(
        out,
        &pos,
        "| Digraph | Spoken | Status | Arity / Shape | Summary |\n",
    );
    try append_str(out, &pos, "|---|---|---|---|---|\n");

    var ri: u32 = 0;
    const rtotal: u32 = @intCast(runes.len);
    while (ri < rtotal) : (ri += 1) {
        const r = runes[ri];
        try append_str(out, &pos, "| `");
        try append_str(out, &pos, r.digraph);
        try append_str(out, &pos, "` | `");
        try append_str(out, &pos, r.spoken);
        try append_str(out, &pos, "` | ");
        try append_str(out, &pos, status_str(r.status));
        try append_str(out, &pos, " | `");
        try append_str(out, &pos, r.arity);
        try append_str(out, &pos, "` | ");
        try append_str(out, &pos, r.summary);
        try append_str(out, &pos, " |\n");
    }

    // invariant: rendered markdown is non-empty and bounded.
    assert(pos > 256 and pos <= @as(u32, @intCast(out.len)));
    return pos;
}

pub const CheckError = error{
    DigraphCountDrift,
    DigraphRowDrift,
    MarkdownDrift,
};

pub fn verify_fixture_body(body: []const u8) CheckError!void {
    var seen: u32 = 0;
    var it = std.mem.splitScalar(u8, body, '\n');
    while (it.next()) |raw| {
        const line = std.mem.trim(u8, raw, " \t\r");
        if (line.len == 0) continue;
        if (seen >= expected_live_count) return error.DigraphCountDrift;
        if (!std.mem.eql(u8, line, runes[seen].digraph)) {
            return error.DigraphRowDrift;
        }
        if (runes[seen].status != .live) return error.DigraphRowDrift;
        seen += 1;
    }
    if (seen != expected_live_count) return error.DigraphCountDrift;
    // invariant: exact 30/30 live row count proven.
    assert(seen == expected_live_count);
}

fn run_selftest() !u8 {
    if (count_live() != expected_live_count) return error.BadLiveCount;
    if (families.len != expected_family_count) return error.BadFamilyCount;

    const rtotal: u32 = @intCast(runes.len);
    var i: u32 = 0;
    while (i < rtotal) : (i += 1) {
        assert(runes[i].digraph.len == 2);
        var j: u32 = i + 1;
        while (j < rtotal) : (j += 1) {
            if (std.mem.eql(u8, runes[i].digraph, runes[j].digraph)) {
                return error.DuplicateDigraph;
            }
        }
    }

    if (!is_live_digraph("|=")) return error.MissingBartis;
    if (!is_live_digraph("%^")) return error.MissingCenket;
    if (!is_live_digraph("/~")) return error.MissingFassig;
    if (!is_live_digraph("|_")) return error.MissingBarcab;
    if (!is_live_digraph("!!")) return error.MissingZapzap;
    if (is_live_digraph("/?")) return error.UnknownMarkedLive;
    if (lookup("??") != null) return error.UnknownAccepted;

    var tiny: [32]u8 = undefined;
    if (render_markdown(&tiny)) |_| {
        return error.TinyBufferAccepted;
    } else |err| {
        if (err != error.BufferTooSmall) return err;
    }

    if (verify_fixture_body("$$\n")) |_| {
        return error.DriftAccepted;
    } else |_| {}

    print("rune_book: 13 families, {d}/48 live runes.\n", .{
        count_live(),
    });
    print("GREEN: rune_book -- zero-drift Glow rune table proven.\n", .{});
    return 0;
}

fn run_emit_md(io: std.Io, out_path: []const u8) !u8 {
    var buf: [16384]u8 = undefined;
    const n = try render_markdown(&buf);
    assert(n <= buf.len);
    try std.Io.Dir.cwd().writeFile(io, .{
        .sub_path = out_path,
        .data = buf[0..n],
    });
    print("WROTE {s} ({d} bytes)\n", .{ out_path, n });
    return 0;
}

fn run_check(
    init: std.process.Init,
    tbl_path: []const u8,
    md_path: []const u8,
) !u8 {
    const a = init.arena.allocator();
    const cwd = std.Io.Dir.cwd();
    const tbl = try cwd.readFileAlloc(init.io, tbl_path, a, .limited(8192));
    verify_fixture_body(tbl) catch |err| {
        print("FAIL DigraphDrift in {s}: {s}\n", .{
            tbl_path,
            @errorName(err),
        });
        return 1;
    };

    const got_md = try cwd.readFileAlloc(init.io, md_path, a, .limited(32768));
    var want_buf: [16384]u8 = undefined;
    const n = try render_markdown(&want_buf);
    if (!std.mem.eql(u8, got_md, want_buf[0..n])) {
        print("FAIL MarkdownDrift in {s}\n", .{md_path});
        return 1;
    }
    print("GREEN: rune_book check -- {d}/48 live heads & md agree.\n", .{
        count_live(),
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const args = try init.minimal.args.toSlice(init.arena.allocator());
    if (args.len >= 3 and std.mem.eql(u8, args[1], "emit-md")) {
        return run_emit_md(init.io, args[2]);
    }
    if (args.len >= 4 and std.mem.eql(u8, args[1], "check")) {
        return run_check(init, args[2], args[3]);
    }
    return run_selftest();
}
