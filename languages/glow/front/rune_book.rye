//! languages/glow/front/rune_book.rye -- single truth table for Glow runes.
//!
//! Glow Mill Quest 1, Orbit 1 (`20261115.044500`).
//! Closes drift between `tokens.rye`, `glow_digraph_table.txt`, and
//! `docs-geode/api/glow-runes.md` via one static table of:
//!   1. All 13 Hoon glyph families (`carried`, `module_mapped`, `dissolved`),
//!   2. All 30 live Glow digraphs (`.live`) + 18 Mill additions (`.planned`).

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const rune_book_version = "20261115.180000";
pub const expected_live_count: u32 = 48;
pub const expected_family_count: u32 = 13;

pub const Disposition = enum {
    carried,
    module_mapped,
    dissolved,
};

pub const Status = enum {
    live,
    planned,
};

pub const FamilySpec = struct {
    glyph: u8,
    spoken: []const u8,
    domain: []const u8,
    disposition: Disposition,
    note: []const u8,
};

pub const RuneSpec = struct {
    family: u8,
    digraph: []const u8,
    spoken: []const u8,
    status: Status,
    arity: []const u8,
    summary: []const u8,
};

fn fam(
    g: u8,
    s: []const u8,
    dom: []const u8,
    disp: Disposition,
    note: []const u8,
) FamilySpec {
    return .{
        .glyph = g,
        .spoken = s,
        .domain = dom,
        .disposition = disp,
        .note = note,
    };
}

fn rn(
    g: u8,
    d: []const u8,
    s: []const u8,
    st: Status,
    ar: []const u8,
    sum: []const u8,
) RuneSpec {
    return .{
        .family = g,
        .digraph = d,
        .spoken = s,
        .status = st,
        .arity = ar,
        .summary = sum,
    };
}

