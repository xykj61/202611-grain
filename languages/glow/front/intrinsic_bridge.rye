//! languages/glow/front/intrinsic_bridge.rye -- Checked `u64` & `~%` FIPS-202.
//!
//! Glow Mill Stamp: `20261115.091000`).
//! Citizen stdlib bridge pairing pure Glow checked `@u32`/`@u64` arithmetic &
//! `~%  %sha3-256` / `~%  %ed25519-verify` hints with verified Rye primitives:
//!   - Refuses `u64` overflow/underflow/div-by-zero by name,
//!   - Proves byte-for-byte NIST FIPS-202 SHA3-256 parity!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha3_256 = std.crypto.hash.sha3.Sha3_256;
const Ed25519 = std.crypto.sign.Ed25519;

pub const version = "20261115.091000";
const nl: u8 = 10;

pub const MathError = error{
    OverflowU64,
    UnderflowU64,
    DivideByZero,
};

pub fn gate_checked_add_u64(a: u64, b: u64) MathError!u64 {
    const res = @addWithOverflow(a, b);
    if (res[1] != 0) return error.OverflowU64;
    // invariant: non-overflowing unsigned sum is >= both addends.
    assert(res[0] >= a and res[0] >= b);
    return res[0];
}

pub fn gate_checked_sub_u64(a: u64, b: u64) MathError!u64 {
    if (b > a) return error.UnderflowU64;
    const diff = a - b;
    // invariant: diff + b reconstructs `a` identically.
    assert(diff <= a and diff + b == a);
    return diff;
}

pub fn gate_checked_mul_div_u64(
    a: u64,
    b: u64,
    denom: u64,
) MathError!u64 {
    if (denom == 0) return error.DivideByZero;
    const prod = @mulWithOverflow(a, b);
    if (prod[1] != 0) return error.OverflowU64;
    const q = prod[0] / denom;
    assert(denom > 0 and q <= prod[0]);
    return q;
}

/// `~%  %sha3-256` intrinsic binding verified against NIST FIPS-202!
pub fn intrinsic_sha3_256(msg: []const u8) [32]u8 {
    var out: [32]u8 = undefined;
    Sha3_256.hash(msg, &out, .{});
    assert(out.len == 32);
    return out;
}

/// `~%  %ed25519-verify` intrinsic returning Loobean (`0` = true, `1` = false).
pub fn intrinsic_ed25519_verify_loob(
    msg: []const u8,
    sig_bytes: [64]u8,
    pk_bytes: [32]u8,
) u32 {
    const sig = Ed25519.Signature.fromBytes(sig_bytes);
    const pk = Ed25519.PublicKey.fromBytes(pk_bytes) catch return 1;
    sig.verify(msg, pk) catch return 1;
    return 0;
}

fn hex_of(d: [32]u8) [64]u8 {
    const lut = "0123456789abcdef";
    var out: [64]u8 = undefined;
    var i: u32 = 0;
    while (i < 32) : (i += 1) {
        out[i * 2] = lut[d[i] >> 4];
        out[i * 2 + 1] = lut[d[i] & 0x0f];
    }
    return out;
}

fn run_selftest() !u8 {
    // 1. Checked u64 welcome + overflow/underflow/div0 refusals
    if ((try gate_checked_add_u64(40, 2)) != 42) return error.AddWrong;
    if (gate_checked_add_u64(std.math.maxInt(u64), 1)) |_| {
        return error.OverflowAccepted;
    } else |err| {
        if (err != error.OverflowU64) return err;
    }
    if (gate_checked_sub_u64(5, 6)) |_| {
        return error.UnderflowAccepted;
    } else |err| {
        if (err != error.UnderflowU64) return err;
    }
    if (gate_checked_mul_div_u64(10, 20, 0)) |_| {
        return error.DivZeroAccepted;
    } else |err| {
        if (err != error.DivideByZero) return err;
    }

    // 2. NIST FIPS-202 SHA3-256 empty-message golden vector parity!
    const fips_empty =
        "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a";
    const got_hex = hex_of(intrinsic_sha3_256(""));
    if (!std.mem.eql(u8, &got_hex, fips_empty)) return error.FipsVectorMismatch;

    // 3. `~%  %ed25519-verify` Loobean welcome (`0`) and forged refusal (`1`)
    const seed: [32]u8 = @splat(0x77);
    const kp = try Ed25519.KeyPair.generateDeterministic(seed);
    const sig = try kp.sign("grain-glow", null);
    if (intrinsic_ed25519_verify_loob(
        "grain-glow",
        sig.toBytes(),
        kp.public_key.toBytes(),
    ) != 0) {
        return error.ValidSigRejected;
    }
    if (intrinsic_ed25519_verify_loob(
        "tampered!",
        sig.toBytes(),
        kp.public_key.toBytes(),
    ) != 1) {
        return error.TamperedSigAccepted;
    }

    print("GREEN: intrinsic_bridge -- checked u64 & FIPS-202 ~% proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
