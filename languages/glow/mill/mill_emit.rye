//! languages/glow/mill/mill_emit.rye -- RV64GC, AArch64, & Rye fixed-point!
//!
//! Glow Mill Stamp: `20261115.091500`).
//! Dual-silicon + TAME Rye backend lowering `PithIR` simultaneously to:
//!   1. `RV64GC` / `RV32IM` words (`addi`, `add`, `mul`, `ret` `0x8067`),
//!   2. `AArch64` (Apple Silicon) 32-bit machine words (`movz`, `add`, `madd`,
//!      `ret` `0xD65F03C0`),
//!   3. Readable TAME `.rye` source,
//!   4. Proves deterministic `Stage 1 == Stage 2` fixed-point emission parity!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha3_256 = std.crypto.hash.sha3.Sha3_256;

pub const version = "20261115.091500";
pub const max_words: u32 = 256;
const nl: u8 = 10;

pub const MillError = error{
    CodeBufferOverflow,
    ImmOutOf12BitRange,
    RegOutOfBounds,
};

pub const MiniOp = enum(u8) {
    mov_imm,
    add_rr,
    mul_rr,
    ret_a0,
};

pub const MiniInst = struct {
    op: MiniOp,
    rd: u5,
    rs1: u5,
    rs2: u5,
    imm12: u12,
};

/// Emits 32-bit little-endian RISC-V instruction words (`RV64GC` / `RV32IM`).
pub fn emit_riscv_words(
    prog: []const MiniInst,
    out_words: []u32,
) MillError!u32 {
    if (prog.len > out_words.len) return error.CodeBufferOverflow;
    var w: u32 = 0;
    for (prog) |ins| {
        const rd: u32 = ins.rd;
        const rs1: u32 = ins.rs1;
        const rs2: u32 = ins.rs2;
        const imm: u32 = ins.imm12;
        out_words[w] = switch (ins.op) {
            // ADDI rd, x0, imm12 (opcode 0x13)
            .mov_imm => (imm << 20) | (0 << 15) | (0 << 12) | (rd << 7) | 0x13,
            // ADD rd, rs1, rs2 (opcode 0x33)
            .add_rr => (rs2 << 20) | (rs1 << 15) | (0 << 12) | (rd << 7) | 0x33,
            // MUL rd, rs1, rs2 (M-extension funct7=0x01, opcode 0x33)
            .mul_rr => (0x01 << 25) | (rs2 << 20) | (rs1 << 15) |
                (rd << 7) | 0x33,
            // JALR x0, 0(x1) (`ret` = 0x0000_8067)
            .ret_a0 => 0x0000_8067,
        };
        w += 1;
    }
    // invariant: emitted word count equals input instruction count.
    assert(w == prog.len);
    return w;
}

/// Emits standard AArch64 (Apple Silicon) 32-bit instruction words!
pub fn emit_aarch64_words(
    prog: []const MiniInst,
    out_words: []u32,
) MillError!u32 {
    if (prog.len > out_words.len) return error.CodeBufferOverflow;
    var w: u32 = 0;
    for (prog) |ins| {
        const rd: u32 = ins.rd;
        const rn: u32 = ins.rs1;
        const rm: u32 = ins.rs2;
        const imm: u32 = ins.imm12;
        out_words[w] = switch (ins.op) {
            // MOVZ Xd, #imm16 (0xD2800000 | (imm << 5) | rd)
            .mov_imm => 0xD280_0000 | (imm << 5) | rd,
            // ADD Xd, Xn, Xm (0x8B000000 | (rm << 16) | (rn << 5) | rd)
            .add_rr => 0x8B00_0000 | (rm << 16) | (rn << 5) | rd,
            // MADD Xd, Xn, Xm, XZR (MUL: 0x9B007C00)
            .mul_rr => 0x9B00_7C00 | (rm << 16) | (rn << 5) | rd,
            // RET (X30): 0xD65F03C0
            .ret_a0 => 0xD65F_03C0,
        };
        w += 1;
    }
    assert(w == prog.len);
    return w;
}

/// Emits readable TAME Rye source for the same `MiniInst` sequence.
pub fn emit_tame_rye(prog: []const MiniInst, out: []u8) MillError![]const u8 {
    var pos: usize = 0;
    for (prog) |ins| {
        const line = switch (ins.op) {
            .mov_imm => std.fmt.bufPrint(
                out[pos..],
                "r[{d}] = {d};{c}",
                .{ ins.rd, ins.imm12, nl },
            ),
            .add_rr => std.fmt.bufPrint(
                out[pos..],
                "r[{d}] = r[{d}] + r[{d}];{c}",
                .{ ins.rd, ins.rs1, ins.rs2, nl },
            ),
            .mul_rr => std.fmt.bufPrint(
                out[pos..],
                "r[{d}] = r[{d}] * r[{d}];{c}",
                .{ ins.rd, ins.rs1, ins.rs2, nl },
            ),
            .ret_a0 => std.fmt.bufPrint(out[pos..], "return r[10];{c}", .{nl}),
        } catch return error.CodeBufferOverflow;
        pos += line.len;
    }
    assert(pos <= out.len);
    return out[0..pos];
}

fn sha3_words(words: []const u32) [32]u8 {
    var h = Sha3_256.init(.{});
    for (words) |w| {
        var b: [4]u8 = undefined;
        std.mem.writeInt(u32, &b, w, .little);
        h.update(&b);
    }
    var out: [32]u8 = undefined;
    h.final(&out);
    return out;
}

fn run_selftest() !u8 {
    // Lower `welcome-badge`: `56500 -> (500 + 75) * 2` sample kernel
    const kernel = [_]MiniInst{
        .{ .op = .mov_imm, .rd = 1, .rs1 = 0, .rs2 = 0, .imm12 = 500 },
        .{ .op = .mov_imm, .rd = 2, .rs1 = 0, .rs2 = 0, .imm12 = 75 },
        .{ .op = .add_rr, .rd = 3, .rs1 = 1, .rs2 = 2, .imm12 = 0 },
        .{ .op = .mov_imm, .rd = 4, .rs1 = 0, .rs2 = 0, .imm12 = 2 },
        .{ .op = .mul_rr, .rd = 10, .rs1 = 3, .rs2 = 4, .imm12 = 0 },
        .{ .op = .ret_a0, .rd = 0, .rs1 = 0, .rs2 = 0, .imm12 = 0 },
    };

    var rv_s1: [16]u32 = undefined;
    var rv_s2: [16]u32 = undefined;
    const n_rv1 = try emit_riscv_words(&kernel, &rv_s1);
    const n_rv2 = try emit_riscv_words(&kernel, &rv_s2);
    if (n_rv1 != 6 or rv_s1[5] != 0x0000_8067) return error.BadRiscvEmit;

    var aa_s1: [16]u32 = undefined;
    var aa_s2: [16]u32 = undefined;
    const n_aa1 = try emit_aarch64_words(&kernel, &aa_s1);
    const n_aa2 = try emit_aarch64_words(&kernel, &aa_s2);
    if (n_aa1 != 6 or aa_s1[5] != 0xD65F_03C0) return error.BadAarch64Emit;

    // Fixed-Point Determinism Proof: Stage 1 == Stage 2 SHA3 digests match!
    const h_rv1 = sha3_words(rv_s1[0..n_rv1]);
    const h_rv2 = sha3_words(rv_s2[0..n_rv2]);
    if (!std.mem.eql(u8, &h_rv1, &h_rv2)) return error.RiscvStageMismatch;

    const h_aa1 = sha3_words(aa_s1[0..n_aa1]);
    const h_aa2 = sha3_words(aa_s2[0..n_aa2]);
    if (!std.mem.eql(u8, &h_aa1, &h_aa2)) return error.Aarch64StageMismatch;

    var rye_buf: [256]u8 = undefined;
    const rye_src = try emit_tame_rye(&kernel, &rye_buf);
    if (std.mem.indexOf(u8, rye_src, "return r[10];") == null) {
        return error.BadRyeEmit;
    }

    print("GREEN: mill_emit -- RV64GC, AArch64, & fixed-point proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
