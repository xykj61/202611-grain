//! libraries/shastra/tiruppavai/tiruppavai_dawn.rye -- Year 1 Shastra + Bloom!
//!
//! Orbit 64-65 (`20261115.085500`): First living application of our 4-year
//! *Bloom & Shastra* curriculum (`MULTI_YEAR_BLOOM_SHASTRA_CURRICULUM.md`).
//! Pairs **Andal's *Tiruppavai*** (*The Thirty Dawn Songs*, 8th-century Tamil
//! *bhakti-prema* poetry) with plain-English beginner reflections and a pure
//! integer-math **48 kHz `Resonance` Dawn Bell** synthesizer!
//!
//! Run:
//!   grainos tiruppavai 1        -- prints Song 1 + synthesizes dawn bell chord
//!   tiruppavai_dawn selftest    -- proves verses 1..5 & 48 kHz bell bounds

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const version = "20261115.085500";
pub const sample_rate_hz: u32 = 48000;
pub const bell_samples: u32 = 2400; // 50 ms pure dawn chime frame
const nl: u8 = 10;

pub const DawnError = error{SongOutOfRange};

pub const Pasuram = struct {
    number: u32,
    tamil_opening: []const u8,
    plain_english: []const u8,
    bloom_craft_mirror: []const u8,
    bell_freq_hz: u32,
};

pub const opening_five = [_]Pasuram{
    .{
        .number = 1,
        .tamil_opening = "Margazhi thingal madhi niraindha nannalal",
        .plain_english =
            "In the crisp dawn month under a full moon, come friends -- " ++
            "joy welcomes everyone who wakes together.",
        .bloom_craft_mirror =
            "Bloom 00: Opening Terminal.app -- nobody walks alone.",
        .bell_freq_hz = 432,
    },
    .{
        .number = 2,
        .tamil_opening = "Vaiyathu vazhvirgal namum nam pavaiykku",
        .plain_english =
            "Friends across this wide Earth: live simply, share with " ++
            "guests, speak kindly, and sing at dawn.",
        .bloom_craft_mirror =
            "Bloom 01 & Aparigraha: Honest u32 boxes and light custody.",
        .bell_freq_hz = 486,
    },
    .{
        .number = 3,
        .tamil_opening = "Ongi ulagalanda uttaman per padi",
        .plain_english =
            "When we sing of three gentle strides across the worlds, " ++
            "rain falls in season and every field thrives.",
        .bloom_craft_mirror =
            "Bloom 04 & Biocyclic Ecology: Harvest within natural bounds.",
        .bell_freq_hz = 540,
    },
    .{
        .number = 4,
        .tamil_opening = "Azhi mazhai kanna onru nee kai karavel",
        .plain_english =
            "O generous raincloud, draw from the deep ocean without " ++
            "holding back and water every thirsty garden!",
        .bloom_craft_mirror =
            "Bloom 07 & Evergrow: Offer more, require less.",
        .bell_freq_hz = 576,
    },
    .{
        .number = 5,
        .tamil_opening = "Mayanai mannu vada madurai maindanai",
        .plain_english =
            "Approaching with a clean heart and fresh flowers of thanks, " ++
            "old tangles clear like mist in morning sunlight.",
        .bloom_craft_mirror =
            "Bloom 12 & Reroot: Carry forward only living fruit.",
        .bell_freq_hz = 648,
    },
};

pub fn lookup_pasuram(song_no: u32) DawnError!Pasuram {
    if (song_no < 1 or song_no > opening_five.len) {
        return error.SongOutOfRange;
    }
    // invariant: 1-based song number maps cleanly into 0..opening_five.len-1.
    const idx = song_no - 1;
    assert(idx < opening_five.len);
    const p = opening_five[idx];
    assert(p.number == song_no);
    return p;
}

/// Synthesizes a pure, zero-floating-point 48 kHz triangle/chime waveform
/// with linear envelope decay into `pcm_out` (`i16`, bounded `<= 16000` peak)!
pub fn synth_dawn_bell(freq_hz: u32, pcm_out: *[bell_samples]i16) void {
    // invariant: audible bell frequency lies between 100 Hz and 4000 Hz.
    assert(freq_hz >= 100 and freq_hz <= 4000);
    const period: u32 = sample_rate_hz / freq_hz;
    assert(period >= 12);

    var i: u32 = 0;
    while (i < bell_samples) : (i += 1) {
        const phase = i % period;
        const half = period / 2;
        const raw_tri: u32 = if (phase < half)
            (phase * 32000) / half
        else
            ((period - phase) * 32000) / half;
        const tri_u: i32 = @intCast(@min(raw_tri, 32000));
        const centered: i32 = tri_u - 16000;
        const env_num: i32 = @intCast(bell_samples - i);
        const env_den: i32 = @intCast(bell_samples);
        pcm_out[i] = @intCast(@divTrunc(centered * env_num, env_den));
    }
    // invariant: final sample decays cleanly to zero at envelope end.
    assert(i == bell_samples);
}

fn run_selftest() !u8 {
    const p1 = try lookup_pasuram(1);
    if (p1.bell_freq_hz != 432) return error.WrongBellFreq;
    if (lookup_pasuram(0)) |_| {
        return error.ZeroSongAccepted;
    } else |err| {
        if (err != error.SongOutOfRange) return err;
    }

    var pcm: [bell_samples]i16 = undefined;
    synth_dawn_bell(p1.bell_freq_hz, &pcm);
    var non_zero: u32 = 0;
    for (pcm) |s| {
        if (s > 16000 or s < -16000) return error.AudioPeakExceeded;
        if (s != 0) non_zero += 1;
    }
    if (non_zero < 1000) return error.SilentBell;

    print("GREEN: tiruppavai_dawn -- songs 1..5 & 48kHz bell proven.{c}", .{
        nl,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const a = init.arena.allocator();
    const args = try init.minimal.args.toSlice(a);

    if (args.len <= 1 or std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }
    const n = std.fmt.parseInt(u32, args[1], 10) catch 1;
    const p = try lookup_pasuram(n);
    var pcm: [bell_samples]i16 = undefined;
    synth_dawn_bell(p.bell_freq_hz, &pcm);
    print("Tiruppavai Dawn Song #{d} ({d} Hz 48kHz bell ready){c}", .{
        p.number, p.bell_freq_hz, nl,
    });
    print("  Opening: {s}{c}", .{ p.tamil_opening, nl });
    print("  Meaning: {s}{c}", .{ p.plain_english, nl });
    print("  Craft  : {s}{c}", .{ p.bloom_craft_mirror, nl });
    return 0;
}
