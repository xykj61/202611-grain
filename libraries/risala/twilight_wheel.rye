pub fn lookup_movement(mov_1based: u32) !TwilightCard {
    if (mov_1based < 1 or mov_1based > 15) return error.MovementOutOfRange;
    const c = cards[mov_1based - 1];
    assert(c.movement == mov_1based);
    return c;
}

fn run_selftest() !u8 {
    var m: u32 = 1;
    while (m <= 15) : (m += 1) _ = try lookup_movement(m);
    if (lookup_movement(0)) |_| {
        return error.ZeroAccepted;
    } else |err| {
        if (err != error.MovementOutOfRange) return err;
    }
    const siya = try lookup_movement(15);
    if (std.mem.indexOf(u8, siya.shastra_term, "Prema-Bhakti") == null or
        std.mem.indexOf(u8, siya.risala_term, "al-Wadud") == null)
    {
        return error.SiyaBridgeMissing;
    }
    print(
        "GREEN: twilight_wheel -- 15 Prema-Bhakti & Risala dusk signs.{c}",
        .{nl},
    );
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const a = init.arena.allocator();
    const args = try init.minimal.args.toSlice(a);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }
    const m: u32 = if (args.len >= 2)
        std.fmt.parseInt(u32, args[1], 10) catch 12
    else
        12;
    const c = try lookup_movement(m);
    print("Twilight Movement {d}/15 -- {s}:{c}", .{ c.movement, c.sign, nl });
    print("  Shastra : {s}{c}", .{ c.shastra_term, nl });
    print("  Risala  : {s}{c}", .{ c.risala_term, nl });
    print("  Counsel : {s}{c}", .{ c.dusk_counsel, nl });
    return 0;
}
