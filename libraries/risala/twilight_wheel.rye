//! libraries/risala/twilight_wheel.rye -- Multicultural 15-Sign Twilight!
//!
//! Stamp: `20261115.162500` -- `Movement 12/15 : Pisces` (*Sandhya / Shafaq*),
//! powering `grain-ww twilight-wheel [1..15]`!
//! Pairs each of the 15 Calfive Signs with its *Shastra* (*Prema-Bhakti*) and
//! *Risala* (*Buruj / Mahabbah / Hikmah*) dusk contemplation!

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const version = "20261115.162500";
pub const sign_count: usize = 15;
const nl: u8 = 10;

pub const TwilightCard = struct {
    movement: u8,
    sign: []const u8,
    shastra_term: []const u8,
    risala_term: []const u8,
    dusk_counsel: []const u8,
};

