# pulp_lap7.rish -- Pulp lap 6: plain-snippet extract witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/s/pulp_lap7.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "pulp/bin/pulp"

let build = run ["sh" "-c" "mkdir -p pulp/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh pulp/pulp.rye -femit-bin=${bin}"]
assert build.ok else "Pulp lap 6 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Pulp selftest exited non-zero"
assert selftest.out contains "GREEN" else "Pulp selftest not GREEN"
assert selftest.out contains "plain snippets" else "Pulp missing plain snippets"

say "GREEN: Pulp lap 6 — plain fence snippets from fence_kinds fixture."
