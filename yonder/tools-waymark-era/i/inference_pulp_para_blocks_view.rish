# inference_pulp_para_blocks_view.rish -- Pulp paragraphs+blocks combo -> Skate.
let bin = "pond/bin/drawn-terminal"
say "build: Pulp para blocks view — drawn-terminal compile"
let build = run ["sh" "tools/fixtures/p/pond_build_drawn_terminal.sh"]
assert build.ok else "drawn_terminal build failed for pulp para blocks view"
assert build.out contains "GREEN:" else "drawn_terminal build did not reach GREEN"
let view = run ["sh" "-c" "${bin} pulpparablocksviewtest 2>&1"]
assert view.ok else "drawn terminal pulpparablocksviewtest exited non-zero"
assert view.out contains "pulp para blocks view" else "para blocks view missing expected output"
assert view.out contains "GREEN" else "Pulp para blocks view not GREEN"
assert view.out contains "lines=5" else "para blocks view missing five-line frame"
assert view.out contains "paragraphs=3" else "para blocks view missing paragraphs=3"
assert view.out contains "blocks=6" else "para blocks view missing blocks=6"
say "GREEN: Pulp para blocks view — paragraphs and blocks on one Skate frame."
