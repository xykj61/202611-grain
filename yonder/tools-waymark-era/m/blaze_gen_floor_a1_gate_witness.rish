# tools/m/blaze_gen_floor_a1_gate_witness.rish -- Ashvini a1: Blaze's deciding face (e214).
#
#   rishi/bin/rishi run tools/m/blaze_gen_floor_a1_gate_witness.rish

say "a1-blaze: Language EN -- the gen floor of one, decided in Glow (glow-language)."
say "a1-blaze: Lens TAME -- both sides; the four family walls stand together."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/gate/gate-blaze-gen-floor-u32.glow"

let alive = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "1"]
assert alive.ok else "a1-blaze: alive side failed -- ${alive.out_brief} ${alive.err_brief}"
assert alive.out contains "EXIT:0" else "a1-blaze: alive did not exit 0"
assert (lines alive.out) contains "1" else "a1-blaze: alive did not speak 1"

let reserved = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "0"]
assert reserved.ok else "a1-blaze: reserved side failed -- ${reserved.out_brief} ${reserved.err_brief}"
assert reserved.out contains "EXIT:0" else "a1-blaze: reserved did not exit 0"
assert (lines reserved.out) contains "0" else "a1-blaze: reserved did not speak 0"

let elder = run ["sh" "-c" "grep -q 'gen >= 1' blaze/src/weave.rye"]
assert elder.ok else "a1-blaze: the invariant left weave.rye -- ${elder.out_brief} ${elder.err_brief}"

let walls = run ["sh" "-c" "test -f src/gate/gate-tally-garden-bound-u32.glow -a -f src/gate/gate-caravan-dependents-bound-u32.glow -a -f src/gate/gate-aurora-wire-bound-u32.glow"]
assert walls.ok else "a1-blaze: a family wall is missing -- ${walls.out_brief} ${walls.err_brief}"

say "GREEN: a1 blaze gen floor -- decides on both sides; four families now speak."
