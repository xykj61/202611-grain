# tools/al/ales_meter_witness.rish -- the peak/RMS meter: the same root, now reading the master (resonance-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Resonance - the creative suite) - waymark resonance-audio - rung resonance-audio.
# Design read: active-designing/date/20260814/20260814-fill-ales13-resonance-meter.md
# Stands on: resonance/power.rye (resonance-audio) -- the proven isqrt, now public and widened to the audio square domain (2³⁰), reused
# whole; resonance/transport.rye (resonance-audio) -- the read blocks the meter is fed; resonance/timeline.rye (resonance-audio) and resonance/pan.rye (resonance-audio)
# -- the mono Clip and stereo StereoClip masters the meter reads.
#
# resonance/meter.rye turns resonance-audio's square root around: where the equal-power law SHAPED the field, the meter READS the master.
# An RMS level is isqrt of a mean square, so the meter needs no new arithmetic -- one true root, two readers. The selftest
# proves: silence reads 0/0; a full-scale constant reads its own magnitude as both peak and RMS (the i16 minimum landing
# 32768/32768 at the wide domain's ceiling); rms ≤ peak across a sweep (a lone spike strictly below, a square wave equal);
# BLOCK-INVARIANCE -- metering a master in 1-, 2-, and 7-sample blocks off the transport equals one whole measure; a stereo
# master meters each channel independently; metering never mutates the master; feed refuses MeterFull. Purely local -- no
# network, no keys, no funds, no real device, no real meter.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_meter_witness.rish

say "ales-meter: Language EN — resonance-audio reads a rendered master, reporting peak (the loudest sample) and RMS (the root of the mean square): the meter lights a mixing desk has never had until now."
say "ales-meter: Style Radiant — the law is stated positively: rms ≤ peak always, and metering a master block by block off the transport equals metering it whole (peak a running max, mean-square a running sum, both associative)."
say "ales-meter: Lens TAME — no new arithmetic: the meter reuses resonance-audio's proven isqrt, widened to the audio square domain (2³⁰) and shared as one root; count and squares are bounded; refuses MeterFull by name; read-only, never mutating the master; siloed to resonance/, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err_brief}"
let bin = "${pen.out}/meter"

let build = run ["sh" "-c" "mkdir -p resonance/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/meter.rye -femit-bin=${bin}"]
assert build.ok else "ales-meter: build failed — ${build.err_brief}"

let outfile = "resonance/bin/meter.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-meter: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-meter: ${shown.out_brief}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-meter' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-meter: selftest did not print the GREEN ales-meter line"

say "ales-meter: GREEN — the meter reads the master with the same root resonance-audio proved, rms ≤ peak, and a block-fed pass off the transport equals a whole measure. The next Resonance rung can name a stereo balance/width control, a transport loop over a marked region, or offer the keeper the choice of pan/crossfade law."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err_brief}"
