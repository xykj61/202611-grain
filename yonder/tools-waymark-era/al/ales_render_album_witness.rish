# tools/al/ales_render_album_witness.rish -- a whole record as one saveable artifact: a `RESONANCEALB` frame packs an ordered, named
# catalog of resonance-audio bundles and unpacks it verify-before-trust, needing no new seal (resonance-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Resonance - the creative suite) - waymark resonance-audio - rung resonance-audio.
# Design read: active-designing/date/20260815/20260815-135313_fill-ales223-resonance-render-album.md
# Idiom kin: resonance/render_bundle.rye (resonance-audio, pack/unpack -- the verify-before-trust the album inherits per track) - through it
# resonance/render_manifest.rye (resonance-audio, the seal each bundle carries). No new hash, no new grammar -- only a catalog frame over frames.
#
# resonance/render_album.rye packs many named bundles into one framed catalog and unpacks it verify-before-trust. The selftest proves:
# pack then unpack recovers every track name, manifest field, and exact .wav in order (the round-trip law); a single flipped byte in
# any track's .wav refuses WavDigestMismatch and in any manifest DigestMismatch, so the album needs no new seal -- each track binds
# its own whole (the self-binding law); a wrong magic and a bad tile refuse BadAlbum, a count past the bound AlbumFull (the frame
# law); a too-small buffer refuses Overflow (the atomic law); a zero-track album round-trips to an empty catalog (the empty law). A
# byte frame only -- no real file, no DAC, no network, no keys, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_render_album_witness.rish

say "ales-render-album: Language EN — resonance-audio gathers many resonance-audio bundles into ONE saveable artifact: a `RESONANCEALB` catalog frame packed and unpacked verify-before-trust, the durable unit a whole record — an album, a podcast season, a reel — actually saves."
say "ales-render-album: Style Radiant — the crux is the same quiet one, one level up: the album needs no new seal, since each bundle already binds its own whole; the round-trip law, the self-binding law, the frame law, the atomic law, and the empty law each named and proven on metal."
say "ales-render-album: Lens TAME — it proves a collection arrived whole, not who made it; every bound named, every fault refused by name, siloed to resonance/, no real file, no DAC, no network, no keys, no funds, no real device."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err_brief}"
let bin = "${pen.out}/render_album"

let build = run ["sh" "-c" "mkdir -p resonance/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/render_album.rye -femit-bin=${bin}"]
assert build.ok else "ales-render-album: build failed — ${build.err_brief}"

let outfile = "resonance/bin/render_album.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-render-album: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-render-album: ${shown.out_brief}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-render-album' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-render-album: selftest did not print the GREEN ales-render-album line"

say "ales-render-album: GREEN — many renders now save and open as one verify-before-trust catalog, the render→manifest→bundle→album loop whole. The next Resonance crux can carry the album to a keeper's session save/load, or name who made it — a signed carry, on Keaton's word."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err_brief}"
