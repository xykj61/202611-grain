# tools/al/ales_stereo_reverb_predelay_witness.rish -- the stereo pre-delay: the reverb's WHEN knob, the silent gap before the reverberant tail, across a stereo master (resonance-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Resonance - the creative suite) - waymark resonance-audio - rung resonance-audio.
# Design read: active-designing/date/20260815/20260815-102559_fill-ales195-resonance-stereo-reverb-predelay.md
# Stands on: resonance/stereo_reverb_preset.rye (resonance-audio -- the named-room stereo wet, run over the master unchanged); resonance/reverb_predelay.rye (resonance-audio
# -- the mono pre-delay this mirrors per ear); resonance/clock.rye (resonance-audio -- the sample clock, converting both the span and the pre-delay);
# resonance/timeline.rye (resonance-audio -- the Clip each channel holds, its max_clip bounding each wet snapshot); resonance/pan.rye (resonance-audio -- the StereoClip).
#
# resonance/stereo_reverb_predelay.rye gives the STEREO reverb its WHEN knob -- the short silent gap before the reverberant tail begins -- the thin twin
# resonance-audio named next. It reverberates the master wet in place through resonance-audio's stereo_reverb_preset UNCHANGED, snapshots each channel's wet, then
# rewrites each channel shifted right by predelay samples: out[i] = 0 for i < predelay, else wet[i - predelay] -- run per ear with no cross-channel
# read, inventing no new audio arithmetic, only a bounded per-channel reindex of the proven stereo wet with a true-zero gap. The selftest proves:
# at predelay = 0 the span equals stereo_reverb_preset byte for byte on both channels; at predelay = count both channels are all zeros; a mid
# pre-delay puts zeros in front and each channel's own wet shifted by exactly predelay after, byte for byte; the image is held (a centred master
# stays identical channel-to-channel, a stereo master keeps its channels distinct); the channels leave balanced and silence stays silence; and the
# faults forward (a pre-delay past the span BadPredelay, a span past the clip DurationTooLong, an out-of-range span BadRange), both channels
# untouched. Purely local -- one StereoClip, two bounded stack snapshots; no network, no keys, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_stereo_reverb_predelay_witness.rish

say "ales-stereo-reverb-predelay: Language EN — resonance-audio gave the MONO reverb its pre-delay: reverberate the span wet in place, snapshot the wet, then shift it right so the room sits a hair behind the dry rather than smearing over its onset. Yet a keeper mixing a stereo master had no such knob — the pre-delay comfort stopped at mono. This rung is the thin twin resonance-audio named next: the same shift, over both channels of a StereoClip, one shared gap, the image held."
say "ales-stereo-reverb-predelay: Style Radiant — the two edges are stated positively and proven exact on both ears: at predelay = 0 the span equals stereo_reverb_preset byte for byte (no gap is exactly the un-delayed stereo reverb), and at predelay = count the whole wet is shifted off the end and both channels are all zeros; between, each channel's wet stands exactly predelay samples later, so the stereo image the preset held is held through the delay. The pre-delay is a named duration in milliseconds, so it means the same gap at any rate."
say "ales-stereo-reverb-predelay: Lens TAME — one StereoClip of i16 PCM, a validated clock, resonance-audio's fixed banks, and two bounded stack snapshots (max_clip = 4096 samples each); NO new audio arithmetic — the pre-delay is a bounded per-channel reindex of the proven stereo wet, so no value is recomputed or can wrap and the gap is filled with true zeros; StereoReverbPredelayError = stereo_reverb_preset.StereoReverbPresetError || BadPredelay, DurationTooLong / BadRange / BadPredelay by name before any write, the wet snapshots within the span so a refusal leaves both channels untouched and balanced; siloed to resonance/, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err_brief}"
let bin = "${pen.out}/stereo_reverb_predelay"

let build = run ["sh" "-c" "mkdir -p resonance/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/stereo_reverb_predelay.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-reverb-predelay: build failed — ${build.err_brief}"

let outfile = "resonance/bin/stereo_reverb_predelay.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-reverb-predelay: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-reverb-predelay: ${shown.out_brief}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-reverb-predelay' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-reverb-predelay: selftest did not print the GREEN ales-stereo-reverb-predelay line"

# This rung runs resonance-audio's stereo_reverb_preset over its public API for the wet -- re-prove the named-room stereo preset still stands green beside it.
let preset = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/stereo_reverb_preset.rye -femit-bin=resonance/bin/stereo_reverb_preset && resonance/bin/stereo_reverb_preset selftest 2>&1 | grep -q 'GREEN ales-stereo-reverb-preset' && echo yes"]
assert (trim preset.out) == "yes" else "ales-stereo-reverb-predelay: the resonance-audio stereo named-room preset regressed under its pre-delay"

# And re-prove the resonance-audio mono pre-delay this twin mirrors still stands green.
let mono = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh resonance/reverb_predelay.rye -femit-bin=resonance/bin/reverb_predelay && resonance/bin/reverb_predelay selftest 2>&1 | grep -q 'GREEN ales-reverb-predelay' && echo yes"]
assert (trim mono.out) == "yes" else "ales-stereo-reverb-predelay: the resonance-audio mono pre-delay regressed under its stereo twin"

say "ales-stereo-reverb-predelay: GREEN — the stereo pre-delay: the reverb's WHEN knob (the silent gap before the reverberant tail begins), now across a stereo master. Reverberate the master wet in place through resonance-audio's stereo_reverb_preset unchanged, snapshot each channel's wet, then rewrite each channel shifted right by predelay samples out[i] = 0 for i < predelay, else wet[i - predelay] — run per ear with no cross-channel read, no new audio arithmetic, a bounded per-channel reindex of the proven stereo wet with a true-zero gap. Proven: at predelay = 0 exactly stereo_reverb_preset byte for byte on both channels; at predelay = count both channels all zeros; a mid pre-delay zeros in front and each channel's own wet shifted by exactly predelay after, byte for byte; the image is held; the channels leave balanced and silence stays silence; a pre-delay past the span refuses BadPredelay, a span past the clip DurationTooLong, an out-of-range span BadRange, each leaving both channels untouched; the resonance-audio stereo preset and resonance-audio mono pre-delay stay GREEN beside it. With the pre-delay axis complete for mono and stereo, a damping knob (a high-frequency roll-off inside the tail) or the dry-composed console pre-delay is the next genuinely new expressive control."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err_brief}"
