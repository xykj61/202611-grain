# tasks.rish -- pure Rishi root task runner (replaces legacy GNU Makefile).
#
# Stamp: 20261115.062500
# Style: TAME Core bounds with Radiant comments (`<= 80` cols).
#
# Usage:
#   languages/rishi/bin/rishi run tasks.rish help
#   languages/rishi/bin/rishi run tasks.rish prove
#   languages/rishi/bin/rishi run tasks.rish seed-dry
#   languages/rishi/bin/rishi run tasks.rish sundial

let cmd = "help"
if length args >= 1 then let cmd = args[0]

let rishi = "languages/rishi/bin/rishi"
let rye = "languages/rye/bin/rye"
let ok_c = ["true"]

if cmd == "help" then say "Grain tasks.rish -- pure Rishi task doorway:"
if cmd == "help" then say "  prove      run Brix, Glow, Fusion, & Gate proofs"
if cmd == "help" then say "  seed-dry   verify incremental Fusion public seed"
if cmd == "help" then say "  sundial    compile & emit Myofascia health rollup"

let c_w1 = [rishi "run" "tools/b/bricks_exist_witness.rish"]
if cmd == "prove" then let w1 = run c_w1 else let w1 = run ok_c
assert w1.ok else "tasks: bricks_exist_witness failed"
if cmd == "prove" then say w1.out

let c_w2 = [rishi "run" "tools/g/glow_rune_book_witness.rish"]
if cmd == "prove" then let w2 = run c_w2 else let w2 = run ok_c
assert w2.ok else "tasks: glow_rune_book_witness failed"
if cmd == "prove" then say w2.out

let c_w3 = [rishi "run" "tools/f/fusion_seed_and_build_witness.rish"]
if cmd == "prove" then let w3 = run c_w3 else let w3 = run ok_c
assert w3.ok else "tasks: fusion_seed_and_build_witness failed"
if cmd == "prove" then say w3.out

let c_sd = [rishi "run" "publish-seed.rish"]
if cmd == "seed-dry" then let sd = run c_sd else let sd = run ok_c
assert sd.ok else "tasks: publish-seed dry-run failed"
if cmd == "seed-dry" then say sd.out

let mk_s = ["mkdir" "-p" "modules/sundial/bin"]
let s_src = "modules/sundial/sundial.rye"
let s_out = "-femit-bin=modules/sundial/bin/sundial"
let b_s = [rye "build" s_src s_out]
let e_s = ["modules/sundial/bin/sundial" "emit"]
if cmd == "sundial" then let m1 = run mk_s else let m1 = run ok_c
assert m1.ok else "tasks: mkdir sundial/bin failed"
if cmd == "sundial" then let m2 = run b_s else let m2 = run ok_c
assert m2.ok else "tasks: sundial build failed"
if cmd == "sundial" then let m3 = run e_s else let m3 = run ok_c
assert m3.ok else "tasks: sundial emit failed"
if cmd == "sundial" then say m3.out
