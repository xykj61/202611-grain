# publish-redirect.rish -- project a minimal, unsigned, parentless redirect
# README to legacy pointer repos declared in gitignored `PUBLISH_TARGETS.kyri`.
#
# Stamp: 20261115.081500
# Style: TAME Core bounds with Radiant comments (`<= 80` cols, pure Rishi).
# Zero hardcoded personal repo URLs live in this script; new operators copy
# `context/templates/PUBLISH_TARGETS.template.kyri` -> `PUBLISH_TARGETS.kyri`.

assert length args < 2 else "publish-redirect: pass at most one flag (--push)"
let pushing = "no"
if length args == 1 then let pushing = args[0]
if pushing == "--push" then let pushing = "yes"
if pushing != "yes" then if pushing != "no" then let pushing = "bad"
assert pushing != "bad" else "publish-redirect: want --push or no flags"

let has_brix = run ["test" "-f" ".brix"]
assert has_brix.ok else "publish-redirect: run from standing Grain root"

let cfg_file = "PUBLISH_TARGETS.kyri"
let has_local = run ["test" "-f" cfg_file]
let tpl_file = "context/templates/PUBLISH_TARGETS.template.kyri"
if has_local.code != 0 then let cfg_file = tpl_file
let msg_cfg = "publish-redirect: instantiate PUBLISH_TARGETS.kyri first"
if pushing == "yes" then assert has_local.ok else msg_cfg

let r_seed = run ["awk" "$1 ~ /^seed_remote_url$/ { print $2 }" cfg_file]
let seed_ssh = trim r_seed.out
let r_name = run ["awk" "$1 ~ /^seed_author_name$/ { print $2 }" cfg_file]
let seed_name = trim r_name.out
let r_mail = run ["awk" "$1 ~ /^seed_author_email$/ { print $2 }" cfg_file]
let seed_mail = trim r_mail.out

let pen = ".redirect-seed-pen"
let cleaned = run ["rm" "-rf" pen]
assert cleaned.ok else "publish-redirect: could not clear .redirect-seed-pen"
let mk_pen = run ["mkdir" "-p" pen]
assert mk_pen.ok else "publish-redirect: mkdir .redirect-seed-pen refused"

let readme = pen + "/README.md"
let w1 = "echo '# Grain -- Rerooted' > $2 && echo '' >> $2"
let w2 = " && echo Active-seed: $1 >> $2"
let write_sh = w1 + w2
let wrote = run ["sh" "-c" write_sh "_" seed_ssh readme]
assert wrote.ok else "publish-redirect: could not write redirect README.md"

let inited = run ["git" "init" "-q" "-b" "main" pen]
assert inited.ok else "publish-redirect: git init -b main refused"
let c1 = run ["git" "-C" pen "config" "commit.gpgsign" "false"]
let c2 = run ["git" "-C" pen "config" "user.name" seed_name]
let c3 = run ["git" "-C" pen "config" "user.email" seed_mail]
assert c1.ok else "publish-redirect: gpgsign=false failed"
assert c2.ok else "publish-redirect: user.name failed"
assert c3.ok else "publish-redirect: user.email failed"

let st = run ["git" "-C" pen "add" "README.md"]
let cm = run ["git" "-C" pen "commit" "-q" "-m" "redirect to active seed"]
assert st.ok else "publish-redirect: git add refused"
assert cm.ok else "publish-redirect: commit refused"

let hd = run ["git" "-C" pen "rev-parse" "HEAD"]
let head = trim hd.out
say "publish-redirect: ready -- head=${head} config=${cfg_file}"
if pushing != "yes" then say "publish-redirect: DRY RUN ok (pass --push)."

let p1 = "for u in $(awk '$1 ~ /^redirect_target$/ { print $2 }' $1); do "
let p2 = "GIT_SSH_COMMAND=ssh git -C $2 push -f $u HEAD:main || exit 1; done"
let push_sh = p1 + p2
let push_c = ["sh" "-c" push_sh "_" cfg_file pen]
let ok_c = ["true"]
if pushing == "yes" then let pr = run push_c else let pr = run ok_c
let wiped = run ["rm" "-rf" pen]
assert wiped.ok else "publish-redirect: cleanup refused"
assert pr.ok else "publish-redirect: push to redirect_target failed"
if pushing == "yes" then say "GREEN: publish-redirect -- synced all targets."
