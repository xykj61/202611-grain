status template
# context/templates/PUBLISH_TARGETS.template.kyri -- Remotes & Hearth Cadence!
#
# Copy to gitignored root `PUBLISH_TARGETS.kyri` (see
# `docs-geode/tutorials/the-first-hour.md` and
# `docs-geode/tutorials/the-second-hour-remotes-clock-and-cadence.md`).
# Both `bench_remote` (default `xy`) and `seed_remote` (default `ww`) adapt
# freely to your own git remote names!
#
# `seed_cadence` controls when `publish-seed.rish --push` sends to `seed_remote`:
#   - `hearth` : Fast bench focus! Pushes work to `bench_remote` (`xy`), proves
#                `SOW_WITNESS_GREEN` locally (~130 ms), and skips `seed_remote`
#                (`ww`) network push unless `--force-seed` is passed.
#   - `siya`   : Orbit harvest! Pushes `seed_remote` (`ww`) automatically on
#                Movement 15/15 (`mov % 15 == 0`) and stays local on 1..14.
#   - `stream` : Continuous release! Pushes `seed_remote` (`ww`) on every
#                `--push` (default when `seed_cadence` is omitted).

bench_remote xy
seed_remote ww
seed_cadence hearth

seed_remote_url git@github.com:YOUR-PUBLIC-ORG/202611-grain.git
seed_author_name your-public-handle
seed_author_email your-public-handle@users.noreply.github.com

# Optional legacy pointer-repo redirects used by `publish-redirect.rish`:
redirect_target git@github.com:YOUR-HANDLE/grain.git
redirect_target git@github.com:YOUR-PUBLIC-ORG/grain.git
